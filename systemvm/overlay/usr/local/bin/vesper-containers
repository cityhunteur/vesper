#!/bin/sh
# Container confinement for dockerd in the System VM (ADR 0010, GH #194). A normal boot runs every container in a
# remapped user namespace: container root is uid 100000 here, never root on the System VM, and the authorisation
# plugin vesper-authz refuses the requests that would start a container outside that mapping.
#
# One boot can ask for unmapped containers, with vesper.containers=unmapped on the kernel command line. Only the
# launcher on macOS writes that line. The upstream Firecracker suite needs it (real root and /dev/kvm in
# containers), and ADR 0009's host-root row does not hold in such a boot.
#
# A data disk records the mode of the first dockerd that used it, in $REC. A boot in the other mode is refused:
# dockerd does not start. So a disk that normal boots use never runs unmapped, where its old containers with a
# restart policy would start as root, and the suite's disk never serves a normal boot. A disk from before this
# change has an unmapped store and no record; it is a normal disk, so it is recorded as mapped and its old store
# is left alone (see `legacy`).
#
# usage: vesper-containers prepare   decide the mode, check the disk's record and write dockerd's configuration;
#                                    CONTAINERS mapped | CONTAINERS unmapped | CONTAINERS refused <reason> (rc 1)
#        vesper-containers status    CONTAINERS <mapped|unmapped|refused <reason>|unknown> authz=<state>
#                                    legacy=<absent|present volumes=N containers=M>
#        vesper-containers test-authz stop|start   suite hook: stop or start the plugin, to show that dockerd
#                                    refuses every request without it; AUTHZ <state>
#        vesper-containers test-legacy plant|check   suite hook: plant files with the modes a build before ADR 0010
#                                    left in the stores (plant), and after a reboot report and remove them (check);
#                                    PLANTED | LEGACY image=<mode> snapshot=<mode>:<uid>:<gid>
set -u
REC=/var/lib/vesper/state/containers-mode
RUN=/run/vesper/containers
CONF=/etc/docker/daemon.json
SOCK=/run/docker/plugins/vesper-authz.sock
STORE=/var/lib/docker
REMAP=dockremap
BASE=100000
COUNT=65536

asked() {
  if tr ' ' '\n' < /proc/cmdline | grep -qx 'vesper.containers=unmapped'; then echo unmapped; else echo mapped; fi
}
finish() { mkdir -p /run/vesper; echo "$*" > "$RUN"; echo "CONTAINERS $*"; }
# A refused boot must not serve Docker even if someone starts dockerd by hand: the configuration names a plugin
# that does not exist, so dockerd refuses every request.
refuse() {
  mkdir -p /etc/docker
  printf '{"userns-remap":"default","authorization-plugins":["vesper-refused"]}\n' > "$CONF"
  finish "refused $*"; exit 1
}

# Vesper's state, made private before dockerd can run a container (GH #194 council review).
#  - dockerd creates a missing bind source and gives it to container root, and the root tools adopt their state
#    directories with mkdir -p. So every such directory exists, owned by root, before the first container; the
#    authorisation plugin also refuses to create a source outside a shared macOS directory.
#  - dockerd binds a single file whatever its parent allows. Files that a build before this change left on the
#    data disk were world-readable, so their modes are set here on every boot.
JGID=20000 # the vesperd jail's group (vesper-vesperd)
private_state() {
  for d in /run/vesper/microvm /run/vesper/mem /run/vesper/ctr /run/vesper/vesperd /var/log/vesperd \
      /var/lib/vesper/microvm /srv/jailer /srv/jailer/firecracker /run/docker /run/docker/plugins \
      /var/lib/vesper/rootfs /var/lib/vesper/rootfs-cache /var/lib/vesper/workloads; do
    [ -L "$d" ] && return 1
    mkdir -p "$d" && chown 0:0 "$d" && chmod 0700 "$d" || return 1
  done
  mkdir -p /var/lib/vesper/state && chown 0:0 /var/lib/vesper/state && chmod 0711 /var/lib/vesper/state || return 1
  for d in /var/lib/vesper/rootfs /var/lib/vesper/rootfs-cache /var/lib/vesper/workloads; do
    find "$d" -xdev -type f ! -perm 0600 -exec chmod 0600 {} + || return 1
  done
  store=/var/lib/vesper/state/vesperd/store
  if [ -d "$store" ]; then
    chown 0:0 "$store" && chmod 0700 "$store" || return 1
    find "$store" -xdev -type f \( ! -perm 0440 -o ! -group "$JGID" -o ! -user 0 \) -exec chown "0:$JGID" {} + -exec chmod 0440 {} + || return 1
  fi
  for d in /var/lib/vesper/state/vesperd /var/lib/vesper/state/vesperd/jailer /var/lib/vesper/state/vesperd/jailer/firecracker; do
    [ -d "$d" ] || continue
    chown 0:0 "$d" && chmod 0711 "$d" || return 1
  done
  # The daemons' logs: made here, owner-only, so they are never world-readable while the services start.
  for f in /var/log/containerd.log /var/log/docker.log; do
    [ -L "$f" ] && return 1
    : >> "$f" && chown 0:0 "$f" && chmod 0600 "$f" || return 1
  done
}
legacy_store() {
  if [ -d "$STORE/image" ]; then
    v=$(find "$STORE/volumes" -mindepth 1 -maxdepth 1 -type d 2>/dev/null | wc -l)
    c=$(find "$STORE/containers" -mindepth 1 -maxdepth 1 -type d 2>/dev/null | wc -l)
    echo "present volumes=$((v)) containers=$((c))"
  else
    echo absent
  fi
}

prepare() {
  private_state || refuse private-state
  mode=$(asked)
  mkdir -p "$(dirname "$REC")" || refuse no-state-directory
  rec=$(cat "$REC" 2>/dev/null)
  case "$rec" in
    mapped|unmapped) ;;
    '')
      # No record. A disk that already holds a Docker store has served normal boots, so it is a mapped disk.
      if [ -d "$STORE/image" ] || [ -d "$STORE/$BASE.$BASE" ]; then rec=mapped; else rec=$mode; fi
      echo "$rec" > "$REC" || refuse cannot-record-mode ;;
    *) refuse bad-record ;;
  esac
  [ "$rec" = "$mode" ] || refuse "disk-is-$rec:boot-asked-$mode"
  mkdir -p /etc/docker
  if [ "$mode" = unmapped ]; then
    rm -f "$CONF"
    echo absent > "$RUN.legacy"
    finish unmapped
    return 0
  fi
  grep -q "^$REMAP:" /etc/group || addgroup -S "$REMAP" || refuse "addgroup-$REMAP"
  grep -q "^$REMAP:" /etc/passwd || adduser -S -D -H -G "$REMAP" -s /sbin/nologin -h / -g "container root" "$REMAP" \
    || refuse "adduser-$REMAP"
  for f in /etc/subuid /etc/subgid; do
    grep -q "^$REMAP:$BASE:$COUNT\$" "$f" 2>/dev/null && continue
    { grep -v "^$REMAP:" "$f" 2>/dev/null; echo "$REMAP:$BASE:$COUNT"; } > "$f.new" && mv -f "$f.new" "$f" \
      || refuse "write-$f"
  done
  # vesper-runc is runc plus one step after create: it asks each bind source on a macOS share for its owner again as
  # the container's uid, so a container does not see its binds owned by "nobody" in its first second (TD-062).
  printf '{"userns-remap":"default","authorization-plugins":["vesper-authz"],"runtimes":{"vesper-runc":{"path":"/usr/bin/vesper-runc"}},"default-runtime":"vesper-runc"}\n' > "$CONF.new" \
    && mv -f "$CONF.new" "$CONF" || refuse write-daemon-json
  legacy_store > "$RUN.legacy" # counted once a boot; HEALTH reads it on every poll
  finish mapped
}

status() {
  st=$(cat "$RUN" 2>/dev/null || echo unknown)
  authz=n/a
  case "$st" in
    mapped)
      authz=$(rc-service vesper-authz status 2>/dev/null | awk '{print $NF}')
      [ -S "$SOCK" ] || authz="${authz:-stopped}:no-socket" ;;
  esac
  legacy=$(cat "$RUN.legacy" 2>/dev/null || echo unknown)
  echo "CONTAINERS $st authz=${authz:-stopped} legacy=$legacy"
}

test_authz() {
  case "${1:-}" in stop|start) ;; *) echo "ERR usage: vesper-containers test-authz stop|start"; return 2 ;; esac
  [ "$(cat "$RUN" 2>/dev/null)" = mapped ] || { echo "ERR containers are not mapped in this boot"; return 1; }
  rc-service vesper-authz "$1" > /dev/null 2>&1
  echo "AUTHZ $(rc-service vesper-authz status 2>/dev/null | awk '{print $NF}')"
}

test_legacy() {
  img=/var/lib/vesper/rootfs/confine-legacy.ext4; snap=/var/lib/vesper/state/vesperd/store/confine-legacy.mem
  case "${1:-}" in
    plant)
      mkdir -p "$(dirname "$snap")" || return 1
      echo old-image > "$img" && chmod 0644 "$img" && echo old-memory > "$snap" && chown 0:0 "$snap" && chmod 0444 "$snap" || { echo "ERR plant"; return 1; }
      echo PLANTED ;;
    check)
      echo "LEGACY image=$(stat -c %a "$img" 2>/dev/null || echo missing) snapshot=$(stat -c %a:%u:%g "$snap" 2>/dev/null || echo missing)"
      rm -f "$img" "$snap" ;;
    *) echo "ERR usage: vesper-containers test-legacy plant|check"; return 2 ;;
  esac
}

case "${1:-}" in
  test-legacy) test_legacy "${2:-}" ;;
  test-authz) test_authz "${2:-}" ;;
  prepare) prepare ;;
  status) status ;;
  *) echo "ERR usage: vesper-containers prepare|status|test-authz stop|start|test-legacy plant|check"; exit 2 ;;
esac
