#!/bin/sh
# Vesper Backend A for vesperd (ADR 0007, slices 3 and 5): one jailed Firecracker per lease, built from API requests,
# with jails and a snapshot store on the data disk. The agent runs `launch` for LAUNCHAPI and `connect` for FCAPI
# with `exec`, so stdin and stdout are the vsock connection itself. Every other subcommand is reached through the
# agent's buffered VESPERD verb.
# usage: vesper-vesperd launch ID [CEILING] [stage=SRC:DEST|tap=NAME|tapaddr=NAME:ADDR/PREFIX|net=none|nat]...
#                                             LAUNCHAPI: start Firecracker unconfigured under the jailer (uid 20000,
#                                             --parent-cgroup vesperd, memory.max=CEILING bytes) in a fresh jail on the
#                                             data disk, after staging each SRC (share:/PATH or store:NAME) to the jail
#                                             path DEST (store:*.mem and store:*.vmstate are hard-linked, root-owned and
#                                             read-only; everything else is copied), in a fresh network namespace
#                                             (jailer --netns) that holds lo and one tap device per tap=NAME, owned by
#                                             uid 20000 and up, with no uplink (CE-0010); under net=nat also a veth
#                                             to the System VM, NATed to public IPv4 only, with DNS on each tapaddr=
#                                             gateway (ADR 0008); reply READY ID pid=N
#                                             firecracker_version=V once the API socket exists, or ERR <reason> and
#                                             close. After READY the connection is the lease: on its end of file, or when
#                                             Firecracker exits, the microVM is stopped and its jail, cgroup and record
#                                             removed, then the connection is closed.
#        vesper-vesperd connect ID            FCAPI: reply OK, then relay bytes to ID's API socket (socat, chrooted
#                                             into the jail root); ERR <reason> and close when ID is not a ready
#                                             vesperd microVM.
#        vesper-vesperd stage ID|- SRC DEST   copy SRC (share:/PATH, store:NAME or jail:/PATH in ID's jail) to DEST (a
#                                             path in ID's jail or store:NAME) while ID runs; jail-side reads and writes
#                                             run as vesperd-jail (uid 20000); never links, never overwrites; checks the
#                                             free-space reserve first. STAGED SRC DEST copy bytes=N | ERR <reason>
#        vesper-vesperd store-list            STORE NAME bytes=N links=L lines, then FREE avail=N reserve=N store=N quota=N
#        vesper-vesperd store-rm NAME         REMOVED NAME | ERR <reason>
#        vesper-vesperd sweep                 boot sweep (vesper-data mount): remove every jail without a record and
#                                             every unfinished store copy; SWEPT jails=N partial=M
#        vesper-vesperd setup-user            create the vesperd-jail user and group (uid and gid 20000, no login
#                                             shell) if missing (the reaper service, at boot); USER vesperd-jail 20000
#        vesper-vesperd reap                  one reaper pass: REAPED ID reason=… | KEPT ID reason=… lines, then
#                                             REAP reaped=N kept=M
#        vesper-vesperd reap-loop SECONDS     a reaper pass every SECONDS, forever (the vesper-vesperd-reaper service)
#        vesper-vesperd status ID             RUNNING ID pid=N holder=P | STARTING ID holder=P | ABSENT ID |
#                                             DIRTY ID <record|jail|cgroup|netns|veth|process>…
#        vesper-vesperd isolation ID          JSON with uid, chroot, cgroup, seccomp and netns checks of ID's Firecracker
#        vesper-vesperd files ID              FILE PATH uid=U mode=M links=L bytes=N per regular file in ID's jail
#                                             (read as uid 20000)
#        vesper-vesperd net ID                LINK NAME state=UP|DOWN owner=U per interface in ID's network
#                                             namespace, then NETNS ID separate=true|false ino=N
#        vesper-vesperd memory ID             MEMORY ID current=N peak=N max=N anon=N file=N (ID's cgroup)
#        vesper-vesperd list                  LEASE ID holder=P:S conn=P:S fc=P:S lines, then a JAIL ID line per jail
#                                             and a NETNS ID line per bound network namespace
#        vesper-vesperd log ID [N]            last N lines of ID's serial console
#        vesper-vesperd kill-holder ID        SIGKILL the lease shell (KILLED-HOLDER ID pid=N); tests the reaper
#        vesper-vesperd kill-fc ID            SIGKILL Firecracker (KILLED-FC ID pid=N); tests the lease
#        vesper-vesperd test-forge-start ID   test hook: rewrite the holder's recorded start time, as if its pid had
#                                             been reused by another process (FORGED ID holder=P)
#        vesper-vesperd test-orphan ID        test hook: create a jail with no record (ORPHAN ID)
#        vesper-vesperd test-age ID SECONDS   test hook: backdate ID's jail directory (AGED ID seconds=N)
#        vesper-vesperd test-age-log ID SECONDS  test hook: backdate ID's console logs (AGED-LOG ID seconds=N)
#        vesper-vesperd logsize ID            LOGSIZE ID current=N previous=N max=N: ID's console log files
#        vesper-vesperd mem-budget            MEMBUDGET total= reserve= budget= committed= entries= (TD-056)
#        vesper-vesperd test-mem-reserve BYTES|clear  test hook: override the memory budget's reserve
#        vesper-vesperd test-plant ID         test hook, as a compromised Firecracker would: /planted-link -> /etc/shadow,
#                                             /planted-dir -> the store, and /planted-root (root-owned, mode 0600) in
#                                             ID's jail (PLANTED ID)
#        vesper-vesperd test-reserve BYTES|clear  test hook: override the free-space reserve until reboot (RESERVE …)
#        vesper-vesperd test-store-quota BYTES|clear  test hook: override the store quota until reboot (QUOTA …)
#        vesper-vesperd test-listen PORT|stop  test hook: TCP and UDP listeners on every System VM address (egress suite)
#        vesper-vesperd test-open-ns ID [filter|all]  test hook: accept everything in ID's namespace FORWARD (all:
#                                             also no masquerade and no reverse-path check), leaving the root egress
#                                             layer alone (OPENED ID …)
#        vesper-vesperd test-reach IP PORT    test hook: REACH IP:PORT open|closed from the System VM itself
#        vesper-vesperd flows                FLOWS root=N max=M tcp_established_s=S udp_s=S (ERR when unreadable): tracked
#                                             flows and the timeouts that age them out (egress suite, TD-058)
#        vesper-vesperd test-container-vsock  run a default and an unconfined Docker container that open AF_VSOCK;
#                                             VSOCK default=denied|allowed … and VSOCK unconfined=… lines
#        vesper-vesperd jail-stat|jail-read|jail-write ROOT PATH [BYTES]
#                                             internal: the uid 20000 side of stage; refused for any other uid
# Values (docs/exec-plans/completed/2026-11-12-GH156-vesperd-backend-a.md gives the reason for each):
set -u
FC_DIR=/var/lib/vesper/firecracker
FC=$FC_DIR/firecracker
JAILER=$FC_DIR/jailer
MV=/usr/local/bin/vesper-microvm
MEMADMIT=/usr/local/bin/vesper-memadmit  # the memory budget shared with the shim's microVMs (TD-056)
BOUNDLOG=/usr/local/bin/vesper-boundlog  # console logs of at most twice LOG_MAX bytes (TD-055)
MVM=/var/lib/vesper/microvm
DATA=/var/lib/vesper/state       # bind-mounted onto the data disk by vesper-data; jails and store share this mount
BASE=$DATA/vesperd/jailer         # --chroot-base-dir
JAILS=$BASE/firecracker           # <chroot base>/<exec file name>/<id>/root
STORE=$DATA/vesperd/store         # files that outlive a microVM; root-owned, read-only, one trust domain
CG=/sys/fs/cgroup/vesperd         # --parent-cgroup vesperd
STATE=/run/vesper/vesperd
LEASES=$STATE/leases              # one record per id: "holder=<pid>:<start> conn=<pid>:<start> fc=<pid>:<start>"
LOCK=$STATE/lock                  # one flock serialises reaping, jail creation and teardown
STORE_LOCK=$STATE/store.lock      # one flock serialises copies (and their reserve checks) and store removals
RESERVE_OVERRIDE=$STATE/reserve   # test-reserve writes it; tmpfs, so a reboot clears it
STORE_PCT=25                      # the store may hold at most this share of the data disk (TD-053)
QUOTA_OVERRIDE=$STATE/store-quota # test-store-quota writes it; tmpfs, so a reboot clears it
LOGS=/var/log/vesperd
LOG_MAX=1048576                   # one console log file; the previous one is kept as <id>.log.1
LOG_KEEP_S=600                    # the reaper removes the logs of a microVM gone this long
JUID=20000
JGID=20000
JUSER=vesperd-jail                # the uid 20000 user that jail-side reads and writes run as
DEFAULT_CEILING=671088640         # memory.max default, 640 MiB (measured in slice 5)
MIN_CEILING=134217728             # 128 MiB: Firecracker plus the smallest guest
LAUNCH_WAIT_S=10                  # wait for the API socket after the jailer starts
STOP_GRACE_S=3                    # SIGTERM to SIGKILL
LEASE_POLL_S=1                    # lease end of file and Firecracker exit are noticed within this
GRACE_S=60                        # a jail without a record is spared this long
SOCAT_T=86400                     # socat -t: keep relaying after a half-close (GH #167)
MAX_STAGES=16                     # stage= tokens per LAUNCHAPI
MAX_TAPS=8                        # tap= tokens per LAUNCHAPI
NETNS=$STATE/netns                # one bound network namespace per lease (tmpfs, so a reboot clears it)
MAX_PATH=1024                     # bytes in a jail or share path
MAX_NAME=128                      # bytes in a store name
# The free-space reserve is the System VM's MemTotal: after any copy the data disk still holds one more full
# snapshot memory file of the largest guest a ceiling allows.

valid_id() { # the jailer's rule: 1 to 64 letters, digits and hyphens
  case "${1:-}" in ''|*[!A-Za-z0-9-]*) return 1 ;; esac
  [ "${#1}" -le 64 ]
}
valid_tap() { # a Linux interface name (IFNAMSIZ 16 with the NUL) of letters, digits, _ and -, not starting with -;
  # never lo, and not veth* or vpd*, which the nat uplink uses (ADR 0008). Names that are ip keywords (up, dev,
  # mtu…) are fine: every ip call names the device with dev.
  case "${1:-}" in ''|lo|-*|veth*|vpd*|*[!A-Za-z0-9_-]*) return 1 ;; esac
  [ "${#1}" -le 15 ]
}
digits() { case "${1:-}" in ''|*[!0-9]*) return 1 ;; esac; }
now_s() { date +%s; }
oneline() { tr '\n\r\t' '   ' | sed 's/[^ -~]/?/g' | cut -c1-200; } # busybox tr has no working [:print:] complement

proc_stat() { # PID -> "<state> <starttime>" from /proc/PID/stat (fields 3 and 22); fails when absent
  digits "${1:-}" || return 1
  s=$(cat "/proc/$1/stat" 2>/dev/null) || return 1
  [ -n "$s" ] || return 1
  s=${s##*) }
  # shellcheck disable=SC2086
  set -- $s
  echo "$1 ${20}"
}
start_of() { st=$(proc_stat "$1") || return 1; echo "${st#* }"; }
proc_alive() { # PID START -> 0 when PID runs and started at START (a reused pid or a zombie is not alive)
  st=$(proc_stat "${1:-}") || return 1
  [ "${st% *}" != Z ] && [ "${st#* }" = "${2:-}" ]
}
euid_of() { awk '/^Uid:/{print $3}' "/proc/$1/status" 2>/dev/null; }
is_fc_for() { # PID ID -> 0 when PID is a Firecracker running as uid 20000 with --id ID
  [ "$(euid_of "$1")" = "$JUID" ] || return 1
  tr '\0' ' ' < "/proc/$1/cmdline" 2>/dev/null | grep -q -- "firecracker --id $2 "
}
fc_by_id() { pgrep -u "$JUID" -f "firecracker --id $1 " 2>/dev/null | head -1; }

ensure_dirs() { # the tmpfs side; the data-disk side is data_dirs
  mkdir -p "$LEASES" "$LOGS" && chmod 0700 "$STATE" "$LEASES"
}
data_ok() { awk -v d="$DATA" '$2 == d && $3 == "ext4" {f=1} END {exit !f}' /proc/mounts; }
data_dirs() { # jails and store on the data disk; refused when the disk is not in use (ADR 0007 section 5)
  data_ok || return 1
  mkdir -p "$JAILS" "$STORE" && chmod 0755 "$DATA/vesperd" "$BASE" "$JAILS" && chmod 0700 "$STORE"
}
lock() { exec 9>"$LOCK" && flock 9; }
unlock() { flock -u 9 2>/dev/null; exec 9>&-; }

H_PID=""; H_START=""; C_PID=""; C_START=""; F_PID=""; F_START=""
read_record() { # ID -> H_PID H_START C_PID C_START F_PID F_START
  H_PID=""; H_START=""; C_PID=""; C_START=""; F_PID=""; F_START=""
  [ -f "$LEASES/$1" ] || return 1
  for kv in $(cat "$LEASES/$1"); do
    case "$kv" in
      holder=*:*) v=${kv#holder=}; H_PID=${v%%:*}; H_START=${v#*:} ;;
      conn=*:*) v=${kv#conn=}; C_PID=${v%%:*}; C_START=${v#*:} ;;
      fc=*:*) v=${kv#fc=}; F_PID=${v%%:*}; F_START=${v#*:} ;;
    esac
  done
}
write_record() { # ID HOLDER CONN FC
  printf 'holder=%s conn=%s fc=%s\n' "$2" "$3" "$4" > "$LEASES/.$1.tmp" && mv "$LEASES/.$1.tmp" "$LEASES/$1"
}
close_conn() { # the agent listener's handler for a lease whose shell is gone: without this socat keeps the vsock
  # connection open after a SIGKILLed child (seen with socat 1.8.1.3), and the client would never see the lease end.
  if proc_alive "$C_PID" "$C_START" && [ "$(cat "/proc/$C_PID/comm" 2>/dev/null)" = socat ]; then kill -TERM "$C_PID" 2>/dev/null; fi
}

leftovers() { # ID -> the names of what is still there, empty when clean
  out=""
  [ -e "$LEASES/$1" ] && out="$out record"
  [ -e "$JAILS/$1" ] && out="$out jail"
  [ -d "$CG/$1" ] && out="$out cgroup"
  [ -e "$NETNS/$1" ] && out="$out netns"
  [ -e "$NETDIR/$1" ] && out="$out veth"
  [ -n "$(fc_by_id "$1")" ] && out="$out process"
  echo "${out# }"
}

teardown() { # ID (caller holds the lock) -> CLEAN ID | DIRTY ID <what>
  tid=$1; fpid=""
  if read_record "$tid" && [ -n "$F_PID" ] && proc_alive "$F_PID" "$F_START"; then fpid=$F_PID; fi
  [ -n "$fpid" ] || fpid=$(fc_by_id "$tid")
  if [ -n "$fpid" ]; then
    kill -TERM "$fpid" 2>/dev/null
    i=0; while [ "$i" -lt $((STOP_GRACE_S * 10)) ] && [ -n "$(fc_by_id "$tid")" ]; do sleep 0.1; i=$((i + 1)); done
    [ -n "$(fc_by_id "$tid")" ] && kill -KILL "$fpid" 2>/dev/null
    i=0; while [ "$i" -lt 20 ] && [ -n "$(fc_by_id "$tid")" ]; do sleep 0.1; i=$((i + 1)); done
  fi
  # rm -rf does not follow symlinks; the jail's mounts live in the jailer's own mount namespace.
  rm -rf "${JAILS:?}/$tid"
  i=0; while [ -d "$CG/$tid" ] && [ "$i" -lt 20 ]; do rmdir "$CG/$tid" 2>/dev/null || sleep 0.1; i=$((i + 1)); done
  nat_down "$tid"
  netns_down "$tid"
  rm -f "$LEASES/$tid" "$LOGS/.$tid.pipe"
  # Start the log's keep time now, so the reaper prunes it KEEP after teardown, not after its last write.
  touch -c "$LOGS/$tid.log" 2>/dev/null
  left=$(leftovers "$tid")
  # The memory stays admitted while anything of the microVM is left (D-029: never overcommit). A DIRTY entry is
  # dropped by vesper-memadmit itself once the cgroup and jail are gone.
  if [ -z "$left" ]; then "$MEMADMIT" release vesperd "$tid" 2>/dev/null; echo "CLEAN $tid"; else echo "DIRTY $tid $left"; return 1; fi
}

# ---- networking (CE-0010, TD-058) -------------------------------------------------------------------------
# Each lease gets its own network namespace, bound at $NETNS/ID so the jailer can join it (--netns) and teardown can
# remove it. The jailed Firecracker has no CAP_NET_ADMIN, so it cannot create a tap; it can open one that exists and
# is owned by uid 20000 (the kernel's tun owner check). The namespace has no uplink: the guest reaches its tap and
# nothing else, and the System VM's own interfaces stay out of the jail's reach.
ns_ino() { stat -L -c %i "$1" 2>/dev/null; } # a namespace file -> its inode, empty when unreadable
netns_mounted() { awk -v f="$NETNS/$1" '$2 == f && $3 == "nsfs" {m=1} END {exit !m}' /proc/mounts; }
netns_down() { # ID: unbind and remove; the taps go with the namespace once Firecracker is gone
  f="$NETNS/$1"
  # -l: an inspection (net, isolation) may hold the file open; the namespace itself lives on until its last user goes.
  netns_mounted "$1" && umount -l "$f" 2>/dev/null
  netns_mounted "$1" || rm -f "$f"
}
netns_up() { # ID TAP... (the lease record exists, so the reaper leaves the namespace alone) -> a reason on failure
  nid=$1; shift; f="$NETNS/$nid"
  mkdir -p "$NETNS" && chmod 0700 "$NETNS" || { echo "netns directory"; return 1; }
  netns_down "$nid"
  [ -e "$f" ] && { echo "netns $nid still bound"; return 1; }
  : > "$f" && unshare --net="$f" true || { rm -f "$f"; echo "netns create failed"; return 1; }
  # Before any interface but lo exists, so every later one inherits "default": IPv6 off, strict reverse-path
  # filtering, no ICMP redirects (ADR 0008).
  # shellcheck disable=SC2016
  nsenter --net="$f" sh -c 'for k in all default lo; do
      echo 1 > /proc/sys/net/ipv6/conf/$k/disable_ipv6 && echo 1 > /proc/sys/net/ipv4/conf/$k/rp_filter \
        && echo 0 > /proc/sys/net/ipv4/conf/$k/accept_redirects && echo 0 > /proc/sys/net/ipv4/conf/$k/send_redirects || exit 1
    done' || { echo "namespace sysctls"; return 1; }
  out=$(nsenter --net="$f" ip link set dev lo up 2>&1) || { echo "lo: $(printf '%s' "$out" | oneline)"; return 1; }
  for t in "$@"; do
    out=$(nsenter --net="$f" tunctl -t "$t" -u "$JUSER" 2>&1) || { echo "tap $t: $(printf '%s' "$out" | oneline)"; return 1; }
    out=$(nsenter --net="$f" ip link set dev "$t" up 2>&1) || { echo "tap $t up: $(printf '%s' "$out" | oneline)"; return 1; }
  done
}

# ---- egress (ADR 0008, TD-058) -----------------------------------------------------------------------------
# --network nat joins a lease's namespace to the System VM with one veth pair (root end vpd<N>, namespace end up.<N>,
# a /30 from 198.18.0.0/16) and masquerades it out of eth0. Two default-deny layers that do not depend on each other:
# the namespace's own iptables (gone with the namespace) and static root rules in raw and mangle, which Docker does
# not manage. A guest may reach public unicast IPv4 over TCP, UDP and ICMP echo, and DNS through its tap gateway.
# The deny list is RFC 6890's special-purpose IPv4 table; the System VM's eth0 subnet is added at run time.
DENY4="0.0.0.0/8 10.0.0.0/8 100.64.0.0/10 127.0.0.0/8 169.254.0.0/16 172.16.0.0/12 192.0.0.0/24 192.0.2.0/24 192.88.99.0/24 192.168.0.0/16 198.18.0.0/15 198.51.100.0/24 203.0.113.0/24 224.0.0.0/4 240.0.0.0/4"
NETDIR=$STATE/net                 # net/<id>: "idx=N policy=nat resolver=R gws=TAP:CIDR,..." until the veth is gone
NAT_CURSOR=$STATE/net.cursor      # the last index given; allocation rotates from it
POOL_SIZE=16384                   # /30s in 198.18.0.0/16
NAT_FLOWS=1024                    # tracked flows per lease, in both layers
ip2int() { # A.B.C.D -> integer; fails on a bad address
  case "${1:-}" in ''|*[!0-9.]*|.*|*.|*..*) return 1 ;; esac
  o=$1; n=0; c=0
  while [ -n "$o" ]; do
    p=${o%%.*}; if [ "$p" = "$o" ]; then o=""; else o=${o#*.}; fi
    case "$p" in ''|0?*) return 1 ;; esac # no leading zero: $(( )) would read it as octal
    { [ "${#p}" -le 3 ] && [ "$p" -le 255 ]; } || return 1
    n=$((n * 256 + p)); c=$((c + 1))
  done
  [ "$c" = 4 ] && echo "$n"
}
int2ip() { echo "$(($1 >> 24 & 255)).$(($1 >> 16 & 255)).$(($1 >> 8 & 255)).$(($1 & 255))"; }
mask_of() { if [ "$1" = 0 ]; then echo 0; else echo $(( (0xffffffff << (32 - $1)) & 0xffffffff )); fi; }
cidr_net() { # A.B.C.D/P -> "<network int> <prefix>"
  a=${1%/*}; p=${1#*/}; digits "$p" && [ "$p" -le 32 ] || return 1
  case "$p" in 0?*) return 1 ;; esac
  i=$(ip2int "$a") || return 1
  echo "$((i & $(mask_of "$p"))) $p"
}
cidr_overlap() { # CIDR CIDR -> 0 when they share an address (and when either is unreadable: fail closed)
  x=$(cidr_net "$1") && y=$(cidr_net "$2") || return 0
  set -- $x $y
  q=$2; [ "$4" -lt "$q" ] && q=$4
  m=$(mask_of "$q"); [ $(( $1 & m )) = $(( $3 & m )) ]
}
cidr_in() { # CIDR CONTAINER -> 0 when CIDR lies inside CONTAINER
  x=$(cidr_net "$1") && y=$(cidr_net "$2") || return 1
  set -- $x $y
  [ "$2" -ge "$4" ] && [ $(( $1 & $(mask_of "$4") )) = "$3" ]
}
# The hermetic token tests (tests/vesperd_systemvm.rs) run this script unprivileged on a CI host whose own eth0 and
# resolver are not the System VM's; VESPERD_TEST_ETH0 and VESPERD_TEST_RESOLVER stand in for them, and are ignored
# when the script runs as root, as it always does in the System VM.
test_env() { [ "$(id -u)" != 0 ] && eval "printf '%s' \"\${$1:-}\""; }
eth0_cidr() {
  t=$(test_env VESPERD_TEST_ETH0); [ -n "$t" ] && { echo "$t"; return; }
  ip -o -4 addr show dev eth0 2>/dev/null | awk '{for(i=1;i<=NF;i++) if ($i=="inet") {print $(i+1); exit}}'
}
eth0_subnet() { c=$(eth0_cidr) && [ -n "$c" ] && x=$(cidr_net "$c") && set -- $x && echo "$(int2ip "$1")/$2"; }
resolver4() {
  t=$(test_env VESPERD_TEST_RESOLVER); [ -n "$t" ] && { echo "$t"; return; }
  awk '$1=="nameserver" && $2 ~ /^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$/ {print $2; exit}' /etc/resolv.conf 2>/dev/null
}
# A tap's gateway ADDR/PREFIX under nat: inside RFC 1918, prefix 16..30, a host address, clear of eth0's subnet,
# docker0, the veth pool and the resolver. Prints a reason on failure.
tapaddr_check() { # ADDR/PREFIX
  c=$1; a=${c%/*}; p=${c#*/}
  case "$p" in 0*) p=x ;; esac
  { [ "$a" != "$c" ] && digits "$p" && [ "$p" -ge 16 ] && [ "$p" -le 30 ]; } \
    || { echo "$c: use ADDR/PREFIX with a prefix length of 16 to 30"; return 1; }
  i=$(ip2int "$a") || { echo "$c: bad address"; return 1; }
  hm=$(( (1 << (32 - p)) - 1 ))
  { [ $((i & hm)) != 0 ] && [ $((i & hm)) != "$hm" ]; } || { echo "$c: the gateway must be a host address"; return 1; }
  { cidr_in "$c" 10.0.0.0/8 || cidr_in "$c" 172.16.0.0/12 || cidr_in "$c" 192.168.0.0/16; } \
    || { echo "$c: not inside RFC 1918"; return 1; }
  r=$(resolver4); e=$(eth0_subnet)
  for o in 172.17.0.0/16 198.18.0.0/15 ${e:+"$e"} ${r:+"$r/32"}; do
    cidr_overlap "$c" "$o" && { echo "$c overlaps $o"; return 1; }
  done
  return 0
}
veth_ip() { echo "198.18.$(($1 / 64)).$(( ($1 % 64) * 4 + $2 ))"; } # N END(1 root, 2 namespace) -> address
net_idx() { sed -n 's/^idx=\([0-9]*\).*/\1/p' "$NETDIR/$1" 2>/dev/null; }
vpd_links() { ip -o link 2>/dev/null | sed -n 's/^[0-9]*: vpd\([0-9]*\)[@:].*/\1/p'; }
pick_idx() { # (lock held) -> a free index, rotating from the last one given
  used=" $(cat "$NETDIR"/* 2>/dev/null | sed -n 's/^idx=\([0-9]*\).*/\1/p' | tr '\n' ' ') $(vpd_links | tr '\n' ' ') "
  last=$(cat "$NAT_CURSOR" 2>/dev/null); digits "$last" || last=-1
  k=0
  while [ "$k" -lt "$POOL_SIZE" ]; do
    k=$((k + 1)); n=$(( (last + k) % POOL_SIZE ))
    case "$used" in *" $n "*) continue ;; esac
    echo "$n" > "$NAT_CURSOR"; echo "$n"; return 0
  done
  return 1
}
# The root layer: static, one set for every lease. The mangle chains are replaced atomically (iptables-restore
# --noflush flushes only the chains it declares) when the resolver or eth0's subnet changed, and then every running
# lease's namespace rules are rebuilt for the new values. The flow limit comes before every accept, DNS included.
nat_root_sig() { echo "vesperd-egress v2 resolver=$1 eth0=$2"; }
nat_root_chains_ok() { # RESOLVER ETH0SUBNET
  iptables -t mangle -S VESPERD-EGRESS 2>/dev/null | grep -qF -- "$(nat_root_sig "$1" "$2")" \
    && iptables -t mangle -S VESPERD-REPLY 2>/dev/null | grep -q -- '-A VESPERD-REPLY -j DROP'
}
nat_root_ok() { # RESOLVER ETH0SUBNET -> 0 when every root rule is in place
  nat_root_chains_ok "$1" "$2" || return 1
  iptables -t mangle -C PREROUTING -i vpd+ -j VESPERD-EGRESS 2>/dev/null || return 1
  iptables -t mangle -C POSTROUTING -o vpd+ -j VESPERD-REPLY 2>/dev/null || return 1
  iptables -t mangle -C INPUT -i vpd+ -j DROP 2>/dev/null || return 1
  iptables -t mangle -C FORWARD -i vpd+ ! -o eth0 -j DROP 2>/dev/null || return 1
  iptables -t raw -C PREROUTING -i vpd+ ! -s 198.18.0.0/16 -j DROP 2>/dev/null || return 1
  iptables -t nat -C POSTROUTING -s 198.18.0.0/16 -o eth0 -j MASQUERADE 2>/dev/null || return 1
  iptables -t filter -C DOCKER-USER -i vpd+ -o eth0 -j ACCEPT 2>/dev/null || return 1
  iptables -t filter -C DOCKER-USER -i eth0 -o vpd+ -m conntrack --ctstate ESTABLISHED,RELATED -j ACCEPT 2>/dev/null || return 1
  ip6tables -t raw -C PREROUTING -i vpd+ -j DROP 2>/dev/null || return 1
  ip6tables -t mangle -C POSTROUTING -o vpd+ -j DROP 2>/dev/null || return 1
  [ "$(cat /proc/sys/net/ipv4/ip_forward)" = 1 ]
}
ipt_ensure() { # iptables|ip6tables TABLE CHAIN RULE...: insert at the top unless present
  b=$1; t=$2; shift 2
  "$b" -t "$t" -C "$@" 2>/dev/null || "$b" -t "$t" -I "$@"
}
nat_root_rules() { # RESOLVER ETH0SUBNET (lock held) -> a reason on failure
  res=$1; sub=$2; sig=$(nat_root_sig "$res" "$sub")
  if ! nat_root_chains_ok "$res" "$sub"; then
    out=$({
      echo "*mangle"
      echo ":VESPERD-EGRESS - [0:0]"
      echo ":VESPERD-REPLY - [0:0]"
      echo "-A VESPERD-EGRESS -m comment --comment \"$sig\" -m conntrack --ctstate INVALID -j DROP"
      echo "-A VESPERD-EGRESS -m conntrack --ctstate ESTABLISHED,RELATED -j RETURN"
      echo "-A VESPERD-EGRESS -m connlimit --connlimit-above $NAT_FLOWS --connlimit-mask 32 --connlimit-saddr -j DROP"
      echo "-A VESPERD-EGRESS -d $res/32 -p udp --dport 53 -j RETURN"
      echo "-A VESPERD-EGRESS -d $res/32 -p tcp --dport 53 -j RETURN"
      for d in $DENY4 $sub; do echo "-A VESPERD-EGRESS -d $d -j DROP"; done
      echo "-A VESPERD-EGRESS -p tcp -j RETURN"
      echo "-A VESPERD-EGRESS -p udp -j RETURN"
      echo "-A VESPERD-EGRESS -p icmp --icmp-type echo-request -j RETURN"
      echo "-A VESPERD-EGRESS -j DROP"
      echo "-A VESPERD-REPLY -m conntrack --ctstate ESTABLISHED,RELATED -j RETURN"
      echo "-A VESPERD-REPLY -j DROP"
      echo "COMMIT"
    } | iptables-restore --noflush 2>&1) || { echo "root mangle rules: $(printf '%s' "$out" | oneline)"; return 1; }
    for nf in "$NETDIR"/*; do # running leases follow the new resolver and eth0 subnet
      [ -f "$nf" ] || continue
      # A subshell: ns_rules sets the same shell variables its callers use.
      (ns_rules "${nf##*/}" "$res") > /dev/null || echo "lease ${nf##*/}: namespace rules not refreshed" >&2
    done
  fi
  ipt_ensure iptables mangle PREROUTING -i vpd+ -j VESPERD-EGRESS || { echo "root mangle jump"; return 1; }
  ipt_ensure iptables mangle POSTROUTING -o vpd+ -j VESPERD-REPLY || { echo "root mangle reply jump"; return 1; }
  # Nothing from a lease is for the System VM itself, and nothing is forwarded anywhere but eth0.
  ipt_ensure iptables mangle INPUT -i vpd+ -j DROP || { echo "root mangle input rule"; return 1; }
  ipt_ensure iptables mangle FORWARD -i vpd+ ! -o eth0 -j DROP || { echo "root mangle forward rule"; return 1; }
  ipt_ensure iptables raw PREROUTING -i vpd+ ! -s 198.18.0.0/16 -j DROP || { echo "root raw rule"; return 1; }
  ipt_ensure iptables nat POSTROUTING -s 198.18.0.0/16 -o eth0 -j MASQUERADE || { echo "root nat rule"; return 1; }
  # Docker owns FORWARD's order; these accepts only let traffic through, every drop is in raw and mangle above.
  iptables -t filter -N DOCKER-USER 2>/dev/null
  ipt_ensure iptables filter FORWARD -j DOCKER-USER || { echo "root forward jump"; return 1; }
  ipt_ensure iptables filter DOCKER-USER -i eth0 -o vpd+ -m conntrack --ctstate ESTABLISHED,RELATED -j ACCEPT \
    && ipt_ensure iptables filter DOCKER-USER -i vpd+ -o eth0 -j ACCEPT || { echo "root forward accepts"; return 1; }
  ipt_ensure ip6tables raw PREROUTING -i vpd+ -j DROP && ipt_ensure ip6tables mangle POSTROUTING -o vpd+ -j DROP \
    || { echo "root ip6 rules"; return 1; }
  echo 1 > /proc/sys/net/ipv4/ip_forward
  nat_root_ok "$res" "$sub" || { echo "root rules not in place"; return 1; }
}
net_field() { sed -n "s/.* $2=\([^ ]*\).*/\1/p" "$NETDIR/$1" 2>/dev/null; } # ID KEY -> value from net/<id>
# The namespace layer of lease ID from its record (and RESOLVER, which is written back): the filter and nat tables
# are each replaced whole, so a rebuild is atomic. Prints a reason on failure.
ns_rules() { # ID RESOLVER
  nid=$1; res=$2; f="$NETNS/$nid"; n=$(net_idx "$nid"); gws=$(net_field "$nid" gws | tr ',' ' ')
  sub=$(eth0_subnet); [ -n "$n" ] && [ -n "$gws" ] && [ -n "$sub" ] || { echo "net record of $nid"; return 1; }
  rules=$({
    echo "*filter"; echo ":INPUT DROP [0:0]"; echo ":FORWARD DROP [0:0]"; echo ":OUTPUT DROP [0:0]"
    echo ":VESPERD-GUEST - [0:0]"
    echo "-A INPUT -i lo -j ACCEPT"; echo "-A INPUT -m conntrack --ctstate ESTABLISHED,RELATED -j ACCEPT"
    echo "-A OUTPUT -o lo -j ACCEPT"; echo "-A OUTPUT -m conntrack --ctstate ESTABLISHED,RELATED -j ACCEPT"
    echo "-A FORWARD -m conntrack --ctstate INVALID -j DROP"
    echo "-A FORWARD -m conntrack --ctstate ESTABLISHED,RELATED -j ACCEPT"
    for spec in $gws; do
      t=${spec%%:*}; x=$(cidr_net "${spec#*:}"); set -- $x
      echo "-A FORWARD -i $t -s $(int2ip "$1")/$2 -o up.$n -j VESPERD-GUEST"
    done
    echo "-A VESPERD-GUEST -m connlimit --connlimit-above $NAT_FLOWS --connlimit-mask 0 -j DROP"
    echo "-A VESPERD-GUEST -d $res/32 -p udp --dport 53 -j ACCEPT"
    echo "-A VESPERD-GUEST -d $res/32 -p tcp --dport 53 -j ACCEPT"
    for d in $DENY4 $sub; do echo "-A VESPERD-GUEST -d $d -j DROP"; done
    echo "-A VESPERD-GUEST -p tcp -j ACCEPT"; echo "-A VESPERD-GUEST -p udp -j ACCEPT"
    echo "-A VESPERD-GUEST -p icmp --icmp-type echo-request -j ACCEPT"
    echo "COMMIT"
    echo "*nat"; echo ":PREROUTING ACCEPT [0:0]"; echo ":INPUT ACCEPT [0:0]"; echo ":OUTPUT ACCEPT [0:0]"; echo ":POSTROUTING ACCEPT [0:0]"
    for spec in $gws; do
      t=${spec%%:*}; g=${spec#*:}; g=${g%/*}
      echo "-A PREROUTING -i $t -d $g/32 -p udp --dport 53 -j DNAT --to-destination $res:53"
      echo "-A PREROUTING -i $t -d $g/32 -p tcp --dport 53 -j DNAT --to-destination $res:53"
    done
    echo "-A POSTROUTING -o up.$n -j MASQUERADE"
    echo "COMMIT"
  })
  out=$(printf '%s\n' "$rules" | nsenter --net="$f" iptables-restore 2>&1) \
    || { echo "namespace rules: $(printf '%s' "$out" | oneline)"; return 1; }
  out=$(printf '*filter\n:INPUT DROP [0:0]\n:FORWARD DROP [0:0]\n:OUTPUT DROP [0:0]\nCOMMIT\n' | nsenter --net="$f" ip6tables-restore 2>&1) \
    || { echo "namespace ip6 rules: $(printf '%s' "$out" | oneline)"; return 1; }
  sed -i "s/ resolver=[^ ]*/ resolver=$res/" "$NETDIR/$nid"
}
# The veth and the namespace layer for lease ID, with gateway specs TAP:ADDR/PREFIX... (lock held; the namespace and
# its taps exist). The gateway addresses go on last, once the rules that police them are in place. Prints a reason on
# failure; teardown removes whatever was made.
nat_up() {
  nid=$1; shift; f="$NETNS/$nid"
  res=$(resolver4); [ -n "$res" ] || { echo "no IPv4 resolver in /etc/resolv.conf"; return 1; }
  sub=$(eth0_subnet); [ -n "$sub" ] || { echo "eth0 has no IPv4 address"; return 1; }
  why=$(nat_root_rules "$res" "$sub") || { echo "$why"; return 1; }
  mkdir -p "$NETDIR" && chmod 0700 "$NETDIR" || { echo "net directory"; return 1; }
  n=$(pick_idx) || { echo "no free veth address"; return 1; }
  # The file exists before the link, so leftovers and the reaper always know the link's owner.
  echo "idx=$n policy=nat resolver=$res gws=$(echo "$*" | tr ' ' ',')" > "$NETDIR/$nid" || { echo "net record"; return 1; }
  r=$(veth_ip "$n" 1); v=$(veth_ip "$n" 2)
  # busybox ip ignores "peer name", so the peer is born vethN in this fresh, private namespace, where no tap may be
  # named veth*: it is the only veth link there. It is renamed vpd<N> and moved to the root namespace.
  nsenter --net="$f" ip link add "up.$n" type veth 2>/dev/null || { echo "veth up.$n"; return 1; }
  peer=$(nsenter --net="$f" ip -o link | sed -n 's/^[0-9]*: \(veth[0-9]*\)[@:].*/\1/p')
  [ "$(printf '%s\n' "$peer" | grep -c .)" = 1 ] || { echo "veth peer of up.$n: ${peer:-none}"; return 1; }
  nsenter --net="$f" ip link set dev "$peer" name "vpd$n" && nsenter --net="$f" ip link set dev "vpd$n" netns 1 \
    || { echo "veth vpd$n"; return 1; }
  { echo 1 > "/proc/sys/net/ipv6/conf/vpd$n/disable_ipv6" && echo 1 > "/proc/sys/net/ipv4/conf/vpd$n/rp_filter" \
    && echo 0 > "/proc/sys/net/ipv4/conf/vpd$n/send_redirects" \
    && ip addr add "$r/30" dev "vpd$n" && ip link set dev "vpd$n" up; } || { echo "root end vpd$n"; return 1; }
  nsenter --net="$f" sh -c 'echo 1 > /proc/sys/net/ipv4/ip_forward' || { echo "namespace forwarding"; return 1; }
  { nsenter --net="$f" ip addr add "$v/30" dev "up.$n" && nsenter --net="$f" ip link set dev "up.$n" up \
    && nsenter --net="$f" ip route add default via "$r"; } || { echo "namespace end up.$n"; return 1; }
  why=$(ns_rules "$nid" "$res") || { echo "$why"; return 1; }
  for spec in "$@"; do
    t=${spec%%:*}; c=${spec#*:}
    nsenter --net="$f" ip addr add "$c" dev "$t" || { echo "tap $t address $c"; return 1; }
  done
}
nat_down() { # ID: delete the root veth (both ends go with it), then the record once the link is gone
  nid=${1:?}; n=$(net_idx "$nid")
  if [ -n "$n" ]; then
    ip link show "vpd$n" > /dev/null 2>&1 && ip link del "vpd$n" 2>/dev/null
    ip link show "vpd$n" > /dev/null 2>&1 && return 1
  fi
  rm -f "${NETDIR:?}/$nid"
}

reap_pass() { # (caller holds the lock)
  reaped=0; kept=0; now=$(now_s)
  for rec in "$LEASES"/*; do
    [ -f "$rec" ] || continue
    rid=${rec##*/}
    valid_id "$rid" || { rm -f "$rec"; continue; }
    read_record "$rid"
    if proc_alive "$H_PID" "$H_START"; then
      kept=$((kept + 1)); echo "KEPT $rid reason=holder-alive holder=$H_PID"; continue
    fi
    res=$(teardown "$rid"); close_conn; reaped=$((reaped + 1)); echo "REAPED $rid reason=holder-gone holder=$H_PID $res"
  done
  for jail in "$JAILS"/*; do
    [ -d "$jail" ] || continue
    rid=${jail##*/}
    valid_id "$rid" || continue
    [ -e "$LEASES/$rid" ] && continue
    age=$((now - $(stat -c %Y "$jail" 2>/dev/null || echo "$now")))
    if [ "$age" -lt "$GRACE_S" ]; then
      kept=$((kept + 1)); echo "KEPT $rid reason=grace age=$age"; continue
    fi
    res=$(teardown "$rid"); reaped=$((reaped + 1)); echo "REAPED $rid reason=no-record age=$age $res"
  done
  for cg in "$CG"/*; do
    [ -d "$cg" ] || continue
    rid=${cg##*/}
    valid_id "$rid" || continue
    [ -e "$LEASES/$rid" ] || [ -e "$JAILS/$rid" ] || rmdir "$cg" 2>/dev/null
  done
  for nf in "$NETDIR"/*; do
    [ -f "$nf" ] || continue
    rid=${nf##*/}
    valid_id "$rid" || continue
    [ -e "$LEASES/$rid" ] || [ -e "$JAILS/$rid" ] && continue
    nat_down "$rid"; reaped=$((reaped + 1))
    if [ -e "$nf" ]; then echo "REAPED $rid reason=orphan-veth DIRTY $rid veth"; else echo "REAPED $rid reason=orphan-veth CLEAN $rid"; fi
  done
  claimed=" $(cat "$NETDIR"/* 2>/dev/null | sed -n 's/^idx=\([0-9]*\).*/\1/p' | tr '\n' ' ') "
  for n in $(vpd_links); do
    case "$claimed" in *" $n "*) continue ;; esac
    ip link del "vpd$n" 2>/dev/null; reaped=$((reaped + 1)); echo "REAPED vpd$n reason=unclaimed-veth"
  done
  for ns in "$NETNS"/*; do
    [ -e "$ns" ] || continue
    rid=${ns##*/}
    valid_id "$rid" || continue
    [ -e "$LEASES/$rid" ] || [ -e "$JAILS/$rid" ] && continue
    netns_down "$rid"; reaped=$((reaped + 1))
    if [ -e "$ns" ]; then echo "REAPED $rid reason=orphan-netns DIRTY $rid netns"; else echo "REAPED $rid reason=orphan-netns CLEAN $rid"; fi
  done
  for lf in "$LOGS"/*.log; do
    [ -f "$lf" ] || continue
    rid=${lf##*/}; rid=${rid%.log}
    valid_id "$rid" || continue
    [ -e "$LEASES/$rid" ] || [ -e "$JAILS/$rid" ] && continue
    age=$((now - $(stat -c %Y "$lf" 2>/dev/null || echo "$now")))
    [ "$age" -ge "$LOG_KEEP_S" ] || continue
    rm -f "$lf" "$lf.1" "$LOGS/.$rid.pipe"; echo "PRUNED $rid log age=$age"
  done
  echo "REAP reaped=$reaped kept=$kept"
}

# ---- staging and the store (ADR 0007 section 1, slice 5) -------------------------------------------------
# Paths are absolute, made of letters, digits and . _ + , @ = - between single slashes, with no . or .. component
# and no trailing slash; that keeps them safe in the agent's word splitting and in su's command line.
valid_path() {
  case "${1:-}" in /*) ;; *) return 1 ;; esac
  case "$1" in *[!A-Za-z0-9._+,@=/-]*|*/|*//*|*/./*|*/../*|*/.|*/..) return 1 ;; esac
  [ "${#1}" -le "$MAX_PATH" ]
}
valid_name() { # a store name; names starting with a dot are the store's unfinished copies
  case "${1:-}" in ''|.*|*[!A-Za-z0-9._+,@=-]*) return 1 ;; esac
  [ "${#1}" -le "$MAX_NAME" ]
}
user_ok() { grep -q "^$JUSER:x:$JUID:$JGID:" /etc/passwd; }
setup_user() {
  grep -q "^$JUSER:" /etc/group || addgroup -S -g "$JGID" "$JUSER" || { echo "ERR addgroup $JUSER"; return 1; }
  grep -q "^$JUSER:" /etc/passwd || adduser -S -D -H -u "$JUID" -G "$JUSER" -s /sbin/nologin -h / -g "vesperd jail" "$JUSER" \
    || { echo "ERR adduser $JUSER"; return 1; }
  user_ok || { echo "ERR $JUSER exists with another uid or gid"; return 1; }
  echo "USER $JUSER $JUID"
}
# Runs a jail-side subcommand of this script as uid 20000 (busybox su; the user has no login shell, so -s).
as_jail() { su -s /bin/sh "$JUSER" -c 'exec /usr/local/bin/vesper-vesperd "$@"' vesper-vesperd "$@"; }

reserve_bytes() {
  r=$(cat "$RESERVE_OVERRIDE" 2>/dev/null)
  digits "$r" && { echo "$r"; return; }
  awk '/^MemTotal:/{print $2 * 1024}' /proc/meminfo
}
avail_bytes() { df -k "$DATA" | awk 'NR==2 {print $4 * 1024}'; }
store_quota() { # bytes the store may hold: STORE_PCT of the data disk, unless a test overrides it
  q=$(cat "$QUOTA_OVERRIDE" 2>/dev/null)
  digits "$q" && { echo "$q"; return; }
  # Shell arithmetic is 64-bit; BusyBox awk's printf "%d" clamps to 2^31-1, which once made the quota 2 GiB.
  kib=$(df -k "$DATA" | awk 'NR==2 {print $2}')
  digits "$kib" || return 1
  echo $((kib * 1024 / 100 * STORE_PCT))
}
store_used() { # a file removed mid-scan counts 0, so the sum never fails on a missing stat
  u=0; for f in "$STORE"/* "$STORE"/.partial.*; do s=$(stat -c %s "$f" 2>/dev/null) && u=$((u + s)); done; echo "$u"; }
quota_check() { # BYTES (store lock held): refuse a copy into the store that would pass its quota
  used=$(store_used); q=$(store_quota)
  digits "$q" || { echo "store quota unknown"; return 1; }
  [ $((used + $1)) -le "$q" ] || { echo "store quota: copying $1 bytes would bring the store to $((used + $1)) of its $q-byte quota ($STORE_PCT% of the data disk); remove files with vesperd store rm"; return 1; }
}
# BYTES: refuse a copy of BYTES that would leave less than the reserve free on the data disk.
reserve_check() {
  a=$(avail_bytes); r=$(reserve_bytes)
  digits "$a" || { echo "free space unknown"; return 1; }
  [ $((a - $1)) -ge "$r" ] || { echo "reserve: copying $1 bytes would leave $((a - $1)) of the $r-byte free-space reserve (avail $a)"; return 1; }
}
store_lock() { exec 8>"$STORE_LOCK" && flock 8; }
store_unlock() { flock -u 8 2>/dev/null; exec 8>&-; }

# root side: a regular file under a virtio-fs share mount, no symlink below the mount point -> its size
share_file() {
  p=$1; m=""
  for mp in $(awk '$3 == "virtiofs" {print $2}' /proc/mounts); do
    case "$p" in "$mp"/*) [ "${#mp}" -gt "${#m}" ] && m=$mp ;; esac
  done
  [ -n "$m" ] || { echo "$p is not inside a configured share"; return 1; }
  cur=$m; rest=${p#"$m"/}
  while :; do
    comp=${rest%%/*}; cur="$cur/$comp"
    [ -L "$cur" ] && { echo "$p: symlink at $cur"; return 1; }
    [ "$rest" = "$comp" ] && break
    [ -d "$cur" ] || { echo "$p: $cur is not a directory"; return 1; }
    rest=${rest#*/}
  done
  [ -f "$cur" ] || { echo "$p is not a regular file"; return 1; }
  stat -c %s "$cur"
}
store_file() { # NAME -> its size
  f="$STORE/$1"
  { [ -f "$f" ] && [ ! -L "$f" ]; } || { echo "no store file $1"; return 1; }
  stat -c %s "$f"
}

# uid 20000 side. ROOT is a jail root; PATH is a valid path inside it. Every component below ROOT is checked not
# to be a symlink, as this user; the opens run as this user too, so a symlink that appears after the check can
# only reach what uid 20000 may open anyway (not the System VM's root-only files).
jail_guard() { # ROOT PATH
  [ "$(id -u)" = "$JUID" ] || { echo "ERR jail-side subcommands run as uid $JUID only"; exit 2; }
  case "$1" in "$JAILS"/*/root) valid_id "$(basename "$(dirname "$1")")" || { echo "ERR bad jail root"; exit 2; } ;; *) echo "ERR bad jail root"; exit 2 ;; esac
  valid_path "${2:-}" || { echo "ERR bad path"; exit 2; }
}
jail_walk() { # ROOT PATH read|write -> sets J_FILE
  cur=$1; rest=${2#/}
  while :; do
    comp=${rest%%/*}; cur="$cur/$comp"
    [ -L "$cur" ] && { echo "ERR symlink at ${cur#"$1"}"; exit 1; }
    [ "$rest" = "$comp" ] && break
    if [ ! -e "$cur" ] && [ "$3" = write ]; then mkdir "$cur" || { echo "ERR mkdir ${cur#"$1"}"; exit 1; }; fi
    [ -d "$cur" ] && [ ! -L "$cur" ] || { echo "ERR ${cur#"$1"} is not a directory"; exit 1; }
    rest=${rest#*/}
  done
  if [ "$3" = read ]; then [ -f "$cur" ] || { echo "ERR $2 is not a regular file"; exit 1; }
  else { [ -e "$cur" ] || [ -L "$cur" ]; } && { echo "ERR $2 exists"; exit 1; }; fi
  J_FILE=$cur
}
jail_stat() { jail_guard "$@"; jail_walk "$1" "$2" read; s=$(stat -c %s "$J_FILE") || exit 1; echo "SIZE $s"; }
jail_read() { # ROOT PATH BYTES: exactly BYTES bytes of the file to stdout
  jail_guard "$@"; digits "${3:-}" || { echo "ERR bad size" >&2; exit 2; }
  jail_walk "$1" "$2" read >&2
  [ -r "$J_FILE" ] || { echo "ERR $2: permission denied for uid $(id -u)" >&2; exit 1; }
  exec head -c "$3" < "$J_FILE"
}
jail_write() { # ROOT PATH BYTES: stdin to a new file (O_EXCL, never through a symlink), exactly BYTES bytes
  jail_guard "$@"; digits "${3:-}" || { echo "ERR bad size"; exit 2; }
  jail_walk "$1" "$2" write
  set -C
  head -c "$3" > "$J_FILE" || { echo "ERR write $2"; exit 1; }
  got=$(stat -c %s "$J_FILE")
  [ "$got" = "$3" ] || { rm -f "$J_FILE"; echo "ERR $2: wrote $got of $3 bytes"; exit 1; }
  echo "WROTE $3"
}

# SRC and DEST as given; ROOT is the jail root (empty when neither side is a jail); prints a reason on failure.
# Callers hold the store lock. Copies only.
copy_one() { # SRC DEST ROOT
  src=$1; dest=$2; root=$3; err=""
  case "$src" in
    share:*) size=$(share_file "${src#share:}") || { echo "$size"; return 1; } ;;
    store:*) size=$(store_file "${src#store:}") || { echo "$size"; return 1; } ;;
    jail:*) out=$(as_jail jail-stat "$root" "${src#jail:}") || { echo "${out#ERR }"; return 1; }; size=${out#SIZE } ;;
  esac
  digits "$size" || { echo "size of $src unknown"; return 1; }
  why=$(reserve_check "$size") || { echo "$why"; return 1; }
  case "$dest" in
    store:*)
      name=${dest#store:}; tmp="$STORE/.partial.$$"
      [ -e "$STORE/$name" ] && { echo "store:$name exists"; return 1; }
      why=$(quota_check "$size") || { echo "$why"; return 1; }
      rm -f "$tmp"
      case "$src" in
        share:*) (umask 077; head -c "$size" < "${src#share:}" > "$tmp") ;;
        jail:*) err=$( { (umask 077; as_jail jail-read "$root" "${src#jail:}" "$size" > "$tmp"); } 2>&1 ) ;;
      esac
      [ -n "${err:-}" ] && { rm -f "$tmp"; echo "${err#ERR }" | head -1; return 1; }
      got=$(stat -c %s "$tmp" 2>/dev/null)
      [ "$got" = "$size" ] || { rm -f "$tmp"; echo "copied ${got:-0} of $size bytes from $src"; return 1; }
      chmod 0444 "$tmp" && mv -f "$tmp" "$STORE/$name" || { rm -f "$tmp"; echo "store:$name: rename failed"; return 1; }
      ;;
    *)
      case "$src" in
        share:*) out=$(head -c "$size" < "${src#share:}" 2>/dev/null | as_jail jail-write "$root" "$dest" "$size") ;;
        store:*) out=$(head -c "$size" < "$STORE/${src#store:}" 2>/dev/null | as_jail jail-write "$root" "$dest" "$size") ;;
      esac || { echo "${out#ERR }"; return 1; }
      ;;
  esac
  echo "$size"
}
# Checks the forms of SRC and DEST; prints a reason on failure.
stage_forms() { # SRC DEST
  case "$1" in
    share:*) valid_path "${1#share:}" || { echo "bad SRC $1: share: needs an absolute path of letters, digits and ._+,@=- with no . or .. component"; return 1; } ;;
    store:*) valid_name "${1#store:}" || { echo "bad SRC $1: bad store name"; return 1; } ;;
    jail:*) valid_path "${1#jail:}" || { echo "bad SRC $1: jail: needs an absolute path of letters, digits and ._+,@=- with no . or .. component"; return 1; } ;;
    *) echo "bad SRC $1: use share:/PATH, store:NAME or jail:/PATH"; return 1 ;;
  esac
  case "$2" in
    store:*) valid_name "${2#store:}" || { echo "bad DEST $2: bad store name"; return 1; } ;;
    /*) valid_path "$2" || { echo "bad DEST $2: a jail path is absolute, of letters, digits and ._+,@=-, with no . or .. component"; return 1; } ;;
    *) echo "bad DEST $2: use /PATH in the jail or store:NAME"; return 1 ;;
  esac
  case "$1 $2" in
    "store:"*" store:"*) echo "store to store is not a stage"; return 1 ;;
    "jail:"*" /"*) echo "jail to jail is not a stage"; return 1 ;;
  esac
}

stage() { # ID|- SRC DEST: while the microVM runs; copies only
  [ "$#" -eq 3 ] || { echo "ERR usage: stage ID|- SRC DEST"; return 2; }
  sid=$1; src=$2; dest=$3
  why=$(stage_forms "$src" "$dest") || { echo "ERR $why"; return 2; }
  user_ok || { echo "ERR no $JUSER user"; return 1; }
  data_dirs || { echo "ERR data disk not in use"; return 1; }
  root=""
  case "$src $dest" in
    jail:*|*" /"*)
      valid_id "$sid" || { echo "ERR bad id"; return 2; }
      { read_record "$sid" && proc_alive "$H_PID" "$H_START"; } || { echo "ERR no vesperd microVM $sid"; return 1; }
      root="$JAILS/$sid/root"; [ -d "$root" ] || { echo "ERR no jail for $sid"; return 1; } ;;
    *) [ "$sid" = - ] || valid_id "$sid" || { echo "ERR bad id"; return 2; } ;;
  esac
  store_lock
  out=$(copy_one "$src" "$dest" "$root"); rc=$?
  store_unlock
  [ "$rc" = 0 ] || { echo "ERR $out"; return 1; }
  echo "STAGED $src $dest copy bytes=$out"
}

# LAUNCHAPI's stage= tokens, into the fresh jail ROOT before the jailer starts: store:*.mem and store:*.vmstate are
# hard-linked (they stay root-owned and read-only), everything else is copied. Prints a reason on failure.
launch_stage() { # ROOT SPEC...
  lroot=$1; shift
  for spec in "$@"; do
    case "$spec" in stage=*) ;; *) continue ;; esac # tap=, tapaddr= and net= are launch's own
    s=${spec#stage=}; scheme=${s%%:*}; rest=${s#*:}; src="$scheme:${rest%%:*}"; dest=${rest#*:}
    [ "$rest" != "$s" ] && [ "$dest" != "$rest" ] || { echo "stage $s: use SRC:DEST"; return 1; }
    why=$(stage_forms "$src" "$dest") || { echo "stage $s: $why"; return 1; }
    case "$src $dest" in
      jail:*) echo "stage $s: jail: sources need a running microVM (vesperd stage)"; return 1 ;;
      *" store:"*) echo "stage $s: --stage writes into the jail; use vesperd stage for store:"; return 1 ;;
    esac
    case "$src" in
      store:*.mem|store:*.vmstate)
        name=${src#store:}; f="$STORE/$name"
        { [ -f "$f" ] && [ ! -L "$f" ]; } || { echo "stage $s: no store file $name"; return 1; }
        d=$lroot; rest=${dest#/}
        while [ "${rest#*/}" != "$rest" ]; do # parent directories; the jail is fresh, so root may create them
          d="$d/${rest%%/*}"; rest=${rest#*/}
          [ -L "$d" ] && { echo "stage $s: symlink in $dest"; return 1; }
          [ -d "$d" ] || { mkdir "$d" && chown "$JUID:$JGID" "$d"; } || { echo "stage $s: mkdir"; return 1; }
        done
        [ -e "$lroot$dest" ] && { echo "stage $s: $dest exists"; return 1; }
        chown 0:0 "$f" && chmod 0444 "$f" && ln "$f" "$lroot$dest" || { echo "stage $s: link failed"; return 1; } ;;
      *)
        store_lock
        out=$(copy_one "$src" "$dest" "$lroot"); rc=$?
        store_unlock
        [ "$rc" = 0 ] || { echo "stage $s: $out"; return 1; } ;;
    esac
  done
}

store_list() {
  data_dirs || { echo "ERR data disk not in use"; return 1; }
  store_lock
  for f in "$STORE"/*; do
    [ -f "$f" ] || continue
    st=$(stat -c '%s %h' "$f" 2>/dev/null) || continue
    echo "STORE ${f##*/} bytes=${st% *} links=${st#* }"
  done
  echo "FREE avail=$(avail_bytes) reserve=$(reserve_bytes) store=$(store_used) quota=$(store_quota)"
  store_unlock
}
store_rm() {
  [ "$#" -eq 1 ] && valid_name "$1" || { echo "ERR usage: store-rm NAME"; return 2; }
  data_dirs || { echo "ERR data disk not in use"; return 1; }
  store_lock
  if [ -f "$STORE/$1" ] && [ ! -L "$STORE/$1" ]; then rm -f "$STORE/$1"; store_unlock; echo "REMOVED $1"
  else store_unlock; echo "ERR no store file $1"; return 1; fi
}
sweep() { # at boot no record survives (they are in tmpfs), so every jail goes; a running caller keeps live ones
  ensure_dirs; data_dirs || { echo "SWEPT jails=0 partial=0 (no data disk)"; return 0; }
  lock; n=0
  for jail in "$JAILS"/*; do
    [ -d "$jail" ] || continue
    rid=${jail##*/}
    [ -e "$LEASES/$rid" ] && continue
    rm -rf "$jail"; n=$((n + 1))
  done
  unlock
  store_lock; p=0
  for f in "$STORE"/.partial.*; do [ -e "$f" ] || continue; rm -f "$f"; p=$((p + 1)); done
  store_unlock
  echo "SWEPT jails=$n partial=$p"
}

# ---- LAUNCHAPI ---------------------------------------------------------------------------------------------
OWN=0; LID=""; SPID=""
lease_exit() {
  [ "$OWN" = 1 ] || return 0
  OWN=0
  unlock; lock
  # Tear down only while the record is still this shell's: the reaper may have taken it, and a new lease may
  # hold the id since.
  if read_record "$LID" && [ "$H_PID" = "$$" ] && [ "$H_START" = "$MY_START" ]; then
    res=$(teardown "$LID") || logger -t vesperd "$res" 2>/dev/null
  fi
  unlock
  [ -n "$SPID" ] && wait "$SPID" 2>/dev/null
  return 0
}
launch_fail() { echo "ERR $*"; exit 1; }

launch() {
  LID=${1:-}; shift 2>/dev/null
  valid_id "$LID" || { echo "ERR bad id"; return 2; }
  ceiling=$DEFAULT_CEILING
  case "${1:-}" in stage=*|tap=*|tapaddr=*|net=*|'') ;; *) ceiling=$1; shift; digits "$ceiling" || { echo "ERR bad ceiling"; return 2; } ;; esac
  nstage=0; taps=""; ntap=0; policy=none; netset=""; gws=""
  for spec in "$@"; do
    case "$spec" in
      stage=*) nstage=$((nstage + 1)) ;;
      tap=*)
        t=${spec#tap=}
        valid_tap "$t" || { echo "ERR bad tap name ${t:-(empty)}: 1 to 15 letters, digits, _ and -, not starting with -, not lo, veth* or vpd*"; return 2; }
        case " $taps " in *" $t "*) echo "ERR tap $t given twice"; return 2 ;; esac
        taps="$taps $t"; ntap=$((ntap + 1)) ;;
      net=none|net=nat) [ -z "$netset" ] || { echo "ERR net= given twice"; return 2; }; netset=1; policy=${spec#net=} ;;
      net=*) echo "ERR bad network policy ${spec#net=}: use none or nat"; return 2 ;;
      tapaddr=*:*) gws="$gws ${spec#tapaddr=}" ;;
      *) echo "ERR usage: LAUNCHAPI <id> [ceiling] [stage=SRC:DEST|tap=NAME|tapaddr=NAME:ADDR/PREFIX|net=none|net=nat]..."; return 2 ;;
    esac
  done
  [ "$nstage" -le "$MAX_STAGES" ] || { echo "ERR at most $MAX_STAGES stage= tokens"; return 2; }
  [ "$ntap" -le "$MAX_TAPS" ] || { echo "ERR at most $MAX_TAPS tap= tokens"; return 2; }
  # Gateway addresses (ADR 0008): only under nat, one per listed tap, clear of each other and of the System VM's nets.
  seen=""; prev=""
  for g in $gws; do
    t=${g%%:*}; c=${g#*:}
    [ "$policy" = nat ] || { echo "ERR tapaddr= needs net=nat"; return 2; }
    case " $taps " in *" $t "*) ;; *) echo "ERR tapaddr= names $t, which is not a tap= token"; return 2 ;; esac
    case " $seen " in *" $t "*) echo "ERR tapaddr= gives $t twice"; return 2 ;; esac
    why=$(tapaddr_check "$c") || { echo "ERR tapaddr $t: $why"; return 2; }
    for o in $prev; do cidr_overlap "$c" "$o" && { echo "ERR tapaddr $t: $c overlaps $o"; return 2; }; done
    seen="$seen $t"; prev="$prev $c"
  done
  [ "$policy" = none ] || [ -n "$gws" ] || { echo "ERR net=nat needs a tapaddr=NAME:ADDR/PREFIX"; return 2; }
  max=$(awk '/^MemTotal:/{print $2 * 1024}' /proc/meminfo)
  { [ "$ceiling" -ge "$MIN_CEILING" ] && [ "$ceiling" -le "$max" ]; } || { echo "ERR ceiling out of range $MIN_CEILING..$max"; return 2; }
  [ -x "$JAILER" ] && [ -x "$FC" ] || { echo "ERR firecracker missing"; return 1; }
  ensure_dirs || { echo "ERR state directories"; return 1; }
  data_dirs || { echo "ERR data disk not in use"; return 1; }
  user_ok || { echo "ERR no $JUSER user"; return 1; }
  ver=$("$FC" --version 2>/dev/null | head -1 | sed -n 's/^Firecracker v\([0-9][0-9.]*\).*/\1/p')
  [ -n "$ver" ] || { echo "ERR firecracker version unknown"; return 1; }
  MY_START=$(start_of $$) || { echo "ERR own start time"; return 1; }
  lock
  reap_pass > /dev/null
  if [ -n "$(leftovers "$LID")" ]; then unlock; echo "ERR busy $LID"; return 1; fi
  prep=$("$MV" prepare 2>&1) || { unlock; echo "ERR prepare: $(printf '%s' "$prep" | head -1 | oneline)"; return 1; }
  # One budget for both owners' microVMs (TD-056); teardown releases it.
  adm=$("$MEMADMIT" acquire vesperd "$LID" "$ceiling") || { unlock; echo "$adm" | head -1; return 1; }
  # The record names this shell before the jail exists, so the reaper can always tell who owns it.
  ppid=$(awk '/^PPid:/{print $2}' "/proc/$$/status"); pstart=$(start_of "$ppid") || pstart=""
  [ "$(cat "/proc/$ppid/comm" 2>/dev/null)" = socat ] && [ -n "$pstart" ] && CONN="$ppid:$pstart" || CONN="-:-"
  write_record "$LID" "$$:$MY_START" "$CONN" "" || { "$MEMADMIT" release vesperd "$LID"; unlock; echo "ERR record"; return 1; }
  OWN=1
  trap lease_exit EXIT
  trap 'exit 129' HUP
  trap 'exit 130' INT
  trap 'exit 143' TERM
  root="$JAILS/$LID/root"
  mkdir -p "$root" || launch_fail "jail"
  cp "$MVM/Image" "$root/Image" && cp "$MVM/initrd.gz" "$root/initrd.gz" && chmod 0644 "$root/Image" "$root/initrd.gz" \
    || launch_fail "stage kernel"
  chown "$JUID:$JGID" "$root"
  # The network namespace (and, under nat, its veth index, which must be unique) is made with the lock held.
  # shellcheck disable=SC2086
  why=$(netns_up "$LID" $taps) || launch_fail "network: $why"
  if [ "$policy" = nat ]; then
    # shellcheck disable=SC2086
    why=$(nat_up "$LID" $gws) || launch_fail "network: $why"
  fi
  # Staging runs before Firecracker exists, outside the lock (the record keeps the reaper off the jail).
  unlock
  if [ "$nstage" -gt 0 ]; then why=$(launch_stage "$root" "$@") || launch_fail "$why"; fi
  lock
  log="$LOGS/$LID.log"; pipe="$LOGS/.$LID.pipe"
  rm -f "$log" "$log.1" "$pipe"
  mkfifo -m 0600 "$pipe" || { unlock; launch_fail "console pipe"; }
  : > "$log"
  # Not on our stdout or stderr (the caller reads them to EOF) nor the lock (fd 9): the bounder outlives us.
  "$BOUNDLOG" "$log" "$LOG_MAX" < "$pipe" > /dev/null 2>&1 9>&- &
  setsid "$JAILER" --id "$LID" --exec-file "$FC" --uid "$JUID" --gid "$JGID" --chroot-base-dir "$BASE" \
    --netns "$NETNS/$LID" --parent-cgroup vesperd --cgroup-version 2 --cgroup pids.max=256 --cgroup "memory.max=$ceiling" \
    -- --api-sock /run/firecracker.socket > "$pipe" 2>&1 < /dev/null 9>&- &
  SPID=$!
  unlock
  sock="$root/run/firecracker.socket"
  i=0
  while [ "$i" -lt $((LAUNCH_WAIT_S * 10)) ]; do
    [ -S "$sock" ] && break
    kill -0 "$SPID" 2>/dev/null || break
    sleep 0.1; i=$((i + 1))
  done
  [ -S "$sock" ] || launch_fail "start failed: $(tail -n 3 "$log" | oneline)"
  # The jailer writes firecracker.pid before it execs Firecracker; read it before any guest code runs.
  pf="$root/firecracker.pid"
  { [ -f "$pf" ] && [ ! -L "$pf" ]; } || launch_fail "no pid file"
  fpid=$(head -c 16 "$pf" | tr -d '\n')
  digits "$fpid" && is_fc_for "$fpid" "$LID" || launch_fail "pid file names no Firecracker for $LID"
  fstart=$(start_of "$fpid") || launch_fail "firecracker exited"
  lock
  write_record "$LID" "$$:$MY_START" "$CONN" "$fpid:$fstart" || { unlock; launch_fail "record"; }
  unlock
  echo "READY $LID pid=$fpid firecracker_version=$ver"
  # The lease: end of file from the client, or Firecracker's exit. head -c 1 under timeout returns "rc=0" with
  # no byte only at end of file; bytes the client sends are discarded.
  while proc_alive "$fpid" "$fstart"; do
    r=$( (timeout "$LEASE_POLL_S" head -c 1 2>/dev/null; echo "rc=$?") )
    [ "$r" = "rc=0" ] && break
  done
  exit 0
}

# ---- FCAPI -------------------------------------------------------------------------------------------------
connect() {
  [ "$#" -le 1 ] || { echo "ERR usage: FCAPI <id>"; return 2; }
  cid=${1:-}
  valid_id "$cid" || { echo "ERR bad id"; return 2; }
  read_record "$cid" || { echo "ERR no vesperd microVM $cid"; return 1; }
  { [ -n "$F_PID" ] && proc_alive "$F_PID" "$F_START"; } || { echo "ERR $cid not ready"; return 1; }
  [ -S "$JAILS/$cid/root/run/firecracker.socket" ] || { echo "ERR $cid has no API socket"; return 1; }
  echo OK
  # chroot-early: socat enters the jail root before it connects, so the path is short (sun_path holds 108
  # bytes) and a symlink planted in the jail cannot lead outside it.
  exec socat -t "$SOCAT_T" STDIO "UNIX-CONNECT:/run/firecracker.socket,chroot-early=$JAILS/$cid/root"
}

# ---- inspection and tests ----------------------------------------------------------------------------------
status() {
  sid=${1:-}; valid_id "$sid" || { echo "ERR bad id"; return 2; }
  if read_record "$sid" && proc_alive "$H_PID" "$H_START"; then
    if [ -n "$F_PID" ] && proc_alive "$F_PID" "$F_START"; then echo "RUNNING $sid pid=$F_PID holder=$H_PID"
    else echo "STARTING $sid holder=$H_PID"; fi
    return 0
  fi
  left=$(leftovers "$sid")
  if [ -z "$left" ]; then echo "ABSENT $sid"; else echo "DIRTY $sid $left"; fi
}

isolation() {
  sid=${1:-}; valid_id "$sid" || { echo "ERR bad id"; return 2; }
  read_record "$sid" && [ -n "$F_PID" ] && proc_alive "$F_PID" "$F_START" || { echo "ERR $sid not running"; return 1; }
  pid=$F_PID
  uid=$(euid_of "$pid")
  cg=$(sed -n 's/^0::\(.*\)$/\1/p' "/proc/$pid/cgroup")
  sec=$(awk '/^Seccomp:/{print $2}' "/proc/$pid/status")
  mem=$(cat "$CG/$sid/memory.max" 2>/dev/null || echo none)
  uid_ok=false; [ "$uid" = "$JUID" ] && uid_ok=true
  chroot_ok=false
  if [ -e "/proc/$pid/root/Image" ] && [ ! -e "/proc/$pid/root/etc/alpine-release" ] \
     && [ "$(readlink "/proc/$pid/ns/mnt")" != "$(readlink /proc/1/ns/mnt)" ]; then chroot_ok=true; fi
  cg_ok=false; [ "$cg" = "/vesperd/$sid" ] && cg_ok=true
  sec_ok=false; [ "$sec" = 2 ] && sec_ok=true
  # netns_ok: Firecracker is in the lease's own bound namespace, which is not the System VM's (fails closed).
  net_ok=false; pnet=$(ns_ino "/proc/$pid/ns/net"); bnet=""; netns_mounted "$sid" && bnet=$(ns_ino "$NETNS/$sid")
  rnet=$(ns_ino /proc/1/ns/net)
  [ -n "$pnet" ] && [ -n "$rnet" ] && [ "$pnet" = "$bnet" ] && [ "$pnet" != "$rnet" ] && net_ok=true
  # ipv6_off: the namespace has IPv6 disabled; egress_ok: none, or nat with both layers in place (fail closed).
  v6=false; [ -n "$bnet" ] && [ "$(nsenter --net="$NETNS/$sid" cat /proc/sys/net/ipv6/conf/all/disable_ipv6 2>/dev/null)" = 1 ] && v6=true
  egress=none; eg_ok=true
  if [ -f "$NETDIR/$sid" ]; then
    egress=nat; eg_ok=false; n=$(net_idx "$sid"); res=$(sed -n 's/.* resolver=\([0-9.]*\).*/\1/p' "$NETDIR/$sid")
    nat_root_ok "$res" "$(eth0_subnet)" && [ "$(cat "/proc/sys/net/ipv6/conf/vpd$n/disable_ipv6" 2>/dev/null)" = 1 ] \
      && nsenter --net="$NETNS/$sid" iptables -S FORWARD 2>/dev/null | grep -q -- '-P FORWARD DROP' \
      && nsenter --net="$NETNS/$sid" iptables -S OUTPUT 2>/dev/null | grep -q -- '-P OUTPUT DROP' && eg_ok=true
  fi
  printf '{"id":"%s","pid":%s,"holder":%s,"uid":%s,"jail":"%s","cgroup":"%s","memory_max":"%s","seccomp_mode":%s,"uid_ok":%s,"chroot_ok":%s,"cgroup_ok":%s,"seccomp_ok":%s,"netns_ok":%s,"ipv6_off":%s,"egress":"%s","egress_ok":%s}\n' \
    "$sid" "$pid" "$H_PID" "${uid:-0}" "$JAILS/$sid/root" "$cg" "$mem" "${sec:-0}" "$uid_ok" "$chroot_ok" "$cg_ok" "$sec_ok" "$net_ok" "$v6" "$egress" "$eg_ok"
}

list() {
  for rec in "$LEASES"/*; do
    [ -f "$rec" ] || continue
    read_record "${rec##*/}"
    echo "LEASE ${rec##*/} holder=$H_PID:$H_START conn=${C_PID:--}:${C_START:--} fc=${F_PID:--}:${F_START:--}"
  done
  for jail in "$JAILS"/*; do [ -d "$jail" ] && echo "JAIL ${jail##*/}"; done
  for ns in "$NETNS"/*; do [ -e "$ns" ] && echo "NETNS ${ns##*/}"; done
  for nf in "$NETDIR"/*; do [ -f "$nf" ] && echo "VETH ${nf##*/} $(cat "$nf")"; done
  for n in $(vpd_links); do echo "LINK vpd$n"; done
  return 0
}

vlog() { sid=${1:-}; valid_id "$sid" || { echo "ERR bad id"; return 2; }; n=${2:-20}; digits "$n" || n=20
  [ -f "$LOGS/$sid.log" ] || { echo "ERR no log for $sid"; return 1; }
  cat "$LOGS/$sid.log.1" "$LOGS/$sid.log" 2>/dev/null | tail -n "$n"; }
logsize() { # ID -> LOGSIZE ID current=N previous=N max=N (TD-055)
  sid=${1:-}; valid_id "$sid" || { echo "ERR bad id"; return 2; }
  [ -f "$LOGS/$sid.log" ] || { echo "ERR no log for $sid"; return 1; }
  echo "LOGSIZE $sid current=$(stat -c %s "$LOGS/$sid.log") previous=$(stat -c %s "$LOGS/$sid.log.1" 2>/dev/null || echo 0) max=$LOG_MAX"
}

kill_holder() {
  sid=${1:-}; valid_id "$sid" || { echo "ERR bad id"; return 2; }
  read_record "$sid" && proc_alive "$H_PID" "$H_START" || { echo "ERR $sid has no live holder"; return 1; }
  kill -KILL "$H_PID" && echo "KILLED-HOLDER $sid pid=$H_PID"
}

kill_fc() {
  sid=${1:-}; valid_id "$sid" || { echo "ERR bad id"; return 2; }
  read_record "$sid" && [ -n "$F_PID" ] && proc_alive "$F_PID" "$F_START" || { echo "ERR $sid not running"; return 1; }
  kill -KILL "$F_PID" && echo "KILLED-FC $sid pid=$F_PID"
}

test_forge_start() {
  sid=${1:-}; valid_id "$sid" || { echo "ERR bad id"; return 2; }
  lock
  read_record "$sid" || { unlock; echo "ERR no record for $sid"; return 1; }
  # Start time 1 (one clock tick after boot) cannot belong to a lease shell; the live pid now looks reused.
  write_record "$sid" "$H_PID:1" "$C_PID:$C_START" "$F_PID:$F_START"
  unlock
  echo "FORGED $sid holder=$H_PID start=1 was=$H_START"
}

test_orphan() {
  sid=${1:-}; valid_id "$sid" || { echo "ERR bad id"; return 2; }
  ensure_dirs; data_dirs || { echo "ERR data disk not in use"; return 1; }; lock
  if [ -e "$LEASES/$sid" ] || [ -e "$JAILS/$sid" ]; then unlock; echo "ERR busy $sid"; return 1; fi
  mkdir -p "$JAILS/$sid/root"
  unlock
  echo "ORPHAN $sid"
}

test_age_log() { # ID SECONDS: backdate ID's console logs, so the reaper's age rule can be tested
  sid=${1:-}; s=${2:-}; valid_id "$sid" && digits "$s" || { echo "ERR usage: test-age-log ID SECONDS"; return 2; }
  [ -f "$LOGS/$sid.log" ] || { echo "ERR no log for $sid"; return 1; }
  for f in "$LOGS/$sid.log" "$LOGS/$sid.log.1"; do [ -f "$f" ] && touch -d "@$(( $(now_s) - s ))" "$f"; done
  echo "AGED-LOG $sid seconds=$s"
}

test_age() {
  sid=${1:-}; s=${2:-}; valid_id "$sid" && digits "$s" || { echo "ERR usage: test-age ID SECONDS"; return 2; }
  [ -d "$JAILS/$sid" ] || { echo "ERR no jail for $sid"; return 1; }
  touch -d "@$(( $(now_s) - s ))" "$JAILS/$sid" && echo "AGED $sid seconds=$s"
}

files() { # FILE lines for ID's jail, listed as uid 20000 (root does not walk a jail Firecracker has run in)
  sid=${1:-}; valid_id "$sid" || { echo "ERR bad id"; return 2; }
  [ -d "$JAILS/$sid/root" ] || { echo "ERR no jail for $sid"; return 1; }
  as_jail jail-files "$JAILS/$sid/root"
}
jail_files() {
  [ "$(id -u)" = "$JUID" ] || { echo "ERR jail-side subcommands run as uid $JUID only"; exit 2; }
  case "${1:-}" in "$JAILS"/*/root) ;; *) echo "ERR bad jail root"; exit 2 ;; esac
  find "$1" -xdev -type f 2>/dev/null | while IFS= read -r f; do
    echo "FILE ${f#"$1"} $(stat -c 'uid=%u mode=%a links=%h bytes=%s' "$f")"
  done
}

net() { # ID's network namespace: one LINK line per interface, then whether it is the System VM's (fails closed)
  sid=${1:-}; valid_id "$sid" || { echo "ERR bad id"; return 2; }
  netns_mounted "$sid" || { echo "ERR no network namespace for $sid"; return 1; }
  f="$NETNS/$sid"
  # One entry: a private mount namespace with the network namespace's own sysfs, for the tun owner. busybox ip -o
  # link prints "N: NAME: <FLAGS> ..."; the flag list is matched as a whole word.
  # shellcheck disable=SC2016
  out=$(nsenter --net="$f" unshare -m sh -c '
    mount --make-rprivate / && mount -t sysfs sysfs /sys || exit 1
    ip -o link | while IFS= read -r l; do
      name=${l#*: }; name=${name%%:*}; name=${name%%@*}
      fl=${l#*<}; fl=${fl%%>*}
      case ",$fl," in *,UP,*) st=UP ;; *) st=DOWN ;; esac
      own=$(cat "/sys/class/net/$name/owner" 2>/dev/null)
      [ "$own" = -1 ] && own=-
      echo "LINK $name state=$st owner=${own:--}"
    done' 2>/dev/null) || { echo "ERR cannot enter the network namespace of $sid"; return 1; }
  [ -n "$out" ] || { echo "ERR no interfaces in the network namespace of $sid"; return 1; }
  printf '%s\n' "$out"
  bnet=$(ns_ino "$f"); rnet=$(ns_ino /proc/1/ns/net)
  sep=false; [ -n "$bnet" ] && [ -n "$rnet" ] && [ "$bnet" != "$rnet" ] && sep=true
  echo "NETNS $sid separate=$sep ino=${bnet:--}"
  if [ -f "$NETDIR/$sid" ]; then
    n=$(net_idx "$sid")
    gw=$(ip -4 route show default 2>/dev/null | awk '{for(i=1;i<=NF;i++) if ($i=="via") {print $(i+1); exit}}')
    echo "POLICY nat $(cat "$NETDIR/$sid") root=$(veth_ip "$n" 1) ns=$(veth_ip "$n" 2) eth0=$(eth0_cidr) gw=${gw:--}"
    # Dropped packets so far: the namespace layer (its FORWARD policy and the guest chain's drops) and the root layer.
    nsd=$(nsenter --net="$f" sh -c 'iptables -nvxL FORWARD | sed -n "1s/.*policy DROP \([0-9]*\) packets.*/\1/p"
      iptables -nvxL VESPERD-GUEST | awk "\$3==\"DROP\" {s+=\$1} END {print s+0}"' 2>/dev/null | awk '{s+=$1} END {print s+0}')
    # Root counters are for every lease together; the suite compares them before and after one guest's probes.
    rtd=$( { iptables -t mangle -nvxL VESPERD-EGRESS; iptables -t mangle -nvxL INPUT; iptables -t mangle -nvxL FORWARD; } 2>/dev/null \
      | awk '$3=="DROP" && ($6=="*" || $6 ~ /^vpd/) {s+=$1} END {print s+0}')
    rwd=$(iptables -t raw -nvxL PREROUTING 2>/dev/null | awk '$3=="DROP" && $6 ~ /^vpd/ {s+=$1} END {print s+0}')
    rpd=$(iptables -t mangle -nvxL VESPERD-REPLY 2>/dev/null | awk '$3=="DROP" {s+=$1} END {print s+0}')
    echo "DROPS $sid ns=${nsd:-0} root=${rtd:-0} raw=${rwd:-0} reply=${rpd:-0}"
    # The flow cap as installed and its own drop counter, in each layer: only a connlimit rule whose target is DROP
    # counts, and `-` means no such rule.
    nsf=$(nsenter --net="$f" cat /proc/sys/net/netfilter/nf_conntrack_count 2>/dev/null)
    rtf=$(cat /proc/sys/net/netfilter/nf_conntrack_count 2>/dev/null)
    nscap=$(nsenter --net="$f" iptables -S VESPERD-GUEST 2>/dev/null | sed -n 's/.*--connlimit-above \([0-9]*\) .*-j DROP$/\1/p' | head -1)
    rtcap=$(iptables -t mangle -S VESPERD-EGRESS 2>/dev/null | sed -n 's/.*--connlimit-above \([0-9]*\) .*-j DROP$/\1/p' | head -1)
    nscd=$(nsenter --net="$f" iptables -nvxL VESPERD-GUEST 2>/dev/null | awk '$3=="DROP" && /#conn / {print $1; exit}')
    rtcd=$(iptables -t mangle -nvxL VESPERD-EGRESS 2>/dev/null | awk '$3=="DROP" && /#conn / {print $1; exit}')
    echo "FLOWS $sid ns=${nsf:--} root=${rtf:--} cap_ns=${nscap:--} cap_root=${rtcap:--} capdrop_ns=${nscd:--} capdrop_root=${rtcd:--}"
  else
    echo "POLICY none"
  fi
}

memory() { # ID's cgroup: memory.current, memory.peak, memory.max and memory.stat's anon and file, in bytes
  sid=${1:-}; valid_id "$sid" || { echo "ERR bad id"; return 2; }
  c="$CG/$sid"; [ -d "$c" ] || { echo "ERR no cgroup for $sid"; return 1; }
  echo "MEMORY $sid current=$(cat "$c/memory.current") peak=$(cat "$c/memory.peak" 2>/dev/null || echo -) max=$(cat "$c/memory.max") $(awk '$1=="anon"||$1=="file"||$1=="shmem"{printf "%s=%s ", $1, $2}' "$c/memory.stat")"
}

test_plant() {
  sid=${1:-}; valid_id "$sid" || { echo "ERR bad id"; return 2; }
  r="$JAILS/$sid/root"; [ -d "$r" ] || { echo "ERR no jail for $sid"; return 1; }
  # What a compromised Firecracker could leave (two symlinks), and what a lost race could point an open at (a
  # root-only file); a test hook, so root writes into the jail here.
  ln -sfn /etc/shadow "$r/planted-link" && ln -sfn "$STORE" "$r/planted-dir" \
    && (umask 077; echo secret > "$r/planted-root") && chown 0:0 "$r/planted-root" && echo "PLANTED $sid"
}
TEST_LISTEN=$STATE/test-listen.pids
test_listen() { # PORT|stop: TCP and UDP listeners on every System VM address (test hook for the egress suite)
  case "${1:-}" in
    stop) [ -f "$TEST_LISTEN" ] && kill $(cat "$TEST_LISTEN") 2>/dev/null; rm -f "${TEST_LISTEN:?}"; echo "LISTEN stopped"; return 0 ;;
  esac
  digits "${1:-}" && [ "$1" -ge 1024 ] && [ "$1" -le 65535 ] || { echo "ERR usage: test-listen PORT|stop"; return 2; }
  ensure_dirs
  setsid socat "TCP-LISTEN:$1,fork,reuseaddr" SYSTEM:'echo vesper-listen' < /dev/null > /dev/null 2>&1 &
  p1=$!
  setsid socat "UDP-RECVFROM:$1,fork,reuseaddr" SYSTEM:'echo vesper-listen' < /dev/null > /dev/null 2>&1 &
  echo "$p1 $!" > "$TEST_LISTEN"
  echo "LISTEN tcp=$1 udp=$1 pids=$(cat "$TEST_LISTEN")"
}
flows() { # the System VM's conntrack table: no conntrack-tools (D-029), so counts and timeouts only
  c=/proc/sys/net/netfilter
  n=$(cat $c/nf_conntrack_count 2>/dev/null); m=$(cat $c/nf_conntrack_max 2>/dev/null)
  digits "$n" && digits "$m" || { echo "ERR conntrack counters unreadable"; return 1; }
  echo "FLOWS root=$n max=$m tcp_established_s=$(cat $c/nf_conntrack_tcp_timeout_established 2>/dev/null || echo -)" \
    "udp_s=$(cat $c/nf_conntrack_udp_timeout 2>/dev/null || echo -)"
}
test_open_ns() { # ID [filter|all]: as a broken namespace layer would be (the root layer alone)
  sid=${1:-}; mode=${2:-filter}; valid_id "$sid" || { echo "ERR bad id"; return 2; }
  case "$mode" in filter|all) ;; *) echo "ERR usage: test-open-ns ID [filter|all]"; return 2 ;; esac
  [ -f "$NETDIR/$sid" ] && netns_mounted "$sid" || { echo "ERR $sid has no nat namespace"; return 1; }
  f="$NETNS/$sid"
  nsenter --net="$f" iptables -P FORWARD ACCEPT && nsenter --net="$f" iptables -F FORWARD || { echo "ERR open FORWARD"; return 1; }
  if [ "$mode" = all ]; then
    # No masquerade and no reverse-path check: guest sources reach the root layer as they are.
    # shellcheck disable=SC2016
    nsenter --net="$f" iptables -t nat -F POSTROUTING && nsenter --net="$f" sh -c \
      'for d in /proc/sys/net/ipv4/conf/*/rp_filter; do echo 0 > "$d"; done' || { echo "ERR open nat"; return 1; }
  fi
  echo "OPENED $sid namespace $mode (root layer only)"
}
test_reach() { # IP PORT: whether the System VM itself reaches IP:PORT over TCP (is the internet there at all?)
  ip2int "${1:-}" > /dev/null && digits "${2:-}" || { echo "ERR usage: test-reach IP PORT"; return 2; }
  if nc -z -w 3 "$1" "$2" < /dev/null > /dev/null 2>&1; then echo "REACH $1:$2 open"; else echo "REACH $1:$2 closed"; fi
}
test_store_quota() {
  case "${1:-}" in
    clear) rm -f "$QUOTA_OVERRIDE"; echo "QUOTA bytes=$(store_quota) (default)" ;;
    *) digits "${1:-}" || { echo "ERR usage: test-store-quota BYTES|clear"; return 2; }
       ensure_dirs; echo "$1" > "$QUOTA_OVERRIDE"; echo "QUOTA bytes=$1 used=$(store_used)" ;;
  esac
}

test_reserve() {
  case "${1:-}" in
    clear) rm -f "$RESERVE_OVERRIDE"; echo "RESERVE bytes=$(reserve_bytes) (default)" ;;
    *) digits "${1:-}" || { echo "ERR usage: test-reserve BYTES|clear"; return 2; }
       ensure_dirs; echo "$1" > "$RESERVE_OVERRIDE"; echo "RESERVE bytes=$1 avail=$(avail_bytes)" ;;
  esac
}

test_container_vsock() {
  img=$(/usr/local/bin/vesper-rootfs import-trivial 2>&1 | sed -n 's/^IMPORTED //p')
  [ -n "$img" ] || { echo "ERR trivial image import failed"; return 1; }
  # The trivial image has busybox and musl only; lend it the System VM's socat and its libraries read-only.
  mounts="-v /usr/bin/socat:/usr/bin/socat:ro"
  for f in $(ldd /usr/bin/socat 2>/dev/null | awk '{for(i=1;i<=NF;i++) if ($i ~ /^\//) print $i}' | sort -u); do
    mounts="$mounts -v $f:$f:ro"
  done
  rc=0
  for mode in default unconfined; do
    opt=""; [ "$mode" = unconfined ] && opt="--security-opt seccomp=unconfined"
    for cid in 1 3; do
      # shellcheck disable=SC2086
      full=$(docker run --rm --network none $opt $mounts "$img" /usr/bin/socat -T 2 /dev/null "VSOCK-CONNECT:$cid:1024" 2>&1)
      drc=$?
      out=$(printf '%s\n' "$full" | grep 'socat\[' | grep ' E ' | tail -1 | oneline)
      # denied: socket(AF_VSOCK) itself failed with EPERM (seccomp); allowed: the socket opened and the connect
      # failed; connected: the connect succeeded; error: the container did not run.
      case "$out" in
        *"socket("*"Operation not permitted"*) verdict=denied ;;
        ?*) verdict=allowed ;;
        *) if [ "$drc" = 0 ]; then verdict=connected; else verdict=error; out=$(printf '%s' "$full" | tail -1 | oneline); fi ;;
      esac
      echo "VSOCK $mode=$verdict cid=$cid detail=${out:-none}"
      [ "$mode" = default ] && [ "$verdict" != denied ] && rc=1
    done
  done
  return "$rc"
}

reap_loop() {
  interval=${1:-10}; digits "$interval" || interval=10
  ensure_dirs
  while :; do
    out=$(lock; reap_pass; unlock)
    printf '%s\n' "$out" | grep -E '^(REAPED|PRUNED)' | while IFS= read -r l; do logger -t vesperd-reaper "$l" 2>/dev/null; done
    sleep "$interval"
  done
}

cmd=${1:-}; shift 2>/dev/null
case "$cmd" in
  launch) launch "$@" ;;
  connect) connect "$@" ;;
  reap) ensure_dirs; lock; reap_pass; unlock ;;
  reap-loop) reap_loop "$@" ;;
  status) status "$@" ;;
  isolation) isolation "$@" ;;
  list) list ;;
  log) vlog "$@" ;;
  kill-holder) kill_holder "$@" ;;
  kill-fc) kill_fc "$@" ;;
  test-forge-start) test_forge_start "$@" ;;
  test-orphan) test_orphan "$@" ;;
  test-age) test_age "$@" ;;
  test-age-log) test_age_log "$@" ;;
  logsize) logsize "$@" ;;
  mem-budget) "$MEMADMIT" status ;;
  test-mem-reserve) "$MEMADMIT" test-reserve "$@" ;;
  test-container-vsock) test_container_vsock ;;
  stage) stage "$@" ;;
  store-list) store_list ;;
  store-rm) store_rm "$@" ;;
  sweep) sweep ;;
  setup-user) setup_user ;;
  files) files "$@" ;;
  memory) memory "$@" ;;
  net) net "$@" ;;
  flows) flows ;;
  test-plant) test_plant "$@" ;;
  test-reserve) test_reserve "$@" ;;
  test-store-quota) test_store_quota "$@" ;;
  test-listen) test_listen "$@" ;;
  test-open-ns) test_open_ns "$@" ;;
  test-reach) test_reach "$@" ;;
  jail-stat) jail_stat "$@" ;;
  jail-read) jail_read "$@" ;;
  jail-write) jail_write "$@" ;;
  jail-files) jail_files "$@" ;;
  *) echo "ERR usage: vesper-vesperd launch|connect|stage|store-list|store-rm|sweep|setup-user|reap|reap-loop|status|isolation|files|memory|net|flows|list|log|kill-holder|kill-fc|test-*"; exit 2 ;;
esac
