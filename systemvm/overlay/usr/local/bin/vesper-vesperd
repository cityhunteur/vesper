#!/bin/sh
# Vesper Backend A for vesperd (ADR 0007, slices 3 and 5): one jailed Firecracker per lease, built from API requests,
# with jails and a snapshot store on the data disk. The agent runs `launch` for LAUNCHAPI and `connect` for FCAPI
# with `exec`, so stdin and stdout are the vsock connection itself. Every other subcommand is reached through the
# agent's buffered VESPERD verb.
# usage: vesper-vesperd launch ID [CEILING] [stage=SRC:DEST|tap=NAME]...
#                                             LAUNCHAPI: start Firecracker unconfigured under the jailer (uid 20000,
#                                             --parent-cgroup vesperd, memory.max=CEILING bytes) in a fresh jail on the
#                                             data disk, after staging each SRC (share:/PATH or store:NAME) to the jail
#                                             path DEST (store:*.mem and store:*.vmstate are hard-linked, root-owned and
#                                             read-only; everything else is copied), in a fresh network namespace
#                                             (jailer --netns) that holds lo and one tap device per tap=NAME, owned by
#                                             uid 20000 and up, with no uplink (CE-0010, TD-058); reply READY ID pid=N
#                                             firecracker_version=V once the API socket exists, or ERR <reason> and
#                                             close. After READY the connection is the lease: on its end of file, or when
#                                             Firecracker exits, the microVM is stopped and its jail, cgroup and record
#                                             removed, then the connection is closed.
#        vesper-vesperd connect ID            FCAPI: reply OK, then relay bytes to ID's API socket (socat, chrooted
#                                             into the jail root); ERR <reason> and close when ID is not a ready
#                                             vesperd microVM.
#        vesper-vesperd stage ID|- SRC DEST   copy SRC (share:/PATH, store:NAME or jail:/PATH in ID's jail) to DEST (a
#                                             path in ID's jail or store:NAME) while ID runs; jail-side reads and writes
#                                             run as vesperd-jail (uid 20000); never links, never overwrites; checks the
#                                             free-space reserve first. STAGED SRC DEST copy bytes=N | ERR <reason>
#        vesper-vesperd store-list            STORE NAME bytes=N links=L lines, then FREE avail=N reserve=N
#        vesper-vesperd store-rm NAME         REMOVED NAME | ERR <reason>
#        vesper-vesperd sweep                 boot sweep (vesper-data mount): remove every jail without a record and
#                                             every unfinished store copy; SWEPT jails=N partial=M
#        vesper-vesperd setup-user            create the vesperd-jail user and group (uid and gid 20000, no login
#                                             shell) if missing (the reaper service, at boot); USER vesperd-jail 20000
#        vesper-vesperd reap                  one reaper pass: REAPED ID reason=… | KEPT ID reason=… lines, then
#                                             REAP reaped=N kept=M
#        vesper-vesperd reap-loop SECONDS     a reaper pass every SECONDS, forever (the vesper-vesperd-reaper service)
#        vesper-vesperd status ID             RUNNING ID pid=N holder=P | STARTING ID holder=P | ABSENT ID |
#                                             DIRTY ID <record|jail|cgroup|process>…
#        vesper-vesperd isolation ID          JSON with uid, chroot, cgroup and seccomp checks of ID's Firecracker
#        vesper-vesperd files ID              FILE PATH uid=U mode=M links=L bytes=N per regular file in ID's jail
#                                             (read as uid 20000)
#        vesper-vesperd net ID                LINK NAME state=UP|DOWN owner=U per interface in ID's network
#                                             namespace, then NETNS ID separate=true|false
#        vesper-vesperd memory ID             MEMORY ID current=N peak=N max=N anon=N file=N (ID's cgroup)
#        vesper-vesperd list                  LEASE ID holder=P:S conn=P:S fc=P:S lines, then a JAIL ID line per jail
#        vesper-vesperd log ID [N]            last N lines of ID's serial console
#        vesper-vesperd kill-holder ID        SIGKILL the lease shell (KILLED-HOLDER ID pid=N); tests the reaper
#        vesper-vesperd kill-fc ID            SIGKILL Firecracker (KILLED-FC ID pid=N); tests the lease
#        vesper-vesperd test-forge-start ID   test hook: rewrite the holder's recorded start time, as if its pid had
#                                             been reused by another process (FORGED ID holder=P)
#        vesper-vesperd test-orphan ID        test hook: create a jail with no record (ORPHAN ID)
#        vesper-vesperd test-age ID SECONDS   test hook: backdate ID's jail directory (AGED ID seconds=N)
#        vesper-vesperd test-plant ID         test hook, as a compromised Firecracker would: /planted-link -> /etc/shadow,
#                                             /planted-dir -> the store, and /planted-root (root-owned, mode 0600) in
#                                             ID's jail (PLANTED ID)
#        vesper-vesperd test-reserve BYTES|clear  test hook: override the free-space reserve until reboot (RESERVE …)
#        vesper-vesperd test-container-vsock  run a default and an unconfined Docker container that open AF_VSOCK;
#                                             VSOCK default=denied|allowed … and VSOCK unconfined=… lines
#        vesper-vesperd jail-stat|jail-read|jail-write ROOT PATH [BYTES]
#                                             internal: the uid 20000 side of stage; refused for any other uid
# Values (docs/exec-plans/completed/2026-11-12-GH156-vesperd-backend-a.md gives the reason for each):
set -u
FC_DIR=/var/lib/vesper/firecracker
FC=$FC_DIR/firecracker
JAILER=$FC_DIR/jailer
MV=/usr/local/bin/vesper-microvm
MVM=/var/lib/vesper/microvm
DATA=/var/lib/vesper/state       # bind-mounted onto the data disk by vesper-data; jails and store share this mount
BASE=$DATA/vesperd/jailer         # --chroot-base-dir
JAILS=$BASE/firecracker           # <chroot base>/<exec file name>/<id>/root
STORE=$DATA/vesperd/store         # files that outlive a microVM; root-owned, read-only, one trust domain
CG=/sys/fs/cgroup/vesperd         # --parent-cgroup vesperd
STATE=/run/vesper/vesperd
LEASES=$STATE/leases              # one record per id: "holder=<pid>:<start> conn=<pid>:<start> fc=<pid>:<start>"
LOCK=$STATE/lock                  # one flock serialises reaping, jail creation and teardown
STORE_LOCK=$STATE/store.lock      # one flock serialises copies (and their reserve checks) and store removals
RESERVE_OVERRIDE=$STATE/reserve   # test-reserve writes it; tmpfs, so a reboot clears it
LOGS=/var/log/vesperd
JUID=20000
JGID=20000
JUSER=vesperd-jail                # the uid 20000 user that jail-side reads and writes run as
DEFAULT_CEILING=671088640         # memory.max default, 640 MiB (measured in slice 5)
MIN_CEILING=134217728             # 128 MiB: Firecracker plus the smallest guest
LAUNCH_WAIT_S=10                  # wait for the API socket after the jailer starts
STOP_GRACE_S=3                    # SIGTERM to SIGKILL
LEASE_POLL_S=1                    # lease end of file and Firecracker exit are noticed within this
GRACE_S=60                        # a jail without a record is spared this long
SOCAT_T=86400                     # socat -t: keep relaying after a half-close (GH #167)
MAX_STAGES=16                     # stage= tokens per LAUNCHAPI
MAX_TAPS=8                        # tap= tokens per LAUNCHAPI
NETNS=$STATE/netns                # one bound network namespace per lease (tmpfs, so a reboot clears it)
MAX_PATH=1024                     # bytes in a jail or share path
MAX_NAME=128                      # bytes in a store name
# The free-space reserve is the System VM's MemTotal: after any copy the data disk still holds one more full
# snapshot memory file of the largest guest a ceiling allows.

valid_id() { # the jailer's rule: 1 to 64 letters, digits and hyphens
  case "${1:-}" in ''|*[!A-Za-z0-9-]*) return 1 ;; esac
  [ "${#1}" -le 64 ]
}
valid_tap() { # a Linux interface name (IFNAMSIZ 16 with the NUL) of letters, digits, _ and -; never lo
  case "${1:-}" in ''|lo|*[!A-Za-z0-9_-]*) return 1 ;; esac
  [ "${#1}" -le 15 ]
}
digits() { case "${1:-}" in ''|*[!0-9]*) return 1 ;; esac; }
now_s() { date +%s; }
oneline() { tr '\n\r\t' '   ' | sed 's/[^ -~]/?/g' | cut -c1-200; } # busybox tr has no working [:print:] complement

proc_stat() { # PID -> "<state> <starttime>" from /proc/PID/stat (fields 3 and 22); fails when absent
  digits "${1:-}" || return 1
  s=$(cat "/proc/$1/stat" 2>/dev/null) || return 1
  [ -n "$s" ] || return 1
  s=${s##*) }
  # shellcheck disable=SC2086
  set -- $s
  echo "$1 ${20}"
}
start_of() { st=$(proc_stat "$1") || return 1; echo "${st#* }"; }
proc_alive() { # PID START -> 0 when PID runs and started at START (a reused pid or a zombie is not alive)
  st=$(proc_stat "${1:-}") || return 1
  [ "${st% *}" != Z ] && [ "${st#* }" = "${2:-}" ]
}
euid_of() { awk '/^Uid:/{print $3}' "/proc/$1/status" 2>/dev/null; }
is_fc_for() { # PID ID -> 0 when PID is a Firecracker running as uid 20000 with --id ID
  [ "$(euid_of "$1")" = "$JUID" ] || return 1
  tr '\0' ' ' < "/proc/$1/cmdline" 2>/dev/null | grep -q -- "firecracker --id $2 "
}
fc_by_id() { pgrep -u "$JUID" -f "firecracker --id $1 " 2>/dev/null | head -1; }

ensure_dirs() { # the tmpfs side; the data-disk side is data_dirs
  mkdir -p "$LEASES" "$LOGS" && chmod 0700 "$STATE" "$LEASES"
}
data_ok() { awk -v d="$DATA" '$2 == d && $3 == "ext4" {f=1} END {exit !f}' /proc/mounts; }
data_dirs() { # jails and store on the data disk; refused when the disk is not in use (ADR 0007 section 5)
  data_ok || return 1
  mkdir -p "$JAILS" "$STORE" && chmod 0755 "$DATA/vesperd" "$BASE" "$JAILS" && chmod 0700 "$STORE"
}
lock() { exec 9>"$LOCK" && flock 9; }
unlock() { flock -u 9 2>/dev/null; exec 9>&-; }

H_PID=""; H_START=""; C_PID=""; C_START=""; F_PID=""; F_START=""
read_record() { # ID -> H_PID H_START C_PID C_START F_PID F_START
  H_PID=""; H_START=""; C_PID=""; C_START=""; F_PID=""; F_START=""
  [ -f "$LEASES/$1" ] || return 1
  for kv in $(cat "$LEASES/$1"); do
    case "$kv" in
      holder=*:*) v=${kv#holder=}; H_PID=${v%%:*}; H_START=${v#*:} ;;
      conn=*:*) v=${kv#conn=}; C_PID=${v%%:*}; C_START=${v#*:} ;;
      fc=*:*) v=${kv#fc=}; F_PID=${v%%:*}; F_START=${v#*:} ;;
    esac
  done
}
write_record() { # ID HOLDER CONN FC
  printf 'holder=%s conn=%s fc=%s\n' "$2" "$3" "$4" > "$LEASES/.$1.tmp" && mv "$LEASES/.$1.tmp" "$LEASES/$1"
}
close_conn() { # the agent listener's handler for a lease whose shell is gone: without this socat keeps the vsock
  # connection open after a SIGKILLed child (seen with socat 1.8.1.3), and the client would never see the lease end.
  if proc_alive "$C_PID" "$C_START" && [ "$(cat "/proc/$C_PID/comm" 2>/dev/null)" = socat ]; then kill -TERM "$C_PID" 2>/dev/null; fi
}

leftovers() { # ID -> the names of what is still there, empty when clean
  out=""
  [ -e "$LEASES/$1" ] && out="$out record"
  [ -e "$JAILS/$1" ] && out="$out jail"
  [ -d "$CG/$1" ] && out="$out cgroup"
  [ -e "$NETNS/$1" ] && out="$out netns"
  [ -n "$(fc_by_id "$1")" ] && out="$out process"
  echo "${out# }"
}

teardown() { # ID (caller holds the lock) -> CLEAN ID | DIRTY ID <what>
  tid=$1; fpid=""
  if read_record "$tid" && [ -n "$F_PID" ] && proc_alive "$F_PID" "$F_START"; then fpid=$F_PID; fi
  [ -n "$fpid" ] || fpid=$(fc_by_id "$tid")
  if [ -n "$fpid" ]; then
    kill -TERM "$fpid" 2>/dev/null
    i=0; while [ "$i" -lt $((STOP_GRACE_S * 10)) ] && [ -n "$(fc_by_id "$tid")" ]; do sleep 0.1; i=$((i + 1)); done
    [ -n "$(fc_by_id "$tid")" ] && kill -KILL "$fpid" 2>/dev/null
    i=0; while [ "$i" -lt 20 ] && [ -n "$(fc_by_id "$tid")" ]; do sleep 0.1; i=$((i + 1)); done
  fi
  # rm -rf does not follow symlinks; the jail's mounts live in the jailer's own mount namespace.
  rm -rf "${JAILS:?}/$tid"
  i=0; while [ -d "$CG/$tid" ] && [ "$i" -lt 20 ]; do rmdir "$CG/$tid" 2>/dev/null || sleep 0.1; i=$((i + 1)); done
  netns_down "$tid"
  rm -f "$LEASES/$tid"
  left=$(leftovers "$tid")
  if [ -z "$left" ]; then echo "CLEAN $tid"; else echo "DIRTY $tid $left"; return 1; fi
}

# ---- networking (CE-0010, TD-058) -------------------------------------------------------------------------
# Each lease gets its own network namespace, bound at $NETNS/ID so the jailer can join it (--netns) and teardown can
# remove it. The jailed Firecracker has no CAP_NET_ADMIN, so it cannot create a tap; it can open one that exists and
# is owned by uid 20000 (the kernel's tun owner check). The namespace has no uplink: the guest reaches its tap and
# nothing else, and the System VM's own interfaces stay out of the jail's reach.
netns_mounted() { awk -v f="$NETNS/$1" '$2 == f && $3 == "nsfs" {m=1} END {exit !m}' /proc/mounts; }
netns_down() { # ID: unbind and remove; the taps go with the namespace once Firecracker is gone
  f="$NETNS/$1"
  netns_mounted "$1" && umount "$f" 2>/dev/null
  netns_mounted "$1" || rm -f "$f"
}
netns_up() { # ID TAP... (caller holds the lock) -> prints a reason on failure
  nid=$1; shift; f="$NETNS/$nid"
  mkdir -p "$NETNS" && chmod 0700 "$NETNS" || { echo "netns directory"; return 1; }
  netns_down "$nid"
  [ -e "$f" ] && { echo "netns $nid still bound"; return 1; }
  : > "$f" && unshare --net="$f" true || { rm -f "$f"; echo "netns create failed"; return 1; }
  out=$(nsenter --net="$f" ip link set lo up 2>&1) || { echo "lo: $(printf '%s' "$out" | oneline)"; return 1; }
  for t in "$@"; do
    out=$(nsenter --net="$f" tunctl -t "$t" -u "$JUSER" 2>&1) || { echo "tap $t: $(printf '%s' "$out" | oneline)"; return 1; }
    out=$(nsenter --net="$f" ip link set "$t" up 2>&1) || { echo "tap $t up: $(printf '%s' "$out" | oneline)"; return 1; }
  done
}

reap_pass() { # (caller holds the lock)
  reaped=0; kept=0; now=$(now_s)
  for rec in "$LEASES"/*; do
    [ -f "$rec" ] || continue
    rid=${rec##*/}
    valid_id "$rid" || { rm -f "$rec"; continue; }
    read_record "$rid"
    if proc_alive "$H_PID" "$H_START"; then
      kept=$((kept + 1)); echo "KEPT $rid reason=holder-alive holder=$H_PID"; continue
    fi
    res=$(teardown "$rid"); close_conn; reaped=$((reaped + 1)); echo "REAPED $rid reason=holder-gone holder=$H_PID $res"
  done
  for jail in "$JAILS"/*; do
    [ -d "$jail" ] || continue
    rid=${jail##*/}
    valid_id "$rid" || continue
    [ -e "$LEASES/$rid" ] && continue
    age=$((now - $(stat -c %Y "$jail" 2>/dev/null || echo "$now")))
    if [ "$age" -lt "$GRACE_S" ]; then
      kept=$((kept + 1)); echo "KEPT $rid reason=grace age=$age"; continue
    fi
    res=$(teardown "$rid"); reaped=$((reaped + 1)); echo "REAPED $rid reason=no-record age=$age $res"
  done
  for cg in "$CG"/*; do
    [ -d "$cg" ] || continue
    rid=${cg##*/}
    valid_id "$rid" || continue
    [ -e "$LEASES/$rid" ] || [ -e "$JAILS/$rid" ] || rmdir "$cg" 2>/dev/null
  done
  for ns in "$NETNS"/*; do
    [ -e "$ns" ] || continue
    rid=${ns##*/}
    valid_id "$rid" || continue
    [ -e "$LEASES/$rid" ] || [ -e "$JAILS/$rid" ] || netns_down "$rid"
  done
  echo "REAP reaped=$reaped kept=$kept"
}

# ---- staging and the store (ADR 0007 section 1, slice 5) -------------------------------------------------
# Paths are absolute, made of letters, digits and . _ + , @ = - between single slashes, with no . or .. component
# and no trailing slash; that keeps them safe in the agent's word splitting and in su's command line.
valid_path() {
  case "${1:-}" in /*) ;; *) return 1 ;; esac
  case "$1" in *[!A-Za-z0-9._+,@=/-]*|*/|*//*|*/./*|*/../*|*/.|*/..) return 1 ;; esac
  [ "${#1}" -le "$MAX_PATH" ]
}
valid_name() { # a store name; names starting with a dot are the store's unfinished copies
  case "${1:-}" in ''|.*|*[!A-Za-z0-9._+,@=-]*) return 1 ;; esac
  [ "${#1}" -le "$MAX_NAME" ]
}
user_ok() { grep -q "^$JUSER:x:$JUID:$JGID:" /etc/passwd; }
setup_user() {
  grep -q "^$JUSER:" /etc/group || addgroup -S -g "$JGID" "$JUSER" || { echo "ERR addgroup $JUSER"; return 1; }
  grep -q "^$JUSER:" /etc/passwd || adduser -S -D -H -u "$JUID" -G "$JUSER" -s /sbin/nologin -h / -g "vesperd jail" "$JUSER" \
    || { echo "ERR adduser $JUSER"; return 1; }
  user_ok || { echo "ERR $JUSER exists with another uid or gid"; return 1; }
  echo "USER $JUSER $JUID"
}
# Runs a jail-side subcommand of this script as uid 20000 (busybox su; the user has no login shell, so -s).
as_jail() { su -s /bin/sh "$JUSER" -c 'exec /usr/local/bin/vesper-vesperd "$@"' vesper-vesperd "$@"; }

reserve_bytes() {
  r=$(cat "$RESERVE_OVERRIDE" 2>/dev/null)
  digits "$r" && { echo "$r"; return; }
  awk '/^MemTotal:/{print $2 * 1024}' /proc/meminfo
}
avail_bytes() { df -k "$DATA" | awk 'NR==2 {print $4 * 1024}'; }
# BYTES: refuse a copy of BYTES that would leave less than the reserve free on the data disk.
reserve_check() {
  a=$(avail_bytes); r=$(reserve_bytes)
  digits "$a" || { echo "free space unknown"; return 1; }
  [ $((a - $1)) -ge "$r" ] || { echo "reserve: copying $1 bytes would leave $((a - $1)) of the $r-byte free-space reserve (avail $a)"; return 1; }
}
store_lock() { exec 8>"$STORE_LOCK" && flock 8; }
store_unlock() { flock -u 8 2>/dev/null; exec 8>&-; }

# root side: a regular file under a virtio-fs share mount, no symlink below the mount point -> its size
share_file() {
  p=$1; m=""
  for mp in $(awk '$3 == "virtiofs" {print $2}' /proc/mounts); do
    case "$p" in "$mp"/*) [ "${#mp}" -gt "${#m}" ] && m=$mp ;; esac
  done
  [ -n "$m" ] || { echo "$p is not inside a configured share"; return 1; }
  cur=$m; rest=${p#"$m"/}
  while :; do
    comp=${rest%%/*}; cur="$cur/$comp"
    [ -L "$cur" ] && { echo "$p: symlink at $cur"; return 1; }
    [ "$rest" = "$comp" ] && break
    [ -d "$cur" ] || { echo "$p: $cur is not a directory"; return 1; }
    rest=${rest#*/}
  done
  [ -f "$cur" ] || { echo "$p is not a regular file"; return 1; }
  stat -c %s "$cur"
}
store_file() { # NAME -> its size
  f="$STORE/$1"
  { [ -f "$f" ] && [ ! -L "$f" ]; } || { echo "no store file $1"; return 1; }
  stat -c %s "$f"
}

# uid 20000 side. ROOT is a jail root; PATH is a valid path inside it. Every component below ROOT is checked not
# to be a symlink, as this user; the opens run as this user too, so a symlink that appears after the check can
# only reach what uid 20000 may open anyway (not the System VM's root-only files).
jail_guard() { # ROOT PATH
  [ "$(id -u)" = "$JUID" ] || { echo "ERR jail-side subcommands run as uid $JUID only"; exit 2; }
  case "$1" in "$JAILS"/*/root) valid_id "$(basename "$(dirname "$1")")" || { echo "ERR bad jail root"; exit 2; } ;; *) echo "ERR bad jail root"; exit 2 ;; esac
  valid_path "${2:-}" || { echo "ERR bad path"; exit 2; }
}
jail_walk() { # ROOT PATH read|write -> sets J_FILE
  cur=$1; rest=${2#/}
  while :; do
    comp=${rest%%/*}; cur="$cur/$comp"
    [ -L "$cur" ] && { echo "ERR symlink at ${cur#"$1"}"; exit 1; }
    [ "$rest" = "$comp" ] && break
    if [ ! -e "$cur" ] && [ "$3" = write ]; then mkdir "$cur" || { echo "ERR mkdir ${cur#"$1"}"; exit 1; }; fi
    [ -d "$cur" ] && [ ! -L "$cur" ] || { echo "ERR ${cur#"$1"} is not a directory"; exit 1; }
    rest=${rest#*/}
  done
  if [ "$3" = read ]; then [ -f "$cur" ] || { echo "ERR $2 is not a regular file"; exit 1; }
  else { [ -e "$cur" ] || [ -L "$cur" ]; } && { echo "ERR $2 exists"; exit 1; }; fi
  J_FILE=$cur
}
jail_stat() { jail_guard "$@"; jail_walk "$1" "$2" read; s=$(stat -c %s "$J_FILE") || exit 1; echo "SIZE $s"; }
jail_read() { # ROOT PATH BYTES: exactly BYTES bytes of the file to stdout
  jail_guard "$@"; digits "${3:-}" || { echo "ERR bad size" >&2; exit 2; }
  jail_walk "$1" "$2" read >&2
  [ -r "$J_FILE" ] || { echo "ERR $2: permission denied for uid $(id -u)" >&2; exit 1; }
  exec head -c "$3" < "$J_FILE"
}
jail_write() { # ROOT PATH BYTES: stdin to a new file (O_EXCL, never through a symlink), exactly BYTES bytes
  jail_guard "$@"; digits "${3:-}" || { echo "ERR bad size"; exit 2; }
  jail_walk "$1" "$2" write
  set -C
  head -c "$3" > "$J_FILE" || { echo "ERR write $2"; exit 1; }
  got=$(stat -c %s "$J_FILE")
  [ "$got" = "$3" ] || { rm -f "$J_FILE"; echo "ERR $2: wrote $got of $3 bytes"; exit 1; }
  echo "WROTE $3"
}

# SRC and DEST as given; ROOT is the jail root (empty when neither side is a jail); prints a reason on failure.
# Callers hold the store lock. Copies only.
copy_one() { # SRC DEST ROOT
  src=$1; dest=$2; root=$3; err=""
  case "$src" in
    share:*) size=$(share_file "${src#share:}") || { echo "$size"; return 1; } ;;
    store:*) size=$(store_file "${src#store:}") || { echo "$size"; return 1; } ;;
    jail:*) out=$(as_jail jail-stat "$root" "${src#jail:}") || { echo "${out#ERR }"; return 1; }; size=${out#SIZE } ;;
  esac
  digits "$size" || { echo "size of $src unknown"; return 1; }
  why=$(reserve_check "$size") || { echo "$why"; return 1; }
  case "$dest" in
    store:*)
      name=${dest#store:}; tmp="$STORE/.partial.$$"
      [ -e "$STORE/$name" ] && { echo "store:$name exists"; return 1; }
      rm -f "$tmp"
      case "$src" in
        share:*) (umask 077; head -c "$size" < "${src#share:}" > "$tmp") ;;
        jail:*) err=$( { (umask 077; as_jail jail-read "$root" "${src#jail:}" "$size" > "$tmp"); } 2>&1 ) ;;
      esac
      [ -n "${err:-}" ] && { rm -f "$tmp"; echo "${err#ERR }" | head -1; return 1; }
      got=$(stat -c %s "$tmp" 2>/dev/null)
      [ "$got" = "$size" ] || { rm -f "$tmp"; echo "copied ${got:-0} of $size bytes from $src"; return 1; }
      chmod 0444 "$tmp" && mv -f "$tmp" "$STORE/$name" || { rm -f "$tmp"; echo "store:$name: rename failed"; return 1; }
      ;;
    *)
      case "$src" in
        share:*) out=$(head -c "$size" < "${src#share:}" 2>/dev/null | as_jail jail-write "$root" "$dest" "$size") ;;
        store:*) out=$(head -c "$size" < "$STORE/${src#store:}" 2>/dev/null | as_jail jail-write "$root" "$dest" "$size") ;;
      esac || { echo "${out#ERR }"; return 1; }
      ;;
  esac
  echo "$size"
}
# Checks the forms of SRC and DEST; prints a reason on failure.
stage_forms() { # SRC DEST
  case "$1" in
    share:*) valid_path "${1#share:}" || { echo "bad SRC $1: share: needs an absolute path of letters, digits and ._+,@=- with no . or .. component"; return 1; } ;;
    store:*) valid_name "${1#store:}" || { echo "bad SRC $1: bad store name"; return 1; } ;;
    jail:*) valid_path "${1#jail:}" || { echo "bad SRC $1: jail: needs an absolute path of letters, digits and ._+,@=- with no . or .. component"; return 1; } ;;
    *) echo "bad SRC $1: use share:/PATH, store:NAME or jail:/PATH"; return 1 ;;
  esac
  case "$2" in
    store:*) valid_name "${2#store:}" || { echo "bad DEST $2: bad store name"; return 1; } ;;
    /*) valid_path "$2" || { echo "bad DEST $2: a jail path is absolute, of letters, digits and ._+,@=-, with no . or .. component"; return 1; } ;;
    *) echo "bad DEST $2: use /PATH in the jail or store:NAME"; return 1 ;;
  esac
  case "$1 $2" in
    "store:"*" store:"*) echo "store to store is not a stage"; return 1 ;;
    "jail:"*" /"*) echo "jail to jail is not a stage"; return 1 ;;
  esac
}

stage() { # ID|- SRC DEST: while the microVM runs; copies only
  [ "$#" -eq 3 ] || { echo "ERR usage: stage ID|- SRC DEST"; return 2; }
  sid=$1; src=$2; dest=$3
  why=$(stage_forms "$src" "$dest") || { echo "ERR $why"; return 2; }
  user_ok || { echo "ERR no $JUSER user"; return 1; }
  data_dirs || { echo "ERR data disk not in use"; return 1; }
  root=""
  case "$src $dest" in
    jail:*|*" /"*)
      valid_id "$sid" || { echo "ERR bad id"; return 2; }
      { read_record "$sid" && proc_alive "$H_PID" "$H_START"; } || { echo "ERR no vesperd microVM $sid"; return 1; }
      root="$JAILS/$sid/root"; [ -d "$root" ] || { echo "ERR no jail for $sid"; return 1; } ;;
    *) [ "$sid" = - ] || valid_id "$sid" || { echo "ERR bad id"; return 2; } ;;
  esac
  store_lock
  out=$(copy_one "$src" "$dest" "$root"); rc=$?
  store_unlock
  [ "$rc" = 0 ] || { echo "ERR $out"; return 1; }
  echo "STAGED $src $dest copy bytes=$out"
}

# LAUNCHAPI's stage= tokens, into the fresh jail ROOT before the jailer starts: store:*.mem and store:*.vmstate are
# hard-linked (they stay root-owned and read-only), everything else is copied. Prints a reason on failure.
launch_stage() { # ROOT SPEC...
  lroot=$1; shift
  for spec in "$@"; do
    case "$spec" in tap=*) continue ;; esac
    s=${spec#stage=}; scheme=${s%%:*}; rest=${s#*:}; src="$scheme:${rest%%:*}"; dest=${rest#*:}
    [ "$rest" != "$s" ] && [ "$dest" != "$rest" ] || { echo "stage $s: use SRC:DEST"; return 1; }
    why=$(stage_forms "$src" "$dest") || { echo "stage $s: $why"; return 1; }
    case "$src $dest" in
      jail:*) echo "stage $s: jail: sources need a running microVM (vesperd stage)"; return 1 ;;
      *" store:"*) echo "stage $s: --stage writes into the jail; use vesperd stage for store:"; return 1 ;;
    esac
    case "$src" in
      store:*.mem|store:*.vmstate)
        name=${src#store:}; f="$STORE/$name"
        { [ -f "$f" ] && [ ! -L "$f" ]; } || { echo "stage $s: no store file $name"; return 1; }
        d=$lroot; rest=${dest#/}
        while [ "${rest#*/}" != "$rest" ]; do # parent directories; the jail is fresh, so root may create them
          d="$d/${rest%%/*}"; rest=${rest#*/}
          [ -L "$d" ] && { echo "stage $s: symlink in $dest"; return 1; }
          [ -d "$d" ] || { mkdir "$d" && chown "$JUID:$JGID" "$d"; } || { echo "stage $s: mkdir"; return 1; }
        done
        [ -e "$lroot$dest" ] && { echo "stage $s: $dest exists"; return 1; }
        chown 0:0 "$f" && chmod 0444 "$f" && ln "$f" "$lroot$dest" || { echo "stage $s: link failed"; return 1; } ;;
      *)
        store_lock
        out=$(copy_one "$src" "$dest" "$lroot"); rc=$?
        store_unlock
        [ "$rc" = 0 ] || { echo "stage $s: $out"; return 1; } ;;
    esac
  done
}

store_list() {
  data_dirs || { echo "ERR data disk not in use"; return 1; }
  for f in "$STORE"/*; do
    [ -f "$f" ] || continue
    echo "STORE ${f##*/} bytes=$(stat -c %s "$f") links=$(stat -c %h "$f")"
  done
  echo "FREE avail=$(avail_bytes) reserve=$(reserve_bytes)"
}
store_rm() {
  [ "$#" -eq 1 ] && valid_name "$1" || { echo "ERR usage: store-rm NAME"; return 2; }
  data_dirs || { echo "ERR data disk not in use"; return 1; }
  store_lock
  if [ -f "$STORE/$1" ] && [ ! -L "$STORE/$1" ]; then rm -f "$STORE/$1"; store_unlock; echo "REMOVED $1"
  else store_unlock; echo "ERR no store file $1"; return 1; fi
}
sweep() { # at boot no record survives (they are in tmpfs), so every jail goes; a running caller keeps live ones
  ensure_dirs; data_dirs || { echo "SWEPT jails=0 partial=0 (no data disk)"; return 0; }
  lock; n=0
  for jail in "$JAILS"/*; do
    [ -d "$jail" ] || continue
    rid=${jail##*/}
    [ -e "$LEASES/$rid" ] && continue
    rm -rf "$jail"; n=$((n + 1))
  done
  unlock
  store_lock; p=0
  for f in "$STORE"/.partial.*; do [ -e "$f" ] || continue; rm -f "$f"; p=$((p + 1)); done
  store_unlock
  echo "SWEPT jails=$n partial=$p"
}

# ---- LAUNCHAPI ---------------------------------------------------------------------------------------------
OWN=0; LID=""; SPID=""
lease_exit() {
  [ "$OWN" = 1 ] || return 0
  OWN=0
  unlock; lock
  # Tear down only while the record is still this shell's: the reaper may have taken it, and a new lease may
  # hold the id since.
  if read_record "$LID" && [ "$H_PID" = "$$" ] && [ "$H_START" = "$MY_START" ]; then
    teardown "$LID" > /dev/null
  fi
  unlock
  [ -n "$SPID" ] && wait "$SPID" 2>/dev/null
  return 0
}
launch_fail() { echo "ERR $*"; exit 1; }

launch() {
  LID=${1:-}; shift 2>/dev/null
  valid_id "$LID" || { echo "ERR bad id"; return 2; }
  ceiling=$DEFAULT_CEILING
  case "${1:-}" in stage=*|tap=*|'') ;; *) ceiling=$1; shift; digits "$ceiling" || { echo "ERR bad ceiling"; return 2; } ;; esac
  nstage=0; taps=""; ntap=0
  for spec in "$@"; do
    case "$spec" in
      stage=*) nstage=$((nstage + 1)) ;;
      tap=*)
        t=${spec#tap=}
        valid_tap "$t" || { echo "ERR bad tap name ${t:-(empty)}: 1 to 15 letters, digits, _ and -, not lo"; return 2; }
        case " $taps " in *" $t "*) echo "ERR tap $t given twice"; return 2 ;; esac
        taps="$taps $t"; ntap=$((ntap + 1)) ;;
      *) echo "ERR usage: LAUNCHAPI <id> [ceiling] [stage=SRC:DEST|tap=NAME]..."; return 2 ;;
    esac
  done
  [ "$nstage" -le "$MAX_STAGES" ] || { echo "ERR at most $MAX_STAGES stage= tokens"; return 2; }
  [ "$ntap" -le "$MAX_TAPS" ] || { echo "ERR at most $MAX_TAPS tap= tokens"; return 2; }
  max=$(awk '/^MemTotal:/{print $2 * 1024}' /proc/meminfo)
  { [ "$ceiling" -ge "$MIN_CEILING" ] && [ "$ceiling" -le "$max" ]; } || { echo "ERR ceiling out of range $MIN_CEILING..$max"; return 2; }
  [ -x "$JAILER" ] && [ -x "$FC" ] || { echo "ERR firecracker missing"; return 1; }
  ensure_dirs || { echo "ERR state directories"; return 1; }
  data_dirs || { echo "ERR data disk not in use"; return 1; }
  user_ok || { echo "ERR no $JUSER user"; return 1; }
  ver=$("$FC" --version 2>/dev/null | head -1 | sed -n 's/^Firecracker v\([0-9][0-9.]*\).*/\1/p')
  [ -n "$ver" ] || { echo "ERR firecracker version unknown"; return 1; }
  MY_START=$(start_of $$) || { echo "ERR own start time"; return 1; }
  lock
  reap_pass > /dev/null
  if [ -e "$LEASES/$LID" ] || [ -e "$JAILS/$LID" ] || [ -d "$CG/$LID" ]; then unlock; echo "ERR busy $LID"; return 1; fi
  prep=$("$MV" prepare 2>&1) || { unlock; echo "ERR prepare: $(printf '%s' "$prep" | head -1 | oneline)"; return 1; }
  # The record names this shell before the jail exists, so the reaper can always tell who owns it.
  ppid=$(awk '/^PPid:/{print $2}' "/proc/$$/status"); pstart=$(start_of "$ppid") || pstart=""
  [ "$(cat "/proc/$ppid/comm" 2>/dev/null)" = socat ] && [ -n "$pstart" ] && CONN="$ppid:$pstart" || CONN="-:-"
  write_record "$LID" "$$:$MY_START" "$CONN" "" || { unlock; echo "ERR record"; return 1; }
  OWN=1
  trap lease_exit EXIT
  trap 'exit 129' HUP
  trap 'exit 130' INT
  trap 'exit 143' TERM
  root="$JAILS/$LID/root"
  mkdir -p "$root" || launch_fail "jail"
  cp "$MVM/Image" "$root/Image" && cp "$MVM/initrd.gz" "$root/initrd.gz" && chmod 0644 "$root/Image" "$root/initrd.gz" \
    || launch_fail "stage kernel"
  chown "$JUID:$JGID" "$root"
  # Staging runs before Firecracker exists in this jail, outside the lock (the record keeps the reaper off it).
  if [ "$#" -gt 0 ]; then
    unlock
    why=$(launch_stage "$root" "$@") || launch_fail "$why"
    lock
  fi
  # shellcheck disable=SC2086
  why=$(netns_up "$LID" $taps) || launch_fail "network: $why"
  log="$LOGS/$LID.log"
  : > "$log"
  setsid "$JAILER" --id "$LID" --exec-file "$FC" --uid "$JUID" --gid "$JGID" --chroot-base-dir "$BASE" \
    --netns "$NETNS/$LID" --parent-cgroup vesperd --cgroup-version 2 --cgroup pids.max=256 --cgroup "memory.max=$ceiling" \
    -- --api-sock /run/firecracker.socket > "$log" 2>&1 < /dev/null 9>&- &
  SPID=$!
  unlock
  sock="$root/run/firecracker.socket"
  i=0
  while [ "$i" -lt $((LAUNCH_WAIT_S * 10)) ]; do
    [ -S "$sock" ] && break
    kill -0 "$SPID" 2>/dev/null || break
    sleep 0.1; i=$((i + 1))
  done
  [ -S "$sock" ] || launch_fail "start failed: $(tail -n 3 "$log" | oneline)"
  # The jailer writes firecracker.pid before it execs Firecracker; read it before any guest code runs.
  pf="$root/firecracker.pid"
  { [ -f "$pf" ] && [ ! -L "$pf" ]; } || launch_fail "no pid file"
  fpid=$(head -c 16 "$pf" | tr -d '\n')
  digits "$fpid" && is_fc_for "$fpid" "$LID" || launch_fail "pid file names no Firecracker for $LID"
  fstart=$(start_of "$fpid") || launch_fail "firecracker exited"
  lock
  write_record "$LID" "$$:$MY_START" "$CONN" "$fpid:$fstart" || { unlock; launch_fail "record"; }
  unlock
  echo "READY $LID pid=$fpid firecracker_version=$ver"
  # The lease: end of file from the client, or Firecracker's exit. head -c 1 under timeout returns "rc=0" with
  # no byte only at end of file; bytes the client sends are discarded.
  while proc_alive "$fpid" "$fstart"; do
    r=$( (timeout "$LEASE_POLL_S" head -c 1 2>/dev/null; echo "rc=$?") )
    [ "$r" = "rc=0" ] && break
  done
  exit 0
}

# ---- FCAPI -------------------------------------------------------------------------------------------------
connect() {
  [ "$#" -le 1 ] || { echo "ERR usage: FCAPI <id>"; return 2; }
  cid=${1:-}
  valid_id "$cid" || { echo "ERR bad id"; return 2; }
  read_record "$cid" || { echo "ERR no vesperd microVM $cid"; return 1; }
  { [ -n "$F_PID" ] && proc_alive "$F_PID" "$F_START"; } || { echo "ERR $cid not ready"; return 1; }
  [ -S "$JAILS/$cid/root/run/firecracker.socket" ] || { echo "ERR $cid has no API socket"; return 1; }
  echo OK
  # chroot-early: socat enters the jail root before it connects, so the path is short (sun_path holds 108
  # bytes) and a symlink planted in the jail cannot lead outside it.
  exec socat -t "$SOCAT_T" STDIO "UNIX-CONNECT:/run/firecracker.socket,chroot-early=$JAILS/$cid/root"
}

# ---- inspection and tests ----------------------------------------------------------------------------------
status() {
  sid=${1:-}; valid_id "$sid" || { echo "ERR bad id"; return 2; }
  if read_record "$sid" && proc_alive "$H_PID" "$H_START"; then
    if [ -n "$F_PID" ] && proc_alive "$F_PID" "$F_START"; then echo "RUNNING $sid pid=$F_PID holder=$H_PID"
    else echo "STARTING $sid holder=$H_PID"; fi
    return 0
  fi
  left=$(leftovers "$sid")
  if [ -z "$left" ]; then echo "ABSENT $sid"; else echo "DIRTY $sid $left"; fi
}

isolation() {
  sid=${1:-}; valid_id "$sid" || { echo "ERR bad id"; return 2; }
  read_record "$sid" && [ -n "$F_PID" ] && proc_alive "$F_PID" "$F_START" || { echo "ERR $sid not running"; return 1; }
  pid=$F_PID
  uid=$(euid_of "$pid")
  cg=$(sed -n 's/^0::\(.*\)$/\1/p' "/proc/$pid/cgroup")
  sec=$(awk '/^Seccomp:/{print $2}' "/proc/$pid/status")
  mem=$(cat "$CG/$sid/memory.max" 2>/dev/null || echo none)
  uid_ok=false; [ "$uid" = "$JUID" ] && uid_ok=true
  chroot_ok=false
  if [ -e "/proc/$pid/root/Image" ] && [ ! -e "/proc/$pid/root/etc/alpine-release" ] \
     && [ "$(readlink "/proc/$pid/ns/mnt")" != "$(readlink /proc/1/ns/mnt)" ]; then chroot_ok=true; fi
  cg_ok=false; [ "$cg" = "/vesperd/$sid" ] && cg_ok=true
  sec_ok=false; [ "$sec" = 2 ] && sec_ok=true
  net_ok=false
  [ "$(readlink "/proc/$pid/ns/net")" != "$(readlink /proc/1/ns/net)" ] && netns_mounted "$sid" && net_ok=true
  printf '{"id":"%s","pid":%s,"holder":%s,"uid":%s,"jail":"%s","cgroup":"%s","memory_max":"%s","seccomp_mode":%s,"uid_ok":%s,"chroot_ok":%s,"cgroup_ok":%s,"seccomp_ok":%s,"netns_ok":%s}\n' \
    "$sid" "$pid" "$H_PID" "${uid:-0}" "$JAILS/$sid/root" "$cg" "$mem" "${sec:-0}" "$uid_ok" "$chroot_ok" "$cg_ok" "$sec_ok" "$net_ok"
}

list() {
  for rec in "$LEASES"/*; do
    [ -f "$rec" ] || continue
    read_record "${rec##*/}"
    echo "LEASE ${rec##*/} holder=$H_PID:$H_START conn=${C_PID:--}:${C_START:--} fc=${F_PID:--}:${F_START:--}"
  done
  for jail in "$JAILS"/*; do [ -d "$jail" ] && echo "JAIL ${jail##*/}"; done
  return 0
}

vlog() { sid=${1:-}; valid_id "$sid" || { echo "ERR bad id"; return 2; }; n=${2:-20}; digits "$n" || n=20
  [ -f "$LOGS/$sid.log" ] && tail -n "$n" "$LOGS/$sid.log" || { echo "ERR no log for $sid"; return 1; }; }

kill_holder() {
  sid=${1:-}; valid_id "$sid" || { echo "ERR bad id"; return 2; }
  read_record "$sid" && proc_alive "$H_PID" "$H_START" || { echo "ERR $sid has no live holder"; return 1; }
  kill -KILL "$H_PID" && echo "KILLED-HOLDER $sid pid=$H_PID"
}

kill_fc() {
  sid=${1:-}; valid_id "$sid" || { echo "ERR bad id"; return 2; }
  read_record "$sid" && [ -n "$F_PID" ] && proc_alive "$F_PID" "$F_START" || { echo "ERR $sid not running"; return 1; }
  kill -KILL "$F_PID" && echo "KILLED-FC $sid pid=$F_PID"
}

test_forge_start() {
  sid=${1:-}; valid_id "$sid" || { echo "ERR bad id"; return 2; }
  lock
  read_record "$sid" || { unlock; echo "ERR no record for $sid"; return 1; }
  # Start time 1 (one clock tick after boot) cannot belong to a lease shell; the live pid now looks reused.
  write_record "$sid" "$H_PID:1" "$C_PID:$C_START" "$F_PID:$F_START"
  unlock
  echo "FORGED $sid holder=$H_PID start=1 was=$H_START"
}

test_orphan() {
  sid=${1:-}; valid_id "$sid" || { echo "ERR bad id"; return 2; }
  ensure_dirs; data_dirs || { echo "ERR data disk not in use"; return 1; }; lock
  if [ -e "$LEASES/$sid" ] || [ -e "$JAILS/$sid" ]; then unlock; echo "ERR busy $sid"; return 1; fi
  mkdir -p "$JAILS/$sid/root"
  unlock
  echo "ORPHAN $sid"
}

test_age() {
  sid=${1:-}; s=${2:-}; valid_id "$sid" && digits "$s" || { echo "ERR usage: test-age ID SECONDS"; return 2; }
  [ -d "$JAILS/$sid" ] || { echo "ERR no jail for $sid"; return 1; }
  touch -d "@$(( $(now_s) - s ))" "$JAILS/$sid" && echo "AGED $sid seconds=$s"
}

files() { # FILE lines for ID's jail, listed as uid 20000 (root does not walk a jail Firecracker has run in)
  sid=${1:-}; valid_id "$sid" || { echo "ERR bad id"; return 2; }
  [ -d "$JAILS/$sid/root" ] || { echo "ERR no jail for $sid"; return 1; }
  as_jail jail-files "$JAILS/$sid/root"
}
jail_files() {
  [ "$(id -u)" = "$JUID" ] || { echo "ERR jail-side subcommands run as uid $JUID only"; exit 2; }
  case "${1:-}" in "$JAILS"/*/root) ;; *) echo "ERR bad jail root"; exit 2 ;; esac
  find "$1" -xdev -type f 2>/dev/null | while IFS= read -r f; do
    echo "FILE ${f#"$1"} $(stat -c 'uid=%u mode=%a links=%h bytes=%s' "$f")"
  done
}

net() { # ID's network namespace: one LINK line per interface, then whether it differs from the System VM's
  sid=${1:-}; valid_id "$sid" || { echo "ERR bad id"; return 2; }
  netns_mounted "$sid" || { echo "ERR no network namespace for $sid"; return 1; }
  f="$NETNS/$sid"
  # busybox ip -o link: "N: NAME: <FLAGS> ..."; the tun owner is read from the namespace's own sysfs view.
  nsenter --net="$f" ip -o link | while IFS= read -r l; do
    name=${l#*: }; name=${name%%:*}; name=${name%%@*}
    case "$l" in *"<"*UP*">"*) st=UP ;; *) st=DOWN ;; esac
    # shellcheck disable=SC2016
    own=$(nsenter --net="$f" unshare -m sh -c 'mount --make-rprivate / && mount -t sysfs sysfs /sys 2>/dev/null && cat "/sys/class/net/$1/owner" 2>/dev/null' sh "$name")
    echo "LINK $name state=$st owner=${own:--}"
  done
  sep=false; [ "$(nsenter --net="$f" readlink /proc/self/ns/net)" != "$(readlink /proc/1/ns/net)" ] && sep=true
  echo "NETNS $sid separate=$sep"
}

memory() { # ID's cgroup: memory.current, memory.peak, memory.max and memory.stat's anon and file, in bytes
  sid=${1:-}; valid_id "$sid" || { echo "ERR bad id"; return 2; }
  c="$CG/$sid"; [ -d "$c" ] || { echo "ERR no cgroup for $sid"; return 1; }
  echo "MEMORY $sid current=$(cat "$c/memory.current") peak=$(cat "$c/memory.peak" 2>/dev/null || echo -) max=$(cat "$c/memory.max") $(awk '$1=="anon"||$1=="file"||$1=="shmem"{printf "%s=%s ", $1, $2}' "$c/memory.stat")"
}

test_plant() {
  sid=${1:-}; valid_id "$sid" || { echo "ERR bad id"; return 2; }
  r="$JAILS/$sid/root"; [ -d "$r" ] || { echo "ERR no jail for $sid"; return 1; }
  # What a compromised Firecracker could leave (two symlinks), and what a lost race could point an open at (a
  # root-only file); a test hook, so root writes into the jail here.
  ln -sfn /etc/shadow "$r/planted-link" && ln -sfn "$STORE" "$r/planted-dir" \
    && (umask 077; echo secret > "$r/planted-root") && chown 0:0 "$r/planted-root" && echo "PLANTED $sid"
}
test_reserve() {
  case "${1:-}" in
    clear) rm -f "$RESERVE_OVERRIDE"; echo "RESERVE bytes=$(reserve_bytes) (default)" ;;
    *) digits "${1:-}" || { echo "ERR usage: test-reserve BYTES|clear"; return 2; }
       ensure_dirs; echo "$1" > "$RESERVE_OVERRIDE"; echo "RESERVE bytes=$1 avail=$(avail_bytes)" ;;
  esac
}

test_container_vsock() {
  img=$(/usr/local/bin/vesper-rootfs import-trivial 2>&1 | sed -n 's/^IMPORTED //p')
  [ -n "$img" ] || { echo "ERR trivial image import failed"; return 1; }
  # The trivial image has busybox and musl only; lend it the System VM's socat and its libraries read-only.
  mounts="-v /usr/bin/socat:/usr/bin/socat:ro"
  for f in $(ldd /usr/bin/socat 2>/dev/null | awk '{for(i=1;i<=NF;i++) if ($i ~ /^\//) print $i}' | sort -u); do
    mounts="$mounts -v $f:$f:ro"
  done
  rc=0
  for mode in default unconfined; do
    opt=""; [ "$mode" = unconfined ] && opt="--security-opt seccomp=unconfined"
    for cid in 1 3; do
      # shellcheck disable=SC2086
      full=$(docker run --rm --network none $opt $mounts "$img" /usr/bin/socat -T 2 /dev/null "VSOCK-CONNECT:$cid:1024" 2>&1)
      drc=$?
      out=$(printf '%s\n' "$full" | grep 'socat\[' | grep ' E ' | tail -1 | oneline)
      # denied: socket(AF_VSOCK) itself failed with EPERM (seccomp); allowed: the socket opened and the connect
      # failed; connected: the connect succeeded; error: the container did not run.
      case "$out" in
        *"socket("*"Operation not permitted"*) verdict=denied ;;
        ?*) verdict=allowed ;;
        *) if [ "$drc" = 0 ]; then verdict=connected; else verdict=error; out=$(printf '%s' "$full" | tail -1 | oneline); fi ;;
      esac
      echo "VSOCK $mode=$verdict cid=$cid detail=${out:-none}"
      [ "$mode" = default ] && [ "$verdict" != denied ] && rc=1
    done
  done
  return "$rc"
}

reap_loop() {
  interval=${1:-10}; digits "$interval" || interval=10
  ensure_dirs
  while :; do
    out=$(lock; reap_pass; unlock)
    printf '%s\n' "$out" | grep '^REAPED' | while IFS= read -r l; do logger -t vesperd-reaper "$l" 2>/dev/null; done
    sleep "$interval"
  done
}

cmd=${1:-}; shift 2>/dev/null
case "$cmd" in
  launch) launch "$@" ;;
  connect) connect "$@" ;;
  reap) ensure_dirs; lock; reap_pass; unlock ;;
  reap-loop) reap_loop "$@" ;;
  status) status "$@" ;;
  isolation) isolation "$@" ;;
  list) list ;;
  log) vlog "$@" ;;
  kill-holder) kill_holder "$@" ;;
  kill-fc) kill_fc "$@" ;;
  test-forge-start) test_forge_start "$@" ;;
  test-orphan) test_orphan "$@" ;;
  test-age) test_age "$@" ;;
  test-container-vsock) test_container_vsock ;;
  stage) stage "$@" ;;
  store-list) store_list ;;
  store-rm) store_rm "$@" ;;
  sweep) sweep ;;
  setup-user) setup_user ;;
  files) files "$@" ;;
  memory) memory "$@" ;;
  net) net "$@" ;;
  test-plant) test_plant "$@" ;;
  test-reserve) test_reserve "$@" ;;
  jail-stat) jail_stat "$@" ;;
  jail-read) jail_read "$@" ;;
  jail-write) jail_write "$@" ;;
  jail-files) jail_files "$@" ;;
  *) echo "ERR usage: vesper-vesperd launch|connect|stage|store-list|store-rm|sweep|setup-user|reap|reap-loop|status|isolation|files|memory|net|list|log|kill-holder|kill-fc|test-*"; exit 2 ;;
esac
