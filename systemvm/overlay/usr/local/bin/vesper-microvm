#!/bin/sh
# Vesper microVM manager (GH #18): stock Firecracker under the jailer inside the System VM.
# usage: vesper-microvm prepare
#        vesper-microvm launch ID [--exit] [--rootfs PATH] [--cmd BASE64] [--vsock] [--share-net]
#                                             boot a microVM (kernel + busybox initramfs); --exit powers off after the
#                                             marker; --rootfs attaches an ext4 image as /dev/vda, mounts it, prints
#                                             VESPER-ROOTFS-OK <source digest> from its provenance and switches root;
#                                             --cmd runs the base64-encoded shell command inside the rootfs, prints
#                                             VESPER-WORKLOAD-START, its output, VESPER-WORKLOAD-EXIT <code>, then powers off;
#                                             --vsock attaches a vsock device (guest CID 3) whose host side is the Unix
#                                             socket <jail root>/v.sock (CONNECT <port> preface) and loads the guest
#                                             vsock modules at boot (vesper_vsock=1); --share-net gives the microVM
#                                             its own network namespace (jailer --netns) holding lo and one tap,
#                                             share0 at 169.254.77.1/30, with the guest at 169.254.77.2 and no route
#                                             out (ADR 0009): the network a share server will listen on
#                                             --unfs-mount DIR --unfs-src REL:ro|rw [...] [--unfs-squash] (needs
#                                             --share-net; GH #160 M3): one sandboxed unfsd (vesper-unfs run) in that
#                                             namespace, exporting each source as /s/0, /s/1, ... to the guest only,
#                                             under supervise-daemon in its own memory-capped cgroup, admitted with
#                                             the microVM; started before the jailer
#        vesper-microvm unfs-stop ID         stop ID's share server (the shim, when the task stops); UNFS ID stopped
#        vesper-microvm unfs ID              UNFS ID state=running|stopped pid=N listen=yes|no mem_max= mem_peak=
#                                             oom_kills=, or UNFS ID absent
#        vesper-microvm sharenet ID          SHARENET ID links=... addr=... owner=... routes=N input=... forward=...
#                                             rules=N fc_in_ns=yes|no, or ABSENT ID
#        vesper-microvm reap                 remove what is left of any --share-net microVM whose launch, shim and
#                                             Firecracker are gone and whose record is older than 30 s; REAPED lines,
#                                             then REAP <n> (the vesper-microvm-reaper service runs it every 10 s)
#        vesper-microvm setup-user           create the uid 10000 user that owns the share taps; USER <name> 10000
#        vesper-microvm status ID            RUNNING ID pid=N | EXITED ID | ABSENT ID
#        vesper-microvm isolation ID         JSON with uid, chroot, cgroup and seccomp checks
#        vesper-microvm stop ID              SIGTERM, wait up to 10 s
#        vesper-microvm crash ID             SIGKILL (abnormal termination)
#        vesper-microvm cleanup ID [--logs]  kill, remove chroot, cgroup, share namespace and record, release the memory budget
#                                             (and with --logs the console logs); CLEAN ID or DIRTY ID <what>
#        vesper-microvm log ID [N]           last N lines of the serial console log (at most 1 MiB, plus the previous
#                                             1 MiB file; vesper-boundlog, TD-055)
set -u
# ADR 0010: containers run as an unprivileged uid of the System VM, and dockerd can bind any single file into
# one whatever its parent directory allows. So nothing this tool writes is readable by other uids unless a line
# says why it must be.
umask 077
FC_DIR=/var/lib/vesper/firecracker
MVM=/var/lib/vesper/microvm
JAIL=/srv/jailer
JUID=10000
JGID=10000
MARKER="VESPER-MICROVM-OK"

# The jailer execs the binary by its chroot-relative name, so match on "firecracker --id <ID> ". The uid filter
# keeps the shim's lookups off vesperd microVMs, which run as uid 20000 and may use the same id (ADR 0007).
# A match must also sit in the microVM's own cgroup (the jailer puts it there before it execs): a container process
# run as uid 10000 with a look-alike command line is in Docker's cgroup, so it can neither pass for a microVM nor
# hold the reaper off one.
fcpid() {
  for fp in $(pgrep -u "$JUID" -f "firecracker --id $1 " 2>/dev/null); do
    grep -q "^0::.*/firecracker/$1\$" "/proc/$fp/cgroup" 2>/dev/null && { echo "$fp"; return 0; }
  done
}
now_ms() { awk '{printf "%d", $1 * 1000}' /proc/uptime; }
logfile() { echo "/var/log/vesper-microvm-$1.log"; }
# memory.max of each microVM, counted in the shared budget (TD-056): the 256 MiB guest plus 96 MiB for Firecracker,
# page tables, I/O buffers and reclaimable page cache. A guest that used all its memory peaked at 259 MiB
# (run/W4/shim-memory-peak.txt). Launch also books the jail's tmpfs copies (kernel and initramfs, about 44 MB, and the
# rootfs), so a 2 GiB System VM's budget holds four; vesperd's 640 MiB default is for its larger, configurable guests.
CEILING=369098752
LOG_MAX=1048576                    # console log bound: the log plus one previous file (TD-055)

# ---- share network (ADR 0009) -------------------------------------------------------------------------------
# A microVM with host shares gets a network namespace of its own, bound at $NETNS/ID. It holds lo and one tap and
# has no veth and no route out, so nothing but that microVM can reach an address in it, and every namespace can use
# the same address pair. These directories are the shim's: vesperd keeps its namespaces under /run/vesper/vesperd
# and its reaper never looks here, because the two backends may use the same id.
STATE=/run/vesper/microvm
NETNS=$STATE/netns
REC=$STATE/records                 # records/<id>: "pid=<launch pid> start=<its start time> t=<epoch>"
LOCK=$STATE/lock                   # serialises record and namespace creation with the reaper
JUSER=vesper-shim-jail             # the uid 10000 user: the tap owner is given by name (netns.sh)
SHARE_TAP=share0
SHARE_SRV=169.254.77.1
SHARE_GUEST=169.254.77.2
SHARE_PREFIX=30
SHARE_PORTS="2049 2050"
# Vesper's patched unfs3 0.10.0 (third_party/unfs3, D-044): an UNCHECKED CREATE keeps an existing file's data
# (TD-068), malformed handles are refused rather than asserted on (TD-065), times are kept to the nanosecond (TD-066).
# Alpine's /usr/sbin/unfsd stays installed with its library closure and is not run.
UNFSD=/usr/libexec/vesper/unfsd            # unfsd's NFS and mount ports (TCP)
REAP_GRACE=30                      # seconds a record is left alone, whatever runs
# ---- share server (ADR 0009, GH #160 M3) ----------------------------------------------------------------------
UNFS=$STATE/unfs                   # unfs/<id>.pid: supervise-daemon's pid file for the server of <id>
UNFS_CG=/sys/fs/cgroup/vesper-unfs # one memory-capped cgroup per server, beside the microVM's
# Its memory.max, admitted with the microVM's ceiling. M3 measured an 8 MB peak through the probe battery and a
# restart (run/GH-160/m3/unfs-report.json); page cache charged to the cgroup is reclaimed at the cap.
UNFS_MEM=33554432
UNFS_PIDS=32
# At most one CPU per server (council SEC-5, TD-069): a guest can keep its own server busy, but not starve the
# System VM's other work. Set when the kernel offers the cpu controller; `unfs ID` shows it.
UNFS_CPU="100000 100000"
UNFS_ROOT=/run/vesper/unfs-root    # where each server mounts its own tmpfs root, in its own mount namespace
NL='
'
LIBDIR=$(dirname "$0")/../lib/vesper; [ -r "$LIBDIR/netns.sh" ] || LIBDIR=/usr/local/lib/vesper
# shellcheck source=/dev/null
. "$LIBDIR/netns.sh"
LAUNCHING=""                       # the id whose launch must be undone if this script is interrupted

digits() { case "${1:-}" in ''|*[!0-9]*) return 1 ;; esac; }
valid_id() { case "${1:-}" in ''|*[!A-Za-z0-9-]*) return 1 ;; esac; [ "${#1}" -le 64 ]; }
# One lock serialises launch (from the already-running check to the namespace), cleanup and the reaper, so none of
# them acts on a half-made or half-removed microVM of the same id. The boot itself runs outside it. LOCKED lets
# cleanup be called by a function that already holds the lock (reap, launch's failure paths, an interrupted launch).
LOCKED=0
lock() { mkdir -p "$STATE" && exec 9>"$LOCK" && flock 9 && LOCKED=1; }
unlock() { flock -u 9 2>/dev/null; exec 9>&-; LOCKED=0; }
proc_stat() { # PID -> "<state> <starttime>" from /proc/PID/stat (fields 3 and 22); fails when absent
  digits "${1:-}" || return 1
  ps_s=$(cat "/proc/$1/stat" 2>/dev/null) || return 1
  [ -n "$ps_s" ] || return 1
  ps_s=${ps_s##*) }
  # shellcheck disable=SC2086
  set -- $ps_s
  echo "$1 ${20}"
}
proc_alive() { # PID START -> 0 when PID runs and started at START (a reused pid or a zombie is not alive)
  pa=$(proc_stat "${1:-}") || return 1
  [ "${pa% *}" != Z ] && [ "${pa#* }" = "${2:-}" ]
}
# The shim serving a task; a stopped task's shim may still need the jail. A process counts only when it runs the
# System VM's own shim binary (same device and inode as /usr/bin/containerd-shim-vesper-v2, so a container's copy or
# a look-alike command line does not) and its arguments hold "-id" followed by exactly the task id.
SHIM_BIN=/usr/bin/containerd-shim-vesper-v2
shim_for() {
  sf_want=$(stat -L -c %d:%i "$SHIM_BIN" 2>/dev/null) || return 0
  for sf in $(pgrep -f "containerd-shim-vesper-v2 " 2>/dev/null); do
    [ "$(stat -L -c %d:%i "/proc/$sf/exe" 2>/dev/null)" = "$sf_want" ] || continue
    tr '\0' '\n' < "/proc/$sf/cmdline" 2>/dev/null | grep -x -A1 -e '-id' | tail -n 1 | grep -qx -e "$1" && { echo "$sf"; return 0; }
  done
}
setup_user() {
  grep -q "^$JUSER:" /etc/group || addgroup -S -g "$JGID" "$JUSER" || { echo "ERR addgroup $JUSER"; return 1; }
  grep -q "^$JUSER:" /etc/passwd || adduser -S -D -H -u "$JUID" -G "$JUSER" -s /sbin/nologin -h / -g "vesper shim jail" "$JUSER" \
    || { echo "ERR adduser $JUSER"; return 1; }
  grep -q "^$JUSER:x:$JUID:$JGID:" /etc/passwd || { echo "ERR $JUSER exists with another uid or gid"; return 1; }
  echo "USER $JUSER $JUID"
}
sharenet_up() { # ID (lock held, record written) -> a reason on failure
  sn_f="$NETNS/$1"
  sn_why=$(vnetns_up "$NETNS" "$JUSER" "$1" "$SHARE_TAP") || { echo "$sn_why"; return 1; }
  nsenter --net="$sn_f" ip addr add "$SHARE_SRV/$SHARE_PREFIX" dev "$SHARE_TAP" 2>/dev/null || { echo "address"; return 1; }
  # Defence in depth: only the tap reaches the server's ports, and nothing is forwarded. Isolation does not rest
  # on this rule (nothing else is in the namespace); it keeps the server private if an uplink joins later (TD-032).
  nsenter --net="$sn_f" iptables -w -P INPUT DROP && nsenter --net="$sn_f" iptables -w -P FORWARD DROP || { echo "policy"; return 1; }
  for sn_p in $SHARE_PORTS; do
    nsenter --net="$sn_f" iptables -w -A INPUT -i "$SHARE_TAP" -d "$SHARE_SRV" -p tcp --dport "$sn_p" -j ACCEPT || { echo "rule $sn_p"; return 1; }
  done
}
sharenet() { # ID: what the namespace holds, for the suites and for diagnosis
  id=${1:-}; valid_id "$id" || { echo "ERR bad id"; return 2; }
  f="$NETNS/$id"
  vnetns_mounted "$NETNS" "$id" || { echo "ABSENT $id"; return 1; }
  # sysfs shows the network namespace of whoever mounted it, so mount a fresh one inside the namespace.
  # shellcheck disable=SC2016
  sys=$(nsenter --net="$f" unshare -m sh -c 'd=$(mktemp -d) && mount -t sysfs sysfs "$d" || exit 1
    echo "links=$(ls "$d/class/net" | sort | tr "\n" "," | sed "s/,\$//") owner=$(cat "$d/class/net/$1/owner" 2>/dev/null)"
    umount "$d"; rmdir "$d"' sh "$SHARE_TAP" 2>/dev/null)
  links=$(printf '%s' "$sys" | sed -n 's/^links=\([^ ]*\) .*/\1/p'); owner=${sys##*owner=}
  addr=$(nsenter --net="$f" ip -o -4 addr show dev "$SHARE_TAP" 2>/dev/null | awk '{print $4}' | tr '\n' ',' | sed 's/,$//')
  routes=$(nsenter --net="$f" ip route 2>/dev/null | grep -c .)
  default=no; nsenter --net="$f" ip route 2>/dev/null | grep -q '^default' && default=yes
  rules=$(nsenter --net="$f" iptables -w -S 2>/dev/null)
  input=$(printf '%s\n' "$rules" | sed -n 's/^-P INPUT //p'); forward=$(printf '%s\n' "$rules" | sed -n 's/^-P FORWARD //p')
  nrules=$(printf '%s\n' "$rules" | grep -c '^-A ')
  in_ns=no; pid=$(fcpid "$id")
  ns_a=""; [ -n "$pid" ] && ns_a=$(stat -L -c %i "/proc/$pid/ns/net" 2>/dev/null); ns_b=$(stat -L -c %i "$f" 2>/dev/null)
  [ -n "$ns_a" ] && [ "$ns_a" = "$ns_b" ] && in_ns=yes
  echo "SHARENET $id links=${links:-none} addr=${addr:-none} owner=${owner:-none} routes=$routes default=$default input=${input:-?} forward=${forward:-?} rules=$nrules fc_in_ns=$in_ns"
}
launch_abort() { # INT, TERM or HUP during a launch: undo it; the reaper covers a SIGKILL of a --share-net launch
  [ -n "$LAUNCHING" ] && cleanup "$LAUNCHING" > /dev/null 2>&1
  [ "$LOCKED" = 1 ] && unlock
  exit 1
}
reap() { # one pass under the lock launch takes
  lock || { echo "ERR lock"; return 1; }
  reaped=0; now=$(date +%s)
  for r in "$REC"/*; do
    [ -f "$r" ] || continue
    rid=${r##*/}
    valid_id "$rid" || continue
    rp=$(sed -n 's/^pid=\([0-9]*\) .*/\1/p' "$r"); rs=$(sed -n 's/.* start=\([0-9]*\) .*/\1/p' "$r"); rt=$(sed -n 's/.* t=\([0-9]*\)$/\1/p' "$r")
    [ -n "$(fcpid "$rid")" ] && continue
    proc_alive "$rp" "$rs" && continue
    [ -n "$(shim_for "$rid")" ] && continue
    digits "$rt" && [ $((now - rt)) -lt "$REAP_GRACE" ] && [ $((now - rt)) -ge 0 ] && continue
    out=$(cleanup "$rid" | head -1)
    # Only a clean removal counts; anything else is tried again on the next pass and shows in the log meanwhile.
    if [ "$out" = "CLEAN $rid" ]; then echo "REAPED $rid $out"; reaped=$((reaped + 1)); else echo "KEPT $rid $out"; fi
  done
  # launch writes the record first, so a namespace without one is not a launch in progress.
  for f in "$NETNS"/*; do
    [ -e "$f" ] || continue
    nid=${f##*/}
    valid_id "$nid" || continue
    [ -f "$REC/$nid" ] && continue
    [ -n "$(fcpid "$nid")" ] && continue
    vnetns_down "$NETNS" "$nid"
    if [ -e "$f" ]; then echo "KEPT $nid namespace without a record, still bound"
    else echo "REAPED $nid namespace without a record"; reaped=$((reaped + 1)); fi
  done
  unlock
  echo "REAP $reaped"
}
# ---- test hooks for the share network (make systemvm-sharenet-suite) ----
test_share_listen() { # ID PORT | ID stop: a TCP listener on the server address inside ID's namespace
  id=${1:-}; valid_id "$id" || { echo "ERR bad id"; return 2; }
  pf="$STATE/test-listen.$id"
  if [ "${2:-}" = stop ]; then
    # shellcheck disable=SC2046
    [ -f "$pf" ] && kill $(cat "$pf") 2>/dev/null; rm -f "$pf"; echo "LISTEN $id stopped"; return 0
  fi
  digits "${2:-}" && [ "$2" -ge 1024 ] && [ "$2" -le 65535 ] || { echo "ERR usage: test-share-listen ID PORT|stop"; return 2; }
  vnetns_mounted "$NETNS" "$id" || { echo "ERR $id has no share namespace"; return 1; }
  setsid nsenter --net="$NETNS/$id" socat "TCP-LISTEN:$2,bind=$SHARE_SRV,fork,reuseaddr" SYSTEM:'echo vesper-share' < /dev/null > /dev/null 2>&1 &
  echo "$! $(cat "$pf" 2>/dev/null)" > "$pf"
  sleep 0.3
  # Say whether the listener is still running: a suite that finds the address closed must not be looking at a
  # listener that never started. (The namespace accepts connections from the tap only, so only the guest can show
  # that the listener answers; the suites read the guest's own probe for that.)
  if kill -0 "$!" 2>/dev/null; then r=yes; else r=no; fi
  echo "LISTEN $id tcp=$SHARE_SRV:$2 alive=$r"
}
test_share_reach() { # PORT [OTHER_ID]: can anything outside a namespace reach the server address? REACH <from> open|closed
  digits "${1:-}" || { echo "ERR usage: test-share-reach PORT [OTHER_ID]"; return 2; }
  tr_try() { if "$@" < /dev/null > /dev/null 2>&1; then echo open; else echo closed; fi; }
  echo "REACH root $(tr_try nc -z -w 2 "$SHARE_SRV" "$1")"
  if [ -n "${2:-}" ]; then
    valid_id "$2" && vnetns_mounted "$NETNS" "$2" || { echo "ERR $2 has no share namespace"; return 1; }
    echo "REACH namespace:$2 $(tr_try nsenter --net="$NETNS/$2" nc -z -w 2 "$SHARE_SRV" "$1")"
  fi
  img=$(/usr/local/bin/vesper-rootfs import-trivial 2>&1 | sed -n 's/^IMPORTED //p')
  [ -n "$img" ] || { echo "ERR trivial image import failed"; return 1; }
  # Every capability Docker grants a remapped container (ADR 0010), and no seccomp filter: it still has no route
  # into another network namespace.
  out=$(docker run --rm --cap-add ALL --security-opt seccomp=unconfined --network bridge "$img" /bin/busybox nc -z -w 2 "$SHARE_SRV" "$1" 2>&1); drc=$?
  case "$drc" in 0) r=open ;; 1) r=closed ;; *) echo "ERR container-bridge: docker rc $drc: $(printf '%s' "$out" | vnetns_oneline)"; return 1 ;; esac
  echo "REACH container-bridge $r"
  # The host network: dockerd refuses it for a remapped container, and that refusal is the row. In an unmapped
  # boot (the upstream suite's) the container runs, and the row says what it reached.
  out=$(docker run --rm --network host "$img" /bin/busybox nc -z -w 2 "$SHARE_SRV" "$1" 2>&1); drc=$?
  case "$drc:$out" in
    0:*) r=open ;;
    1:*) r=closed ;;
    125:*"host's network namespace when user namespaces are enabled"*) r=refused ;;
    *) echo "ERR container-host: docker rc $drc: $(printf '%s' "$out" | vnetns_oneline)"; return 1 ;;
  esac
  echo "REACH container-host $r"
}
test_age() { # ID SECONDS: make ID's record that much older (the reaper's grace period)
  id=${1:-}; valid_id "$id" && digits "${2:-}" && [ -f "$REC/$id" ] || { echo "ERR usage: test-age ID SECONDS (with a record)"; return 2; }
  t=$(sed -n 's/.* t=\([0-9]*\)$/\1/p' "$REC/$id")
  sed -i "s/ t=[0-9]*\$/ t=$((t - $2))/" "$REC/$id" && echo "AGED $id $(cat "$REC/$id")"
}
test_drop_record() { # ID: remove ID's record and keep its namespace (a state launch cannot leave)
  id=${1:-}; valid_id "$id" && [ -f "$REC/$id" ] || { echo "ERR usage: test-drop-record ID (with a record)"; return 2; }
  rm -f "$REC/$id" && echo "DROPPED $id namespace=$(vnetns_mounted "$NETNS" "$id" && echo bound || echo missing)"
}
test_impostor() { # ID | stop: a process that is not the shim but whose command line names it and ID
  pf="$STATE/test-impostor"
  if [ "${1:-}" = stop ]; then
    # shellcheck disable=SC2046
    [ -f "$pf" ] && kill $(cat "$pf") 2>/dev/null; rm -f "$pf"; echo "IMPOSTOR stopped"; return 0
  fi
  valid_id "${1:-}" || { echo "ERR usage: test-impostor ID|stop"; return 2; }
  mkdir -p "$STATE"
  setsid sh -c 'sleep 300; :' "containerd-shim-vesper-v2 -namespace vesper -id $1 -address x" < /dev/null > /dev/null 2>&1 &
  echo "$!" > "$pf"
  sleep 0.2
  echo "IMPOSTOR $1 pid=$(cat "$pf") pgrep=$(pgrep -f "containerd-shim-vesper-v2 .*-id $1" | wc -l | tr -d ' ') shim_for=$(shim_for "$1")"
}
test_abort_launch() { # ID: a --share-net launch killed (SIGKILL) just after its namespace exists; what the reaper must clear
  id=${1:-}; valid_id "$id" || { echo "ERR bad id"; return 2; }
  setup_user > /dev/null && mkdir -p "$REC" && lock || { echo "ERR setup"; return 1; }
  sh -c 'echo $$' > "$STATE/.abort.pid"; dead=$(cat "$STATE/.abort.pid"); rm -f "$STATE/.abort.pid"
  echo "pid=$dead start=1 t=$(date +%s)" > "$REC/$id"
  why=$(sharenet_up "$id"); rc=$?
  unlock
  [ "$rc" = 0 ] || { echo "ERR $why"; return 1; }
  echo "ABORTED $id record=$(cat "$REC/$id") namespace=$(vnetns_mounted "$NETNS" "$id" && echo bound || echo missing)"
}
reap_loop() { # INTERVAL: what the vesper-microvm-reaper service runs
  digits "${1:-}" && [ "$1" -ge 1 ] || { echo "ERR usage: reap-loop SECONDS"; return 2; }
  # Everything but the count goes to syslog: what was reaped, what was kept and why, and any error of the pass.
  while :; do reap 2>&1 | grep -v '^REAP [0-9]*$' | logger -t vesper-microvm-reaper; sleep "$1"; done
}

prepare() {
  # The kernel and initramfs every microVM boots come from $MVM. It must be root's own directory: dockerd would
  # create a missing one for a container, which could then plant them (GH #194).
  mkdir -p "$MVM" && [ ! -L "$MVM" ] && [ "$(stat -c %u "$MVM")" = 0 ] || { echo "ERR $MVM is not a root-owned directory"; return 1; }
  umask 022 # the initramfs tree keeps ordinary modes: they become the guest's (runs in a subshell or as the last act)
  mkdir -p "$MVM"
  if [ ! -f "$MVM/Image" ]; then
    # The ISO kernel is an EFI zboot PE: gzip payload at the offset/size stored at bytes 8..16.
    k=/media/vda/boot/vmlinuz-virt
    [ -f "$k" ] || { echo "ERR kernel $k missing"; return 1; }
    off=$(od -A n -t u4 -j 8 -N 4 "$k" | tr -d ' ')
    size=$(od -A n -t u4 -j 12 -N 4 "$k" | tr -d ' ')
    tail -c "+$((off + 1))" "$k" | head -c "$size" | gunzip -c > "$MVM/Image.tmp" || { echo "ERR kernel unpack failed"; return 1; }
    mv "$MVM/Image.tmp" "$MVM/Image"
  fi
  # Runtime bytes inherit the package-lock and ISO digests verified by build-overlay.sh.
  libs=$(for bin in /usr/bin/runc /usr/bin/socat; do ldd "$bin" || exit 1; done 2>&1) || { echo "ERR runtime library closure: $libs"; return 1; }
  runtime_files="/sbin/tini-static /usr/bin/vesper-console /bin/busybox /lib/ld-musl-aarch64.so.1 /usr/bin/runc /usr/bin/socat $(printf '%s\n' "$libs" | awk '{for(i=1;i<=NF;i++) if ($i ~ /^\//) print $i}' | sort -u)"
  stamp=$(sha256sum /usr/local/bin/vesper-microvm /usr/local/bin/vesper-microvm-init /usr/local/bin/vesper-guest-session $runtime_files | sha256sum | cut -d ' ' -f 1)
  if [ ! -f "$MVM/initrd.gz" ] || [ "$(cat "$MVM/initrd.sha256" 2>/dev/null)" != "$stamp" ]; then
    rm -rf "$MVM/initroot"
    mkdir -p "$MVM/initroot/bin" "$MVM/initroot/lib" "$MVM/initroot/dev" "$MVM/initroot/proc" "$MVM/initroot/sys"
    cp /bin/busybox "$MVM/initroot/bin/busybox"
    cp /lib/ld-musl-aarch64.so.1 "$MVM/initroot/lib/ld-musl-aarch64.so.1"
    ln -s busybox "$MVM/initroot/bin/sh"
    for src in $runtime_files; do
      [ -f "$src" ] || { echo "ERR runtime member $src missing"; return 1; }
      mkdir -p "$MVM/initroot$(dirname "$src")"
      cp -L "$src" "$MVM/initroot$src" || return 1
    done
    for src in $runtime_files; do sha256sum "$MVM/initroot$src"; done | sed "s|$MVM/initroot/||" > "$MVM/initroot/runtime.sha256"
    # Kernel modules from the modloop: a root drive (virtio-mmio transport, virtio-blk, ext4 and its deps), vsock, and
    # the balloon and virtio-mem drivers that Firecracker's balloon and memory-hotplug devices need (ADR 0007 slice 6),
    # and virtio-net with its failover dependencies for vesperd microVMs with tap devices (ADR 0008).
    kver=$(uname -r)
    mdir="$MVM/initroot/lib/modules/$kver"
    mkdir -p "$mdir"
    # The NFSv3 client for host shares (ADR 0009, GH #160 M4) is named by its top module only: every module is
    # copied with its whole modules.dep closure, so a dependency the kernel adds cannot go missing at boot.
    want="kernel/drivers/virtio/virtio_mmio kernel/drivers/block/virtio_blk kernel/crypto/crc32c_generic kernel/lib/libcrc32c kernel/fs/ext4/ext4 kernel/fs/jbd2/jbd2 kernel/fs/mbcache kernel/lib/crc16 kernel/net/vmw_vsock/vsock kernel/net/vmw_vsock/vmw_vsock_virtio_transport_common kernel/net/vmw_vsock/vmw_vsock_virtio_transport kernel/drivers/virtio/virtio_balloon kernel/drivers/virtio/virtio_mem kernel/net/core/failover kernel/drivers/net/net_failover kernel/drivers/net/virtio_net kernel/fs/nfs/nfsv3"
    files=""
    for rel in $want; do
      src=$(ls "/lib/modules/$kver/$rel".ko* 2>/dev/null | head -1)
      [ -n "$src" ] || { echo "ERR module $rel missing from /lib/modules/$kver"; return 1; }
      files="$files ${src#/lib/modules/$kver/}"
    done
    # modules.dep: "kernel/a.ko.gz: kernel/b.ko.gz kernel/c.ko.gz"; add dependencies until nothing new appears.
    [ -r "/lib/modules/$kver/modules.dep" ] || { echo "ERR /lib/modules/$kver/modules.dep missing"; return 1; }
    files=$(awk -v start="$files" '
      { sub(":", "", $1); dep[$1] = ""; for (i = 2; i <= NF; i++) dep[$1] = dep[$1] " " $i }
      END {
        n = split(start, q, " "); for (i = 1; i <= n; i++) seen[q[i]] = 1
        for (i = 1; i <= n; i++) { m = split(dep[q[i]], d, " "); for (j = 1; j <= m; j++) if (!(d[j] in seen)) { seen[d[j]] = 1; q[++n] = d[j] } }
        for (f in seen) print f
      }' "/lib/modules/$kver/modules.dep") || { echo "ERR reading modules.dep"; return 1; }
    for f in $files; do
      [ -f "/lib/modules/$kver/$f" ] || { echo "ERR module $f missing from /lib/modules/$kver"; return 1; }
      mkdir -p "$mdir/$(dirname "$f")"
      cp "/lib/modules/$kver/$f" "$mdir/$(dirname "$f")/"
    done
    for f in modules.dep modules.alias modules.builtin modules.order; do
      [ -f "/lib/modules/$kver/$f" ] && cp "/lib/modules/$kver/$f" "$mdir/$f"
    done
    mkdir -p "$MVM/initroot/newroot"
    cp "/media/vda/boot/config-$kver" "$MVM/initroot/kernel.config" || return 1
    cp /usr/local/bin/vesper-microvm-init "$MVM/initroot/init"
    cp /usr/local/bin/vesper-guest-session "$MVM/initroot/bin/vesper-guest-session"
    chmod +x "$MVM/initroot/init"
    (cd "$MVM/initroot" && find . | cpio -o -H newc 2>/dev/null | gzip -c > "$MVM/initrd.gz.tmp") || { echo "ERR initramfs build failed"; return 1; }
    mv "$MVM/initrd.gz.tmp" "$MVM/initrd.gz"
    echo "$stamp" > "$MVM/initrd.sha256"
  fi
  echo "PREPARED kernel=$(stat -c %s "$MVM/Image") initrd=$(stat -c %s "$MVM/initrd.gz") firecracker=$("$FC_DIR/firecracker" --version 2>/dev/null | head -1)"
}

# ---- share server (ADR 0009, GH #160 M3) ----
unfs_mount_ok() { # DIR: an absolute virtio-fs mount point (spaces and shell characters allowed; no newline)
  case "$1" in /*) ;; *) echo "not absolute"; return 1 ;; esac
  case "$1" in *"$NL"*) echo "a newline in the path"; return 1 ;; esac
  # /proc/mounts writes a space, tab, newline and backslash as \040, \011, \012 and \134.
  esc=$(printf '%s' "$1" | sed 's/\\/\\134/g; s/ /\\040/g; s/	/\\011/g')
  # Through the environment: awk -v would decode the backslash escapes again.
  D="$esc" awk '$2 == ENVIRON["D"] && $3 == "virtiofs" {f=1} END {exit !f}' /proc/mounts || { echo "$1 is not a virtio-fs mount"; return 1; }
}
unfs_pid() { p=$(cat "$UNFS/$1.pid" 2>/dev/null) && digits "$p" && [ -d "/proc/$p" ] && echo "$p"; }
unfs_listening() { # ID: the server's NFS port is open on the server address inside the namespace
  # unfsd binds an IPv6 socket to the IPv4-mapped address (::ffff:169.254.77.1); the traffic is IPv4 all the same.
  nsenter --net="$NETNS/$1" netstat -ltn 2>/dev/null | grep -Eq "[ :]$SHARE_SRV:2049 "
}
unfs_state() { if [ -n "$(unfs_pid "$1")" ]; then echo running; else echo stopped; fi; }
# The microVMs whose share server should run (its record is there) but whose supervisor has stopped: it gave up
# after 30 restarts in 60 s (TD-065), or was killed. HEALTH reports them (TD-070); their guests hang on the hard
# mounts until the task is stopped.
unfs_down() {
  for a in "$UNFS"/*.args; do
    [ -f "$a" ] || continue
    id=$(basename "$a" .args)
    valid_id "$id" && [ "$(unfs_state "$id")" = stopped ] && echo "$id"
  done
}
unfs_start() { # ID MOUNT SQUASH SOURCES(newline-separated) -> a reason on failure (lock held, namespace up)
  us_id=$1; us_mount=$2; us_sq=$3; us_srcs=$4
  mkdir -p "$UNFS" "$UNFS_ROOT" && chmod 0700 "$UNFS" "$UNFS_ROOT" || { echo "state directories"; return 1; }
  grep -qw memory /sys/fs/cgroup/cgroup.subtree_control || echo +memory > /sys/fs/cgroup/cgroup.subtree_control
  grep -qw pids /sys/fs/cgroup/cgroup.subtree_control || echo +pids > /sys/fs/cgroup/cgroup.subtree_control
  mkdir -p "$UNFS_CG" && echo "+memory +pids" > "$UNFS_CG/cgroup.subtree_control" || { echo "cgroup parent"; return 1; }
  mkdir -p "$UNFS_CG/$us_id" && echo "$UNFS_MEM" > "$UNFS_CG/$us_id/memory.max" && echo "$UNFS_PIDS" > "$UNFS_CG/$us_id/pids.max" \
    || { echo "cgroup"; return 1; }
  if grep -qw cpu /sys/fs/cgroup/cgroup.controllers; then
    grep -qw cpu /sys/fs/cgroup/cgroup.subtree_control || echo +cpu > /sys/fs/cgroup/cgroup.subtree_control
    grep -qw cpu "$UNFS_CG/cgroup.subtree_control" || echo +cpu > "$UNFS_CG/cgroup.subtree_control"
    echo "$UNFS_CPU" > "$UNFS_CG/$us_id/cpu.max" || { echo "cgroup cpu.max"; return 1; }
  fi
  set --
  # Split on newlines only, with pathname expansion off: a source may hold spaces, *, ? or [.
  us_ifs=$IFS; IFS=$NL; set -f
  for us_s in $us_srcs; do set -- "$@" --src "$us_s"; done
  set +f; IFS=$us_ifs
  [ "$us_sq" = 1 ] && set -- "$@" --squash
  rm -f "$UNFS/$us_id.pid" "$UNFS/$us_id.err" "/var/log/vesper-unfs-$us_id.log.1"
  : > "/var/log/vesper-unfs-$us_id.log"   # a retried id must not read the last launch's error as its own
  # What the server was started with, for the selfcheck hook and for diagnosis.
  { echo "$us_mount"; echo "$us_sq"; printf '%s\n' "$us_srcs"; } > "$UNFS/$us_id.args"
  # A guest can make unfsd abort with a malformed handle (TD-065), so restarts are bounded by rate, not by a small
  # count: at most one a second and 30 a minute; a guest that crashes it faster loses only its own shares.
  # Not on our stdout or stderr: the agent reads them to end of file, and supervise-daemon outlives this script.
  # supervise-daemon insists that RC_SVCNAME names the service it is given.
  RC_SVCNAME="vesper-unfs-$us_id" supervise-daemon "vesper-unfs-$us_id" --start --pidfile "$UNFS/$us_id.pid" \
    --respawn-delay 1 --respawn-max 30 --respawn-period 60 --stdout /dev/null \
    --stderr-logger "/usr/local/bin/vesper-boundlog /var/log/vesper-unfs-$us_id.log 262144" \
    "$(command -v nsenter)" -- "--net=$NETNS/$us_id" /usr/bin/vesper-unfs run --unfsd "$UNFSD" --mount "$us_mount" \
    --root "$UNFS_ROOT" --cgroup "$UNFS_CG/$us_id" "$@" < /dev/null > /dev/null 2> "$UNFS/$us_id.err" \
    || { echo "supervise-daemon: $(head -n 2 "$UNFS/$us_id.err" | tr '\n' ' ')"; return 1; }
  rm -f "$UNFS/$us_id.err"
  for _ in $(seq 1 40); do
    if unfs_listening "$us_id"; then
      # Test hook (test-unfs-stall-next): stop the next server once it listens, so the guest's mount stalls.
      if [ -e "$UNFS/stall-next" ]; then
        rm -f "$UNFS/stall-next"
        for p in $(cat "$UNFS_CG/$us_id/cgroup.procs" 2>/dev/null); do
          [ "$(cat "/proc/$p/comm" 2>/dev/null)" = unfsd ] && kill -STOP "$p"
        done
      fi
      return 0
    fi
    # A refused source or a sandbox step that failed will fail the same way on every respawn.
    grep -q "^vesper-unfs \(run\|init\):" "/var/log/vesper-unfs-$us_id.log" 2>/dev/null && break
    sleep 0.25
  done
  echo "server not listening: log: $(tail -n 3 "/var/log/vesper-unfs-$us_id.log" 2>/dev/null | tr '\n' ' ') netstat: $(nsenter --net="$NETNS/$us_id" netstat -ltn 2>&1 | tr '\n' ';') pidfile: $(cat "$UNFS/$us_id.pid" 2>/dev/null) cgroup: $(cat "$UNFS_CG/$us_id/cgroup.procs" 2>/dev/null | tr '\n' ' ') ps: $(ps -o pid,ppid,args 2>/dev/null | grep -e "vesper-unfs" -e unfsd -e nsenter | grep -v grep | tr '\n' ';')"
  return 1
}
unfs_stop() { # ID: stop the supervisor and the server, then remove the cgroup; idempotent
  if [ -e "$UNFS/$1.pid" ]; then
    RC_SVCNAME="vesper-unfs-$1" supervise-daemon "vesper-unfs-$1" --stop --pidfile "$UNFS/$1.pid" > /dev/null 2>&1
    rm -f "$UNFS/$1.pid"
  fi
  rm -f "$UNFS/$1.err" "$UNFS/$1.args" "$UNFS/$1.handles"
  if [ -d "$UNFS_CG/$1" ]; then
    [ -e "$UNFS_CG/$1/cgroup.kill" ] && echo 1 > "$UNFS_CG/$1/cgroup.kill" 2>/dev/null
    for _ in $(seq 1 20); do [ -s "$UNFS_CG/$1/cgroup.procs" ] || break; sleep 0.1; done
    rmdir "$UNFS_CG/$1" 2>/dev/null
  fi
}
unfs() { # ID: the server's state, for the suites and for diagnosis
  id=${1:-}; valid_id "$id" || { echo "ERR bad id"; return 2; }
  [ -e "$UNFS/$id.pid" ] || [ -d "$UNFS_CG/$id" ] || { echo "UNFS $id absent"; return 1; }
  l=no; unfs_listening "$id" && l=yes
  cg="$UNFS_CG/$id"
  echo "UNFS $id state=$(unfs_state "$id") pid=$(unfs_pid "$id") listen=$l mem_max=$(cat "$cg/memory.max" 2>/dev/null) mem_peak=$(cat "$cg/memory.peak" 2>/dev/null) cpu_max=$(cat "$cg/cpu.max" 2>/dev/null | tr ' ' /) oom_kills=$(awk '$1=="oom_kill"{print $2}' "$cg/memory.events" 2>/dev/null)"
}
unfs_log() { # ID [N]: the server's log and its supervisor's syslog lines, for diagnosis
  id=${1:-}; valid_id "$id" || { echo "ERR bad id"; return 2; }
  n=${2:-40}; digits "$n" || n=40
  cat "/var/log/vesper-unfs-$id.log.1" "/var/log/vesper-unfs-$id.log" 2>/dev/null | tail -n "$n"
  grep -a "vesper-unfs-$id" /var/log/messages 2>/dev/null | tail -n "$n"
}
# The server process as the kernel sees it: its ids, capabilities, no_new_privs, and namespaces against the share
# namespace and the System VM's; and every mount point in its root.
unfs_isolation() { # ID
  id=${1:-}; valid_id "$id" || { echo "ERR bad id"; return 2; }
  up=""
  for p in $(cat "$UNFS_CG/$id/cgroup.procs" 2>/dev/null); do
    [ "$(cat "/proc/$p/comm" 2>/dev/null)" = unfsd ] && up=$p
  done
  [ -n "$up" ] || { echo "UNFSISO $id absent"; return 1; }
  st=/proc/$up/status
  f() { awk -v k="$1:" '$1==k {print $2; exit}' "$st"; }
  ns() { [ "$(readlink "/proc/$up/ns/$1")" = "$(readlink "/proc/$$/ns/$1")" ] && echo same || echo own; }
  netns=other; [ "$(stat -L -c %i "/proc/$up/ns/net")" = "$(stat -L -c %i "$NETNS/$id" 2>/dev/null)" ] && netns=share
  mounts=$(awk '{print $5}' "/proc/$up/mountinfo" | sort | tr '\n' ',')
  echo "UNFSISO $id pid=$up uid=$(f Uid | cut -f1) gid=$(f Gid | cut -f1) capbnd=$(f CapBnd) capeff=$(f CapEff) capamb=$(f CapAmb) nonewprivs=$(f NoNewPrivs) seccomp=$(f Seccomp) mnt=$(ns mnt) pid_ns=$(ns pid) ipc=$(ns ipc) uts=$(ns uts) net=$netns mounts=$mounts"
  awk '{print "UNFSMOUNT", $5, $4, $6, $9, $10}' "/proc/$up/mountinfo"
}
# Test hooks (make systemvm-unfs-suite). test-unfs-selfcheck builds ID's sandbox again, from the arguments its
# server was started with, and runs the escape checks in it in place of unfsd. test-unfs-kill kills ID's unfsd, so
# supervise-daemon starts it again.
test_unfs_selfcheck() { # ID [PAUSE_MS]: PAUSE_MS holds the sandbox before it places the nests (the rename test)
  id=${1:-}; valid_id "$id" || { echo "ERR bad id"; return 2; }
  pause=${2:-0}; digits "$pause" || { echo "ERR bad pause"; return 2; }
  [ -r "$UNFS/$id.args" ] || { echo "ERR $id has no server"; return 1; }
  set --
  n=0
  while IFS= read -r line; do
    n=$((n + 1))
    case $n in 1) m=$line ;; 2) [ "$line" = 1 ] && set -- "$@" --squash ;; *) [ -n "$line" ] && set -- "$@" --src "$line" ;; esac
  done < "$UNFS/$id.args"
  mkdir -p /run/vesper/unfs-check-root && chmod 0700 /run/vesper/unfs-check-root
  nsenter --net="$NETNS/$id" /usr/bin/vesper-unfs run --selfcheck --test-pause-nests "${pause}ms" --mount "$m" --root /run/vesper/unfs-check-root "$@" 2>&1
}
test_unfs_kill() { # ID
  id=${1:-}; valid_id "$id" || { echo "ERR bad id"; return 2; }
  for p in $(cat "$UNFS_CG/$id/cgroup.procs" 2>/dev/null); do
    [ "$(cat "/proc/$p/comm" 2>/dev/null)" = unfsd ] && { kill -KILL "$p"; echo "KILLED unfsd $p"; return 0; }
  done
  echo "ERR no unfsd for $id"; return 1
}
# Test hook (make systemvm-microvm-shares-suite): what a supervisor that gave up leaves (TD-070): no supervisor and
# no server, the record still there.
test_unfs_giveup() { # ID
  id=${1:-}; valid_id "$id" || { echo "ERR bad id"; return 2; }
  sp=$(unfs_pid "$id") || { echo "ERR no supervisor for $id"; return 1; }
  kill -KILL "$sp"
  for p in $(cat "$UNFS_CG/$id/cgroup.procs" 2>/dev/null); do kill -KILL "$p"; done
  echo "GAVEUP $id"
}
# Test hook (make systemvm-unfs-suite): run vesper-unfs probe against ID's server from inside its namespace. The
# probe calls from the guest's address, so for its duration the namespace holds 169.254.77.2 on lo and accepts lo
# traffic; the guest's own connection to the server cannot work meanwhile. Both are removed afterwards.
test_unfs_probe() { # ID [probe flags]
  id=${1:-}; valid_id "$id" || { echo "ERR bad id"; return 2; }; shift
  vnetns_mounted "$NETNS" "$id" || { echo "ERR $id has no share namespace"; return 1; }
  f="$NETNS/$id"
  # Whatever ends the probe, the address and the rule go, or the guest's own connection stays broken.
  tp_undo() {
    nsenter --net="$f" iptables -w -D INPUT -i lo -j ACCEPT 2>/dev/null
    nsenter --net="$f" ip addr del "$SHARE_GUEST/32" dev lo 2>/dev/null
  }
  trap 'tp_undo; exit 130' INT; trap 'tp_undo; exit 143' TERM; trap 'tp_undo; exit 129' HUP
  nsenter --net="$f" ip addr add "$SHARE_GUEST/32" dev lo 2>/dev/null
  nsenter --net="$f" iptables -w -I INPUT 1 -i lo -j ACCEPT
  # --save and --replay keep the handles in the server's state directory (ESTALE after a restart).
  case "${1:-}" in
    --save) set -- --handles-out "$UNFS/$id.handles" ;;
    --replay) set -- --handles-in "$UNFS/$id.handles" ;;
  esac
  nsenter --net="$f" /usr/bin/vesper-unfs probe --local "$SHARE_GUEST:0" "$@"; rc=$?
  tp_undo
  trap - INT TERM HUP
  return $rc
}

launch() {
  id=$1; shift
  mode=""; rootfs=""; cmd64=""; vsock=0; runc_smoke=0; guestexec=0; sharenet=0; probe=""
  unfs_mount=""; unfs_srcs=""; unfs_squash=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --exit) mode=--exit ;;
      --vsock) vsock=1 ;;
      --guest-exec) guestexec=1; vsock=1 ;;
      --runc-smoke) runc_smoke=1 ;;
      --share-net) sharenet=1 ;;
      --share-probe) probe=$2; shift ;; # test hook: DELAY:PROBES, vesper_probe= for the guest after DELAY seconds
      --unfs-mount) unfs_mount=${2:-}; shift ;;
      --unfs-src)
        case "${2:-}" in *"$NL"*|'') echo "ERR bad --unfs-src"; return 2 ;; esac
        unfs_srcs="$unfs_srcs${unfs_srcs:+$NL}$2"; shift ;;
      --unfs-squash) unfs_squash=1 ;;
      --rootfs) rootfs=$2; shift ;;
      --cmd) cmd64=$2; shift ;;
      *) echo "ERR unknown launch option $1"; return 2 ;;
    esac
    shift
  done
  prep=$(prepare) || { echo "$prep"; return 1; }
  if [ -n "$rootfs" ] && [ ! -f "$rootfs" ]; then echo "ERR rootfs $rootfs missing"; return 1; fi
  # Every check that can refuse the request comes before the memory admission, so a bad request takes nothing.
  if [ "$runc_smoke" = 1 ]; then
    [ -n "$rootfs" ] && [ -z "$cmd64" ] && [ -z "$mode" ] || { echo "ERR --runc-smoke needs --rootfs and excludes --cmd/--exit"; return 2; }
  fi
  if [ "$guestexec" = 1 ]; then
    [ -n "$rootfs" ] && [ -z "$cmd64" ] && [ -z "$mode" ] && [ "$runc_smoke" = 0 ] || { echo "ERR --guest-exec needs --rootfs and excludes --cmd/--exit/--runc-smoke"; return 2; }
  fi
  if [ -n "$cmd64" ] && [ -z "$rootfs" ]; then echo "ERR --cmd needs --rootfs"; return 2; fi
  if [ "$sharenet" = 1 ]; then
    valid_id "$id" || { echo "ERR --share-net needs an id of letters, digits and hyphens"; return 2; }
  fi
  if [ -n "$unfs_mount$unfs_srcs" ]; then
    [ "$sharenet" = 1 ] && [ -n "$unfs_mount" ] && [ -n "$unfs_srcs" ] || { echo "ERR --unfs-mount and --unfs-src need each other and --share-net"; return 2; }
    why=$(unfs_mount_ok "$unfs_mount") || { echo "ERR --unfs-mount: $why"; return 2; }
  fi
  if [ -n "$probe" ]; then
    [ "$sharenet" = 1 ] || { echo "ERR --share-probe needs --share-net"; return 2; }
    case "$probe" in *[!A-Za-z0-9.:,_-]*|[!0-9]*) echo "ERR bad --share-probe (DELAY:PROBES)"; return 2 ;; esac
  fi
  # The jail lives on the tmpfs root, so the kernel, initrd and rootfs copied into it use System VM memory outside
  # the cgroup: book them with the ceiling.
  copies=0
  for f in "$MVM/Image" "$MVM/initrd.gz" ${rootfs:+"$rootfs"}; do s=$(stat -c %s "$f" 2>/dev/null) && copies=$((copies + s)); done
  # From here to the namespace the launch holds the lifecycle lock, so a reaper pass or a cleanup of the same id
  # cannot run in between and give back this launch's admission or remove its jail.
  trap launch_abort INT TERM HUP
  lock || { echo "ERR lifecycle lock"; return 1; }
  if [ -n "$(fcpid "$id")" ]; then unlock; echo "ERR $id already running"; return 1; fi
  # What an earlier run of this id left (a record, a namespace) goes first, whichever kind of launch this is.
  if [ -e "$REC/$id" ] || [ -e "$NETNS/$id" ]; then
    old=$(cleanup "$id") || { unlock; echo "ERR $id: leftovers of an earlier run: $old"; return 1; }
  fi
  book=$((CEILING + copies)); [ -n "$unfs_srcs" ] && book=$((book + UNFS_MEM))
  adm=$(/usr/local/bin/vesper-memadmit acquire shim "$id" "$book") || { unlock; echo "$adm" | head -1; return 1; }
  LAUNCHING=$id
  nsarg=""; netcfg=""
  if [ "$sharenet" = 1 ]; then
    # The record comes before the namespace, so the reaper never takes a half-made namespace for an orphan.
    why=""
    made=$(setup_user) || why="user: $made"
    [ -z "$why" ] && { mkdir -p "$REC" || why="record directory"; }
    [ -z "$why" ] && { echo "pid=$$ start=$(proc_stat $$ | cut -d' ' -f2) t=$(date +%s)" > "$REC/$id" && [ -s "$REC/$id" ] || why="record not written"; }
    [ -z "$why" ] && { why=$(sharenet_up "$id") && why=""; }
    # The server starts in the namespace before the jailer, so the guest finds it listening (ADR 0009, Lifecycle).
    [ -z "$why" ] && [ -n "$unfs_srcs" ] && { why=$(unfs_start "$id" "$unfs_mount" "$unfs_squash" "$unfs_srcs") && why="" || why="unfs: ${why:-start failed}"; }
    if [ -n "$why" ]; then
      cleanup "$id" > /dev/null; unlock; LAUNCHING=""
      echo "ERR share network: $why"; return 1
    fi
    nsarg="--netns $NETNS/$id"
    netcfg=",\"network-interfaces\":[{\"iface_id\":\"$SHARE_TAP\",\"host_dev_name\":\"$SHARE_TAP\",\"guest_mac\":\"06:00:a9:fe:4d:02\"}]"
  fi
  unlock
  root="$JAIL/firecracker/$id/root"
  rm -rf "$JAIL/firecracker/$id"
  mkdir -p "$root"
  cp "$MVM/Image" "$root/Image"
  cp "$MVM/initrd.gz" "$root/initrd.gz"
  extra=""
  [ "$mode" = "--exit" ] && extra=" vesper_exit=1"
  if [ "$runc_smoke" = 1 ]; then
    extra="$extra vesper_runc_smoke=1"
  fi
  if [ "$guestexec" = 1 ]; then
    extra="$extra vesper_guest_exec=1"
  fi
  drives="[]"
  if [ -n "$cmd64" ]; then
    extra="$extra vesper_cmd=$cmd64"
  fi
  if [ -n "$rootfs" ]; then
    cp "$rootfs" "$root/rootfs.ext4"
    extra="$extra vesper_rootfs=1"
    drives='[{"drive_id":"rootfs","path_on_host":"/rootfs.ext4","is_root_device":true,"is_read_only":false}]'
  fi
  if [ "$sharenet" = 1 ]; then
    extra="$extra vesper_share_net=$SHARE_GUEST/$SHARE_PREFIX"
    [ -n "$probe" ] && extra="$extra vesper_probe_delay=${probe%%:*} vesper_probe=${probe#*:}"
  fi
  vsockcfg=""
  if [ "$vsock" = 1 ]; then
    extra="$extra vesper_vsock=1"
    vsockcfg=',"vsock":{"guest_cid":3,"uds_path":"/v.sock"}'
  fi
  printf '{"boot-source":{"kernel_image_path":"/Image","initrd_path":"/initrd.gz","boot_args":"console=ttyS0 reboot=k panic=1 pci=off rdinit=/init%s"},"drives":%s,"machine-config":{"vcpu_count":1,"mem_size_mib":256}%s%s}\n' "$extra" "$drives" "$vsockcfg" "$netcfg" > "$root/vm.json"
  chown -R "$JUID:$JGID" "$JAIL/firecracker/$id"
  lf=$(logfile "$id"); pipe="/var/log/.vesper-microvm-$id.pipe"
  rm -f "$lf" "$lf.1" "$pipe"
  mkfifo -m 0600 "$pipe" || { echo "ERR console pipe"; cleanup "$id" > /dev/null; LAUNCHING=""; return 1; }
  : > "$lf"
  # Not on our stdout or stderr: the caller (the agent) reads them to EOF, and the bounder outlives this script.
  /usr/local/bin/vesper-boundlog "$lf" "$LOG_MAX" < "$pipe" > /dev/null 2>&1 &
  start=$(now_ms)
  # shellcheck disable=SC2086
  setsid "$FC_DIR/jailer" --id "$id" --exec-file "$FC_DIR/firecracker" --uid "$JUID" --gid "$JGID" $nsarg \
    --chroot-base-dir "$JAIL" --cgroup-version 2 --cgroup pids.max=256 --cgroup "memory.max=$CEILING" \
    -- --config-file /vm.json --api-sock /run/firecracker.socket \
    > "$pipe" 2>&1 < /dev/null &
  # With a share network the guest must also report its interface up (it prints that after the marker).
  ready() { grep -q "$MARKER" "$lf" && { [ "$sharenet" = 0 ] || grep -q "VESPER-SHARE-NET-OK" "$lf"; }; }
  for _ in $(seq 1 120); do
    ready && break
    grep -q "VESPER-SHARE-NET-FAILED" "$lf" && break
    sleep 0.25
  done
  if ready; then
    end=$(now_ms)
    LAUNCHING=""
    echo "LAUNCHED $id pid=$(fcpid "$id") boot_ms=$((end - start))"
  else
    echo "FAILED $id"
    tail -n 8 "$lf"
    # A launch that never became ready gives back what it took: the process, the jail and the memory admission.
    # The console log stays for diagnosis; cleanup --logs removes it.
    cleanup "$id" > /dev/null
    LAUNCHING=""
    return 1
  fi
}

status() {
  id=$1; pid=$(fcpid "$id")
  if [ -n "$pid" ]; then
    vs="absent"; [ -S "$JAIL/firecracker/$id/root/v.sock" ] && vs="present"
    sn=""; vnetns_mounted "$NETNS" "$id" && sn=" sharenet=present"
    [ -e "$UNFS/$id.pid" ] && sn="$sn unfs=$(unfs_state "$id")"
    echo "RUNNING $id pid=$pid vsock=$vs$sn"
  elif [ -f "$(logfile "$id")" ]; then echo "EXITED $id"
  else echo "ABSENT $id"; fi
}

isolation() {
  id=$1; pid=$(fcpid "$id")
  [ -n "$pid" ] || { echo "ERR $id not running"; return 1; }
  uid=$(awk '/^Uid:/{print $2}' "/proc/$pid/status")
  # The jailer pivot_roots into the chroot in its own mount namespace, so /proc/<pid>/root reads "/";
  # judge the jail by its contents and by the mount namespace.
  root=$(readlink "/proc/$pid/root")
  cg=$(sed -n 's/^0::\(.*\)$/\1/p' "/proc/$pid/cgroup")
  sec=$(awk '/^Seccomp:/{print $2}' "/proc/$pid/status")
  uid_ok=false; [ "$uid" = "$JUID" ] && uid_ok=true
  chroot_ok=false
  if [ -e "/proc/$pid/root/vm.json" ] && [ ! -e "/proc/$pid/root/etc/alpine-release" ] \
     && [ "$(readlink "/proc/$pid/ns/mnt")" != "$(readlink /proc/1/ns/mnt)" ]; then chroot_ok=true; fi
  cg_ok=false; case "$cg" in */firecracker/"$id"*) cg_ok=true;; esac
  sec_ok=false; [ "$sec" = "2" ] && sec_ok=true
  jail_files=$(ls "/proc/$pid/root" 2>/dev/null | tr '\n' ' ')
  printf '{"id":"%s","pid":%s,"uid":%s,"root":"%s","jail_files":"%s","cgroup":"%s","seccomp_mode":%s,"uid_ok":%s,"chroot_ok":%s,"cgroup_ok":%s,"seccomp_ok":%s}\n' \
    "$id" "$pid" "$uid" "$root" "$jail_files" "$cg" "${sec:-0}" "$uid_ok" "$chroot_ok" "$cg_ok" "$sec_ok"
}

stop() {
  id=$1; pid=$(fcpid "$id")
  [ -n "$pid" ] || { echo "STOPPED $id (not running)"; return 0; }
  kill -TERM "$pid" 2>/dev/null
  for _ in $(seq 1 40); do kill -0 "$pid" 2>/dev/null || { echo "STOPPED $id"; return 0; }; sleep 0.25; done
  kill -KILL "$pid" 2>/dev/null; sleep 0.5
  echo "STOPPED $id (killed after timeout)"
}

crash() {
  id=$1; pid=$(fcpid "$id")
  [ -n "$pid" ] || { echo "ERR $id not running"; return 1; }
  kill -KILL "$pid" 2>/dev/null
  for _ in $(seq 1 20); do kill -0 "$pid" 2>/dev/null || break; sleep 0.25; done
  echo "CRASHED $id pid=$pid"
}

cleanup() { # ID [--logs]: under the lifecycle lock, taken here unless the caller holds it
  valid_id "${1:-}" || { echo "ERR bad id"; return 2; }
  if [ "$LOCKED" = 1 ]; then cleanup_locked "$@"; return $?; fi
  lock || { echo "ERR lifecycle lock"; return 1; }
  cleanup_locked "$@"; crc=$?
  unlock
  return $crc
}
cleanup_locked() {
  id=$1; pid=$(fcpid "$id")
  [ -n "$pid" ] && { kill -KILL "$pid" 2>/dev/null; sleep 0.5; }
  unfs_stop "$id"
  rm -rf "$JAIL/firecracker/$id"
  rm -f "/var/log/.vesper-microvm-$id.pipe"
  [ "${2:-}" = --logs ] && rm -f "$(logfile "$id")" "$(logfile "$id").1" "/var/log/vesper-unfs-$id.log" "/var/log/vesper-unfs-$id.log.1"
  for cg in "/sys/fs/cgroup/firecracker/$id" "/sys/fs/cgroup/$id"; do
    [ -d "$cg" ] && rmdir "$cg" 2>/dev/null
  done
  # shellcheck disable=SC2046
  [ -f "$STATE/test-listen.$id" ] && { kill $(cat "$STATE/test-listen.$id") 2>/dev/null; rm -f "$STATE/test-listen.$id"; }
  # The share namespace (ADR 0009); its tap goes with it now that Firecracker is gone.
  [ -e "$NETNS/$id" ] && vnetns_down "$NETNS" "$id"
  dirty=""
  [ -e "$NETNS/$id" ] && dirty="$dirty netns"
  [ -n "$(fcpid "$id")" ] && dirty="$dirty process"
  [ -e "$JAIL/firecracker/$id" ] && dirty="$dirty chroot"
  [ -d "/sys/fs/cgroup/firecracker/$id" ] && dirty="$dirty cgroup"
  [ -d "$UNFS_CG/$id" ] && dirty="$dirty unfs-cgroup"
  [ -e "$UNFS/$id.pid" ] && dirty="$dirty unfs"
  grep -q "/firecracker/$id/" /proc/mounts 2>/dev/null && dirty="$dirty mount"
  # A socket named after the id, as a whole word (ids are letters, digits and hyphens): a bare substring also matched other tasks' sockets (containerd
  # names shim sockets by a hex digest, which often contains a short id such as "ca"), and the false DIRTY kept the
  # memory admitted for another 30 s.
  find /run -type s 2>/dev/null | sed 's|.*/||' | grep -Eq "(^|[^A-Za-z0-9-])$id([^A-Za-z0-9-]|\$)" && dirty="$dirty socket"
  # The memory stays admitted while anything of the microVM is left (D-029); vesper-memadmit drops a DIRTY entry
  # itself once the cgroup and jail are gone.
  if [ -z "$dirty" ]; then rm -f "$REC/$id"; /usr/local/bin/vesper-memadmit release shim "$id" 2>/dev/null; echo "CLEAN $id"
  else echo "DIRTY $id$dirty"; return 1; fi
}

mlog() { id=$1; n=${2:-20}; lf=$(logfile "$id"); [ -f "$lf" ] && cat "$lf.1" "$lf" 2>/dev/null | tail -n "$n" || echo "ERR no log for $id"; }

cmd=${1:-}; shift 2>/dev/null
case "$cmd" in
  prepare) prepare ;;
  launch) launch "$@" ;;
  status) status "$@" ;;
  isolation) isolation "$@" ;;
  stop) stop "$@" ;;
  crash) crash "$@" ;;
  cleanup) cleanup "$@" ;;
  log) mlog "$@" ;;
  sharenet) sharenet "$@" ;;
  unfs) unfs "$@" ;;
  unfs-isolation) unfs_isolation "$@" ;;
  unfs-down) unfs_down ;;
  unfs-log) unfs_log "$@" ;;
  unfs-events) cat "$UNFS/fanout.stat" 2>/dev/null || echo "{}" ;;   # the event hop's counters per microVM (M6)
  unfs-stop) valid_id "${1:-}" || { echo "ERR bad id"; exit 2; }; lock && unfs_stop "$1"; unlock; echo "UNFS $1 stopped" ;;
  test-unfs-selfcheck) test_unfs_selfcheck "$@" ;;
  test-unfs-kill) test_unfs_kill "$@" ;;
  test-unfs-giveup) test_unfs_giveup "$@" ;;
  test-unfs-stall-next) mkdir -p "$UNFS" && : > "$UNFS/stall-next" && echo "STALL next" ;;
  test-unfs-probe) test_unfs_probe "$@" ;;
  reap) reap ;;
  reap-loop) reap_loop "$@" ;;
  setup-user) setup_user ;;
  test-share-listen) test_share_listen "$@" ;;
  test-share-reach) test_share_reach "$@" ;;
  test-age) test_age "$@" ;;
  test-abort-launch) test_abort_launch "$@" ;;
  test-drop-record) test_drop_record "$@" ;;
  test-impostor) test_impostor "$@" ;;
  *) echo "ERR usage: vesper-microvm prepare|launch|status|isolation|stop|crash|cleanup|log|sharenet|unfs|reap|setup-user"; exit 2 ;;
esac
