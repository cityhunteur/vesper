#!/bin/sh
# Vesper guest agent: one connection per process, spawned by socat
# (etc/init.d/vesper-agent) for every vsock connection on the agent port.
# Line protocol, version 1:
#   greeting:  VESPER-AGENT 1 <hostname>
#   PING                  -> PONG
#   VERSION               -> VERSION 1
#   ECHO <n>              -> ECHO <n> then the next <n> bytes are read and written back unchanged
#   HEALTH                -> HEALTH {"packages_ready":bool,"services_ready":bool,"services":{...},
#                             "containerd_ok":bool,"docker_ok":bool,"docker_version":"...","kvm":bool}
#   KILL <containerd|docker> -> KILL <name> <pid> after SIGKILL to the daemon (crash simulation)
#   LOGS <messages|containerd|docker> <n> -> LOGS <count> then <count> log lines
#   DROP                  -> DROP then the connection is closed (simulates a server-side drop)
#   SHUTDOWN              -> BYE then poweroff
#   QUIT                  -> BYE then the connection is closed
#   anything else         -> ERR unknown command
printf 'VESPER-AGENT 1 %s\n' "$(hostname)"
service_state() {
  if [ -x "/etc/init.d/$1" ]; then
    rc-service "$1" status 2>/dev/null | awk '{print $NF}'
  else
    echo missing
  fi
}
while IFS= read -r line; do
  set -- $line
  case "$1" in
    PING) echo PONG ;;
    VERSION) echo "VERSION 1" ;;
    ECHO)
      n="${2:-0}"
      case "$n" in ''|*[!0-9]*) echo "ERR bad length"; continue ;; esac
      echo "ECHO $n"
      head -c "$n"
      ;;
    HEALTH)
      ready=false; sready=false; cok=false; dok=false; dver=""; kvm=false
      [ -c /dev/kvm ] && kvm=true
      [ -f /run/vesper/packages-ready ] && ready=true
      [ -f /run/vesper/services-ready ] && sready=true
      ctr --connect-timeout 2s version >/dev/null 2>&1 && cok=true
      dver="$(docker version --format '{{.Server.Version}}' 2>/dev/null || true)"
      [ -n "$dver" ] && dok=true
      printf 'HEALTH {"packages_ready":%s,"services_ready":%s,"services":{"containerd":"%s","docker":"%s","vesper-agent":"%s"},"containerd_ok":%s,"docker_ok":%s,"docker_version":"%s","kvm":%s}\n' \
        "$ready" "$sready" "$(service_state containerd)" "$(service_state docker)" "$(service_state vesper-agent)" "$cok" "$dok" "$dver" "$kvm"
      ;;
    KILL)
      case "$2" in
        containerd) proc=containerd ;;
        docker) proc=dockerd ;;
        *) echo "ERR unknown service"; continue ;;
      esac
      pid="$(pidof "$proc" 2>/dev/null | awk '{print $1}')"
      if [ -z "$pid" ]; then echo "ERR $2 not running"; continue; fi
      kill -9 "$pid" 2>/dev/null
      echo "KILL $2 $pid"
      ;;
    LOGS)
      case "$2" in
        messages) file=/var/log/messages ;;
        containerd) file=/var/log/containerd.log ;;
        docker) file=/var/log/docker.log ;;
        *) echo "ERR unknown log"; continue ;;
      esac
      n="${3:-50}"
      case "$n" in ''|*[!0-9]*) echo "ERR bad count"; continue ;; esac
      if [ -f "$file" ]; then
        out="$(tail -n "$n" "$file")"
        count="$(printf '%s\n' "$out" | grep -c '' )"
        [ -z "$out" ] && count=0
        echo "LOGS $count"
        [ "$count" -gt 0 ] && printf '%s\n' "$out"
      else
        echo "LOGS 0"
      fi
      ;;
    DROP) echo DROP; exit 0 ;;
    SHUTDOWN) echo BYE; (sleep 0.2; poweroff) & exit 0 ;;
    QUIT) echo BYE; exit 0 ;;
    *) echo "ERR unknown command" ;;
  esac
done
