#!/bin/sh
# Vesper guest agent: one connection per process, spawned by socat
# (etc/init.d/vesper-agent) for every vsock connection on the agent port.
# Line protocol, version 1:
#   greeting:  VESPER-AGENT 1 <hostname>
#   PING                  -> PONG
#   VERSION               -> VERSION 1
#   ECHO <n>              -> ECHO <n> then the next <n> bytes are read and written back unchanged
#   HEALTH                -> HEALTH {"packages_ready":bool,"services_ready":bool,"services":{...},
#                             "containerd_ok":bool,"docker_ok":bool,"docker_version":"...","kvm":bool,"tun":bool,
#                             "ip":"...","containers":"mapped|unmapped|refused <reason>","authz":"<state>",
#                             "legacy_store":"absent|present volumes=N containers=M",  (ADR 0010)
#                             "share_servers_down":"<id>,...",  (TD-070: shim microVMs whose share server stopped)
#                             "handlers":N,"handlers_max":N}  (TD-026: connections open on the agent port)
#   HOSTFREE <bytes>      -> OK after recording the macOS volume's free bytes for vesper-vesperd (TD-053, D-095)
#   KILL <containerd|docker> -> KILL <name> <pid> after SIGKILL to the daemon (crash simulation)
#   LOGS <messages|containerd|docker> <n> -> LOGS <count> then <count> log lines
#   MICROVM <args...>     -> MICROVM <rc> <count> then <count> output lines of `vesper-microvm <args>`
#   ROOTFS <args...>      -> ROOTFS <rc> <count> then <count> output lines of `vesper-rootfs <args>`
#   WORKLOAD <args...>    -> WORKLOAD <rc> <count> then <count> output lines of `vesper-workload <args>`
#   FCPARITY <args...>    -> FCPARITY <rc> <count> then <count> output lines of `vesper-fcparity <args>`
#   CTR <args...>         -> CTR <rc> <count> then <count> output lines of `vesper-ctr <args>`
#   SHARE <args...>       -> SHARE <rc> <count> then <count> output lines of `vesper-share <args>`
#   ARCH <args...>        -> ARCH <rc> <count> then <count> output lines of `vesper-arch <args>`
#   DATA <args...>        -> DATA <rc> <count> then <count> output lines of `vesper-data <args>` (GH #164)
#   CONTAINERS <args...>  -> CONTAINERS <rc> <count> then <count> output lines of `vesper-containers <args>` (ADR 0010)
#   VESPERD <args...>     -> VESPERD <rc> <count> then <count> output lines of `vesper-vesperd <args>`, except
#                            launch and connect (ADR 0007); includes stage, store-list and store-rm (slice 5)
#   LAUNCHAPI <id> [ceiling] [stage=SRC:DEST|tap=NAME|tapaddr=NAME:ADDR/PREFIX|net=none|net=nat]...
#                         -> READY <id> pid=<n> firecracker_version=<v> once the API socket exists, or
#                            ERR <reason> and close; each stage= token is staged into the fresh jail first, and each
#                            tap= token is a tap device in the microVM's own network namespace (CE-0010); after
#                            READY this connection is the microVM's lease: its end of file stops the microVM, and
#                            the agent closes it when Firecracker exits (ADR 0007)
#   FCAPI <id>            -> OK, then the connection relays bytes to <id>'s Firecracker API socket; or ERR <reason>
#                            and close (ADR 0007)
#   DROP                  -> DROP then the connection is closed (simulates a server-side drop)
#   SHUTDOWN              -> BYE then poweroff
#   QUIT                  -> BYE then the connection is closed
#   anything else         -> ERR unknown command
# Bounds (TD-026): a connection that sends no command for AGENT_IDLE_S is closed (a LAUNCHAPI lease or an FCAPI relay
# is no longer this loop's; ECHO's bytes have the same limit); LAUNCHAPI and FCAPI, which hold a handler for their
# life, are refused with "ERR full: ..." when more than HANDLERS_MAX - CONTROL_RESERVE handlers are open, or when they
# cannot be counted, so control commands keep a slot.
. "$(dirname "$0")/../lib/vesper/vsock-peer.sh"
vsock_host_only
AGENT_IDLE_S=900     # seconds a connection may wait between commands
HANDLERS_MAX=64      # socat's max-children in etc/init.d/vesper-agent (tests/agent_protocol.rs checks they agree)
CONTROL_RESERVE=8    # handlers that LAUNCHAPI and FCAPI never take
# The open connections: socat forks one relay per connection (this script's parent) from the listener (its parent).
# With the shell's own read, not a process for each entry (council F3). Prints nothing when the listener is unknown.
stat_ppid() { # FILE -> the ppid field of a /proc/PID/stat
  sp=""; read -r sp < "$1" 2>/dev/null || [ -n "$sp" ] || return 1
  sp=${sp##*) }
  # shellcheck disable=SC2086
  set -- $sp
  echo "${2:-}"
}
handlers() {
  hl=$(stat_ppid "/proc/$PPID/stat")
  case "$hl" in ''|*[!0-9]*) return 1 ;; esac
  hn=0
  for hs in /proc/[0-9]*/stat; do
    sp=""; read -r sp < "$hs" 2>/dev/null || [ -n "$sp" ] || continue
    sp=${sp##*) }
    # shellcheck disable=SC2086
    set -- $sp
    [ "${2:-}" = "$hl" ] && hn=$((hn + 1))
  done
  echo "$hn"
}
lease_room() { # -> 0 when a LAUNCHAPI or FCAPI may take a handler; else prints the refusal ("full", not vesperd's "busy <id>")
  lr=$(handlers) || { echo "ERR full: the open handlers cannot be counted"; return 1; }
  [ "$lr" -le $((HANDLERS_MAX - CONTROL_RESERVE)) ] && return 0
  echo "ERR full: $lr of $HANDLERS_MAX handlers open; $CONTROL_RESERVE are kept for control commands"
  return 1
}
printf 'VESPER-AGENT 1 %s\n' "$(hostname)"
service_state() {
  if [ -x "/etc/init.d/$1" ]; then
    rc-service "$1" status 2>/dev/null | awk '{print $NF}'
  else
    echo missing
  fi
}
while IFS= read -r -t "$AGENT_IDLE_S" line; do
  set -- $line
  case "$1" in
    PING) echo PONG ;;
    HOSTFREE)
      # TD-053: the free bytes of the macOS volume that holds the data disk image, from the launcher every 30 s.
      # vesper-vesperd counts the smaller of this and the disk's own free space against its reserve.
      case "${2:-}" in ''|*[!0-9]*) echo "ERR bad bytes"; continue ;; esac
      printf '%s %s\n' "$2" "$(date +%s)" > /run/vesper/hostfree.tmp && mv /run/vesper/hostfree.tmp /run/vesper/hostfree \
        && echo OK || echo "ERR write"
      ;;
    VERSION) echo "VERSION 1" ;;
    ECHO)
      n="${2:-0}"
      case "$n" in ''|*[!0-9]*) echo "ERR bad length"; continue ;; esac
      echo "ECHO $n"
      # Bounded like the command loop: a client that never sends the bytes does not hold a handler (TD-026).
      timeout "$AGENT_IDLE_S" head -c "$n"
      ;;
    HEALTH)
      ready=false; sready=false; cok=false; dok=false; dver=""; kvm=false
      [ -c /dev/kvm ] && kvm=true
      tun=false; [ -c /dev/net/tun ] && tun=true
      [ -f /run/vesper/packages-ready ] && ready=true
      [ -f /run/vesper/services-ready ] && sready=true
      ctr --connect-timeout 2s version >/dev/null 2>&1 && cok=true
      # Bounded: without its authorisation plugin dockerd holds a request for about 30 s before it refuses it.
      dver="$(timeout 5 docker version --format '{{.Server.Version}}' 2>/dev/null || true)"
      [ -n "$dver" ] && dok=true
      ip=$(ip -4 -o addr show dev eth0 2>/dev/null | awk '{print $4}' | cut -d/ -f1 | head -1)
      # ADR 0010: the container mode of this boot, the plugin's state and whether an old unmapped store is on the disk.
      cst=$(/usr/local/bin/vesper-containers status 2>/dev/null | sed 's/^CONTAINERS //')
      cmode=${cst%% authz=*}; rest=${cst#* authz=}; authz=${rest%% legacy=*}; legacy=${rest#* legacy=}
      # TD-070: the shim microVMs whose share server has stopped for good (ids are [A-Za-z0-9_.-]).
      sdown=$(/usr/local/bin/vesper-microvm unfs-down 2>/dev/null | tr -cd 'A-Za-z0-9_.\n-' | paste -sd, -)
      printf 'HEALTH {"packages_ready":%s,"services_ready":%s,"services":{"containerd":"%s","docker":"%s","vesper-agent":"%s"},"containerd_ok":%s,"docker_ok":%s,"docker_version":"%s","kvm":%s,"tun":%s,"ip":"%s","containers":"%s","authz":"%s","legacy_store":"%s","share_servers_down":"%s","handlers":%s,"handlers_max":%s}\n' \
        "$ready" "$sready" "$(service_state containerd)" "$(service_state docker)" "$(service_state vesper-agent)" "$cok" "$dok" "$dver" "$kvm" "$tun" "$ip" "${cmode:-unknown}" "${authz:-unknown}" "${legacy:-unknown}" "$sdown" "$(handlers || echo -1)" "$HANDLERS_MAX"
      ;;
    KILL)
      case "$2" in
        containerd) proc=containerd ;;
        docker) proc=dockerd ;;
        *) echo "ERR unknown service"; continue ;;
      esac
      pid="$(pidof "$proc" 2>/dev/null | awk '{print $1}')"
      if [ -z "$pid" ]; then echo "ERR $2 not running"; continue; fi
      kill -9 "$pid" 2>/dev/null
      echo "KILL $2 $pid"
      ;;
    LOGS)
      case "$2" in
        messages) file=/var/log/messages ;;
        containerd) file=/var/log/containerd.log ;;
        docker) file=/var/log/docker.log ;;
        *) echo "ERR unknown log"; continue ;;
      esac
      n="${3:-50}"
      case "$n" in ''|*[!0-9]*) echo "ERR bad count"; continue ;; esac
      if [ -f "$file" ]; then
        out="$(tail -n "$n" "$file")"
        count="$(printf '%s\n' "$out" | grep -c '' )"
        [ -z "$out" ] && count=0
        echo "LOGS $count"
        [ "$count" -gt 0 ] && printf '%s\n' "$out"
      else
        echo "LOGS 0"
      fi
      ;;
    LAUNCHAPI) lease_room || exit 0; shift; exec /usr/local/bin/vesper-vesperd launch "$@" ;;
    FCAPI) lease_room || exit 0; shift; exec /usr/local/bin/vesper-vesperd connect "$@" ;;
    MICROVM|ROOTFS|WORKLOAD|FCPARITY|CTR|SHARE|ARCH|DATA|VESPERD|CONTAINERS)
      tool=$1; shift
      case "$tool" in CONTAINERS) bin=/usr/local/bin/vesper-containers ;; MICROVM) bin=/usr/local/bin/vesper-microvm ;; ROOTFS) bin=/usr/local/bin/vesper-rootfs ;; WORKLOAD) bin=/usr/local/bin/vesper-workload ;; FCPARITY) bin=/usr/local/bin/vesper-fcparity ;; CTR) bin=/usr/local/bin/vesper-ctr ;; SHARE) bin=/usr/local/bin/vesper-share ;; DATA) bin=/usr/local/bin/vesper-data ;; VESPERD) bin=/usr/local/bin/vesper-vesperd ;; *) bin=/usr/local/bin/vesper-arch ;; esac
      # launch and connect own the connection; they are reached only as LAUNCHAPI and FCAPI.
      if [ "$tool" = VESPERD ]; then case "${1:-}" in launch|connect) echo "$tool 2 1"; echo "ERR use LAUNCHAPI or FCAPI"; continue ;; esac; fi
      out="$("$bin" "$@" 2>&1)"; rc=$?
      count="$(printf '%s\n' "$out" | grep -c '')"
      [ -z "$out" ] && count=0
      echo "$tool $rc $count"
      [ "$count" -gt 0 ] && printf '%s\n' "$out"
      ;;
    DROP) echo DROP; exit 0 ;;
    SHUTDOWN) echo BYE; (sleep 0.2; poweroff) & exit 0 ;;
    QUIT) echo BYE; exit 0 ;;
    *) echo "ERR unknown command" ;;
  esac
done
