#!/bin/sh
# Private microVM control protocol (ADR 0006); socat supplies the connected stdin/stdout.
set -eu
export PATH=/bin:/usr/bin
fail() { printf 'ERROR {"stage":"%s","message":"%s"}\n' "$1" "$2"; exit 1; }
IFS=' ' read -r op port size tty || exit 1
case "$port" in ''|*[!0-9]*) fail request invalid-port ;; esac
[ "$port" -ge 1028 ] && [ "$port" -le 65528 ] && [ "$((port % 4))" = 0 ] || fail request invalid-port
dir=/run/sessions/p$port
terminate() {
  [ -f "$dir/pid" ] || return 0
  if [ "$port" = 1028 ]; then
    /usr/bin/runc --root /run/runc kill --all workload KILL 2>/dev/ttyS0 || true
  else
    kill -KILL "$(cat "$dir/pid")" 2>/dev/null || true
  fi
}
case "$op" in
  ABORT)
    if mkdir "$dir" 2>/dev/null; then
      touch "$dir/abort"
      echo 137 > "$dir/status"
      echo OK
      exit
    fi
    touch "$dir/abort"
    terminate
    # Cover an abort racing runc's atomic pid publication.
    (for _ in $(seq 1 300); do
      [ ! -f "$dir/status" ] || break
      if [ -f "$dir/pid" ]; then terminate; break; fi
      sleep 0.1
    done) </dev/null >/dev/ttyS0 2>&1 &
    echo OK
    exit ;;
  SIGNAL)
    case "$size" in ''|*[!0-9]*) fail signal invalid-signal ;; esac
    [ "$size" -le 64 ] || fail signal invalid-signal
    [ -f "$dir/pid" ] && [ ! -f "$dir/status" ] || fail signal session-not-running
    case "$tty" in 0) all='' ;; 1) all=--all ;; *) fail signal invalid-all ;; esac
    if [ "$port" = 1028 ]; then
      /usr/bin/runc --root /run/runc kill $all workload "$size" 2>/dev/ttyS0 || fail signal runc-kill-failed
    else
      kill -"$size" "$(cat "$dir/pid")" || fail signal exec-kill-failed
    fi
    echo OK
    exit ;;
  PAUSE|RESUME)
    # docker pause and unpause (ADR 0011 slice 5): the workload's cgroup freezer, as runc does on the host. Pausing
    # the microVM's vCPUs instead left Firecracker taking no new vsock connection after the resume (D-090).
    [ "$port" = 1028 ] || fail "$op" workload-only
    [ -f "$dir/pid" ] && [ ! -f "$dir/status" ] || fail "$op" session-not-running
    if [ "$op" = PAUSE ]; then
      /usr/bin/runc --root /run/runc pause workload 2>/dev/ttyS0 || fail pause runc-pause-failed
    else
      /usr/bin/runc --root /run/runc resume workload 2>/dev/ttyS0 || fail resume runc-resume-failed
    fi
    echo OK
    exit ;;
  RESIZE)
    /usr/bin/vesper-console resize "$dir" "$size" "$tty" 2>/dev/ttyS0 || fail resize resize-failed
    echo OK
    exit ;;
  RELEASE)
    # An ended exec session's directory goes, so the shim can give its ports to a new exec (TD-041). The workload's
    # own session is never released; a session that has not ended is refused.
    [ "$port" != 1028 ] || fail release workload-session
    [ -d "$dir" ] || { echo OK; exit; }
    [ -f "$dir/status" ] || fail release session-running
    # The session's own process ends right after its EXIT line, killing its relays; give it 3 s.
    if [ -f "$dir/session" ]; then
      for _ in $(seq 1 30); do kill -0 "$(cat "$dir/session")" 2>/dev/null || break; sleep 0.1; done
      ! kill -0 "$(cat "$dir/session")" 2>/dev/null || fail release session-still-running
    fi
    rm -rf "$dir" || fail release remove-failed
    echo OK
    exit ;;
  RUN|EXEC) ;;
  *) fail request unknown-operation ;;
esac
case "$size" in ''|*[!0-9]*) fail request invalid-size ;; esac
[ "$size" -gt 0 ] && [ "$size" -le 1048576 ] || fail request invalid-size
case "$tty" in 0|1) ;; *) fail request invalid-terminal ;; esac
mkdir "$dir" || fail start duplicate-session
echo $$ > "$dir/session"
relays=''; runner=''
trap '[ -f "$dir/status" ] || { touch "$dir/abort"; terminate; [ -n "$runner" ] || echo 137 > "$dir/status"; }; kill $relays 2>/dev/null || true; [ "$op" != RUN ] || /usr/bin/vesper-console shares unmount "$dir" > /dev/ttyS0 2>&1 || true' EXIT
head -c "$size" > "$dir/config.json"
[ "$(wc -c < "$dir/config.json")" = "$size" ] || fail start truncated-config
# The task's host shares (ADR 0009, GH #160 M4): NFS mounts under its root before it starts, from the share list in
# its config. EXEC sessions run inside the task and see its mounts already.
if [ "$op" = RUN ]; then
  why=$(/usr/bin/vesper-console shares mount "$dir" 2>/dev/ttyS0) || fail shares "$(printf '%s' "$why" | tr -d '"\\' | tr '\n' ' ' | head -c 300)"
fi
# A Docker task's resolv.conf, hosts and hostname, bound from files/ by its config (ADR 0011 §4).
if [ "$op" = RUN ]; then
  why=$(/usr/bin/vesper-console files "$dir" 2>/dev/ttyS0) || fail files "$(printf '%s' "$why" | tr -d '"\\' | tr '\n' ' ' | head -c 300)"
fi
# The guest's root is its initramfs, where pivot_root is refused: a task with its own mount namespace (a Docker
# task, ADR 0011) is jailed by runc with a move and a chroot instead. The microVM is the boundary (CE-0004).
# A non-root task sees its shares as the share server answers its uid (TD-097): the mounts above ran as root.
[ "$op" != RUN ] || /usr/bin/vesper-console shares refresh "$dir" 2>/dev/ttyS0 || true
nopivot=''
grep -q '"type":"mount"' "$dir/config.json" && nopivot=--no-pivot
mkfifo "$dir/in" "$dir/out" "$dir/err"
socat -u VSOCK-LISTEN:$port,reuseaddr OPEN:$dir/in,wronly > /dev/null 2>/dev/ttyS0 & relays="$relays $!"
socat -u OPEN:$dir/out,rdonly VSOCK-LISTEN:$((port+1)),reuseaddr > /dev/null 2>/dev/ttyS0 & relays="$relays $!"
socat -u OPEN:$dir/err,rdonly VSOCK-LISTEN:$((port+2)),reuseaddr > /dev/null 2>/dev/ttyS0 & relays="$relays $!"
echo "READY $port"
(
  set +e
  [ ! -f "$dir/abort" ] || { echo 137 > "$dir/status"; exit 0; }
  echo "VESPER-RUNC-INVOKE p$port $op" > /dev/ttyS0
  if [ "$tty" = 1 ]; then
    /usr/bin/vesper-console "$op" "$dir"
  elif [ "$op" = RUN ]; then
    /usr/bin/runc --root /run/runc --log "$dir/runc.log" --log-format json run $nopivot --pid-file "$dir/pid" --bundle "$dir" workload
  else
    /usr/bin/runc --root /run/runc --log "$dir/runc.log" --log-format json exec --pid-file "$dir/pid" --process "$dir/config.json" workload
  fi
  rc=$?
  # The microVM is stopped without a shutdown once its task has exited, so what the workload wrote is put on the
  # drive first: a Docker task's drive outlives the task (ADR 0011 §5).
  sync
  echo "$rc" > "$dir/status"
  echo "VESPER-WORKLOAD-EXIT $rc p$port" > /dev/ttyS0
) < "$dir/in" > "$dir/out" 2> "$dir/err" &
runner=$!
# An unsuccessful runtime must still publish its status (the subshell disables errexit). Every 20 ms for up to 30 s:
# a 0.1 s poll added about 50 ms to each start on average (TD-100 G1).
for _ in $(seq 1 1500); do
  [ -f "$dir/pid" ] && break
  if [ -f "$dir/status" ]; then
    [ -s "$dir/runc.log" ] || fail runtime runtime-did-not-start
    cat "$dir/runc.log" > /dev/ttyS0
    printf 'ERROR '
    tail -n 1 "$dir/runc.log"
    exit 1
  fi
  sleep 0.02
done
[ -f "$dir/pid" ] || fail start runtime-timeout
[ ! -f "$dir/abort" ] || { terminate; fail start aborted; }
echo "STARTED $(cat "$dir/pid")"
wait "$runner"
# Drain both output bridges before reporting exit; stdin may remain open for a detached task.
set -- $relays
wait "$2" || true
wait "$3" || true
# Unmount before EXIT, so the writes the guest still buffers reach the server first (ADR 0009, Lifecycle).
[ "$op" = RUN ] && { /usr/bin/vesper-console shares unmount "$dir" > /dev/ttyS0 2>&1 || true; }
echo "EXIT $(cat "$dir/status")"
