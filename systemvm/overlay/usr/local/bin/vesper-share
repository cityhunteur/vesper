#!/bin/sh
# virtio-fs shares from the host (GH #29): the launcher exposes each shared host directory as a virtio-fs
# tag; this mounts it at the same absolute path so Docker bind mounts name host paths unchanged.
# usage: vesper-share mount TAG PATH [ro|rw]   MOUNTED TAG PATH mode=<ro|rw> (idempotent) or ERR …
#        vesper-share list                     one line per mount: SHARE TAG PATH mode=<ro|rw>
#        vesper-share umount PATH              UNMOUNTED PATH or ERR
#        vesper-share probe TAG PATH           modules, tag presence and mount state as key=value words
#        vesper-share touch PATH...            replay a host-side edit (GH #150): refreshes the guest's cached
#                                              attributes with an atime-only set, then writes each path's mtime
#                                              back so the guest kernel emits inotify IN_MODIFY; one line per
#                                              path: TOUCHED|SKIPPED|MISSING|REJECTED|ERR <path> [reason]
#                                              (TOUCHED <path> raced: a host write landed between the two sets
#                                              and the mtime was set to now)
#        vesper-share notify                   the same for one absolute path per stdin line (the host watcher's
#                                              stream); greets VESPER-SHARE-NOTIFY 1, prints
#                                              NOTIFY touched= skipped= missing= rejected= errors= on EOF
# A path is touched only when its resolved location lies inside a read-write virtio-fs mount. File contents
# never change and nothing is created. The mtime stays that of the last host write, with two exceptions, and
# the atime and ctime change; see docs/SECURITY.md. VESPER_SHARE_MOUNTS overrides /proc/mounts (self-test only).
set -u
MOUNTS=${VESPER_SHARE_MOUNTS:-/proc/mounts}
NL='
'

tags() { cat /sys/fs/virtiofs/*/tag 2>/dev/null; }

mount_() {
  tag=${1:?}; path=${2:?}; mode=${3:-rw}
  case "$path" in /*) ;; *) echo "ERR path must be absolute: $path"; return 2 ;; esac
  /sbin/modprobe virtiofs 2>/dev/null
  if grep -q " $path virtiofs " /proc/mounts; then
    cur=$(grep " $path virtiofs " /proc/mounts | awk '{print $4}' | grep -q '^ro' && echo ro || echo rw)
    echo "MOUNTED $tag $path mode=$cur (already)"; return 0
  fi
  tags | grep -qx "$tag" || { echo "ERR virtio-fs tag $tag is not present (tags: $(tags | tr '\n' ' '))"; return 1; }
  mkdir -p "$path" || { echo "ERR cannot create $path"; return 1; }
  opts=""; [ "$mode" = ro ] && opts="-o ro"
  if out=$(mount -t virtiofs $opts "$tag" "$path" 2>&1); then
    echo "MOUNTED $tag $path mode=$mode"
  else
    echo "ERR mount $tag at $path failed: $out"; return 1
  fi
}

list() { awk '$3=="virtiofs" {m=($4 ~ /^ro/)?"ro":"rw"; print "SHARE", $1, $2, "mode=" m}' /proc/mounts; }

umount_() {
  path=${1:?}
  out=$(umount "$path" 2>&1) && echo "UNMOUNTED $path" || { echo "ERR umount $path: $out"; return 1; }
}

probe() {
  tag=${1:?}; path=${2:?}
  mod=$(grep -q '^virtiofs ' /proc/modules && echo loaded || echo absent)
  present=$(tags | grep -qx "$tag" && echo yes || echo no)
  mounted=$(grep -q " $path virtiofs " /proc/mounts && echo yes || echo no)
  echo "PROBE module=$mod tag_present=$present mounted=$mounted sysfs=$(ls -d /sys/fs/virtiofs 2>/dev/null | wc -l | tr -d ' ') inotifyd=$(command -v inotifyd >/dev/null && echo yes || echo no) notify=$(rc-service vesper-share-notify status >/dev/null 2>&1 && echo started || echo stopped)"
}

# virtio-fs mounts as "<ro|rw> <path>" lines, with the octal escapes of /proc/mounts (\040 for a space) decoded.
load_shares() {
  SHARES=$(awk '$3=="virtiofs" {m=($4 ~ /^ro(,|$)/)?"ro":"rw"; print m, $2}' "$MOUNTS" 2>/dev/null | while IFS= read -r l; do printf '%b\n' "$l"; done)
}

# Prints "<mode> <share>" for the mount that contains $1 ("root" as mode when $1 is the mount point itself).
share_of() {
  _ifs=$IFS; IFS=$NL
  set -f  # a mount point may contain *, ? or [: split on newlines only, never expand
  for l in $SHARES; do
    m=${l%% *}; s=${l#* }
    if [ "$1" = "$s" ]; then IFS=$_ifs; set +f; echo "root $s"; return 0; fi
    # Quoted, so the mount point is compared literally and only the trailing * is a pattern.
    case "$1" in "$s"/*) IFS=$_ifs; set +f; echo "$m $s"; return 0 ;; esac
  done
  IFS=$_ifs; set +f; return 1
}

# Sets RESULT to TOUCHED, SKIPPED, MISSING, REJECTED or ERR and REASON to a short word for one path.
touch_one() {
  p=$1; REASON=""
  case "$p" in /*) ;; *) RESULT=REJECTED; REASON=not-absolute; return ;; esac
  case "$p/" in */../*) RESULT=REJECTED; REASON=dotdot; return ;; esac
  rp=$(realpath "$p" 2>/dev/null) || { RESULT=MISSING; return; }
  [ -e "$rp" ] || { RESULT=MISSING; return; }
  hit=$(share_of "$rp") || { load_shares; hit=$(share_of "$rp"); } || { RESULT=REJECTED; REASON=outside-shares; return; }
  case "${hit%% *}" in
    root) RESULT=SKIPPED; REASON=share-root; return ;;
    ro) RESULT=SKIPPED; REASON=read-only-share; return ;;
  esac
  # The guest caches a file's attributes for about a second and learns nothing of host edits, so a plain
  # `touch -r` could write a stale mtime back and move the host's mtime backwards. An atime-only set comes
  # first: its reply carries the file's current attributes, so the mtime read next is the host's.
  touch -c -a -r "$rp" "$rp" 2>/dev/null || { RESULT=ERR; REASON=touch-failed; return; }
  s1=$(size_of "$rp")
  if touch -c -m -r "$rp" "$rp" 2>/dev/null; then RESULT=TOUCHED; else RESULT=ERR; REASON=touch-failed; return; fi
  # A host write that landed between the two sets has had its mtime overwritten with the older one. The
  # second reply shows it as a size change; then set the mtime to now, which is never older than the write.
  [ "$(size_of "$rp")" = "$s1" ] || { touch -c -m "$rp" 2>/dev/null; RESULT=TOUCHED; REASON=raced; }
}

size_of() { stat -c %s "$1" 2>/dev/null || stat -f %z "$1" 2>/dev/null; }

touch_() {
  [ $# -gt 0 ] || { echo "ERR usage: vesper-share touch PATH..."; return 2; }
  load_shares; rc=0
  for p in "$@"; do
    touch_one "$p"; echo "$RESULT $p${REASON:+ $REASON}"
    case "$RESULT" in REJECTED|ERR) rc=1 ;; esac
  done
  return $rc
}

notify() {
  load_shares; touched=0; skipped=0; missing=0; rejected=0; errors=0
  echo "VESPER-SHARE-NOTIFY 1"
  while IFS= read -r p; do
    [ -n "$p" ] || continue
    touch_one "$p"
    case "$RESULT" in
      TOUCHED) touched=$((touched+1)) ;; SKIPPED) skipped=$((skipped+1)) ;; MISSING) missing=$((missing+1)) ;;
      REJECTED) rejected=$((rejected+1)) ;; *) errors=$((errors+1)) ;;
    esac
  done
  echo "NOTIFY touched=$touched skipped=$skipped missing=$missing rejected=$rejected errors=$errors"
}

cmd=${1:-}; shift 2>/dev/null
case "$cmd" in
  mount) mount_ "$@" ;;
  list) list ;;
  umount) umount_ "$@" ;;
  probe) probe "$@" ;;
  touch) touch_ "$@" ;;
  notify) notify ;;
  *) echo "ERR usage: vesper-share mount TAG PATH [ro|rw]|list|umount PATH|probe TAG PATH|touch PATH...|notify"; exit 2 ;;
esac
