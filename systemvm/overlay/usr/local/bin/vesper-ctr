#!/bin/sh
# Drive containerd (ctr) with the Vesper shim v2 runtime inside the System VM (GH #22).
# usage: vesper-ctr import                        docker save the trivial image into containerd; IMPORTED <ref>
#        vesper-ctr run NAME WORDS...             ctr run --rm … sh -c "WORDS"; prints RC <code> then OUT <line> per output line
#        vesper-ctr start NAME WORDS...           ctr run -d … sh -c "WORDS"; STARTED NAME pid=N
#        vesper-ctr state NAME                    STATE NAME <STATUS> pid=N
#        vesper-ctr kill NAME                     SIGKILL and wait for STOPPED; KILLED NAME
#        vesper-ctr delete NAME                   ctr task delete + container delete; DELETED NAME (or ERR …)
#        vesper-ctr try CTR-ARGS...               run any ctr command; prints RC <code> then OUT lines (for invalid sequences)
#        vesper-ctr leftovers                     CLEAN or DIRTY <what>
#        vesper-ctr import-layered                commit a second layer on the trivial image into containerd; IMPORTED <ref> layers=N
#        vesper-ctr run-image REF NAME WORDS...   like run, against any containerd image ref
#        vesper-ctr start-image REF NAME WORDS... like start, against any containerd image ref
#        vesper-ctr meta NAME                     the task's vesper-rootfs.json (one line) or ERR
#        vesper-ctr cache                         CACHE <n> then one line per cached root drive
#        vesper-ctr shim-pid NAME                 SHIMPID NAME <pid> (the containerd-shim-vesper-v2 process for NAME)
#        vesper-ctr kill-shim NAME                SIGKILL that shim; KILLED-SHIM NAME <pid>
#        vesper-ctr wait-gone NAME [TIMEOUT]      wait until ctr lists no task NAME; GONE NAME or ERR
#        vesper-ctr state-file NAME               the task's vesper-task.json line or ERR
#        vesper-ctr inflight-start NAME WORDS...  start `ctr run --rm` in the background; INFLIGHT NAME
#        vesper-ctr inflight-result NAME [T]      wait for it; RC <code> then OUT lines
#        vesper-ctr metrics NAME                  METRICS NAME memory_bytes=<n> cpu_usec=<n> pids=<n> from `ctr task metrics`
set -u
NS=vesper
RT=io.containerd.vesper.v2
IMAGE_TAG=vesper/trivial:guest
LAYERED_TAG=vesper/layered:guest
BUNDLES=/run/containerd/io.containerd.runtime.v2.task/$NS
CACHE=/var/lib/vesper/rootfs-cache
ctr_() { ctr -n "$NS" "$@"; }
ref() { ctr_ images ls -q 2>/dev/null | grep -F "${1:-$IMAGE_TAG}" | head -1; }

import_layered() {
  docker image inspect "$IMAGE_TAG" >/dev/null 2>&1 || /usr/local/bin/vesper-rootfs import-trivial >/dev/null 2>&1
  if ! docker image inspect "$LAYERED_TAG" >/dev/null 2>&1; then
    cid=$(docker create "$IMAGE_TAG" /bin/true) || { echo "ERR docker create failed"; return 1; }
    printf 'layer-two\n' > /tmp/layer2-marker
    docker cp /tmp/layer2-marker "$cid:/etc/layer2-marker" >/dev/null || { echo "ERR docker cp failed"; return 1; }
    docker commit "$cid" "$LAYERED_TAG" >/dev/null || { echo "ERR docker commit failed"; return 1; }
    docker rm -f "$cid" >/dev/null 2>&1
  fi
  r=$(ref "$LAYERED_TAG")
  if [ -z "$r" ]; then
    out=$(docker save "$LAYERED_TAG" | ctr_ images import - 2>&1) || { echo "ERR import failed: $(printf '%s' "$out" | tail -1)"; return 1; }
    r=$(ref "$LAYERED_TAG")
  fi
  [ -n "$r" ] || { echo "ERR layered image not in containerd"; return 1; }
  layers=$(docker image inspect --format '{{len .RootFS.Layers}}' "$LAYERED_TAG" 2>/dev/null)
  echo "IMPORTED $r layers=${layers:-?}"
}

meta() {
  name=${1:?}; f="$BUNDLES/$name/vesper-rootfs.json"
  [ -f "$f" ] || { echo "ERR no $f (task gone or never created)"; return 1; }
  tr -d '\n' < "$f" | tr -s ' '; echo
}

shim_pid() { pgrep -f "containerd-shim-vesper-v2 -namespace $NS -id ${1:?}" 2>/dev/null | head -1; }

shimpid() { name=${1:?}; p=$(shim_pid "$name"); [ -n "$p" ] || { echo "ERR no shim for $name"; return 1; }; echo "SHIMPID $name $p"; }

kill_shim() {
  name=${1:?}; p=$(shim_pid "$name"); [ -n "$p" ] || { echo "ERR no shim for $name"; return 1; }
  kill -9 "$p" 2>/dev/null || { echo "ERR kill failed"; return 1; }
  echo "KILLED-SHIM $name $p"
}

wait_gone() {
  name=${1:?}; t=${2:-20}; i=0
  while [ "$i" -lt "$((t * 4))" ]; do
    ctr_ task ls 2>/dev/null | awk -v n="$name" '$1==n' | grep -q . || { echo "GONE $name"; return 0; }
    sleep 0.25; i=$((i + 1))
  done
  echo "ERR task $name still listed after ${t}s"; return 1
}

state_file() {
  name=${1:?}; f="$BUNDLES/$name/vesper-task.json"
  [ -f "$f" ] || { echo "ERR no $f"; return 1; }
  cat "$f"; echo
}

inflight_start() {
  name=${1:?}; shift
  r=$(ref) || true; [ -n "$r" ] || { echo "ERR import first"; return 1; }
  rm -f "/tmp/inflight-$name.out" "/tmp/inflight-$name.rc"
  ( ctr_ run --rm --runtime "$RT" "$r" "$name" sh -c "$*" > "/tmp/inflight-$name.out" 2>&1; echo $? > "/tmp/inflight-$name.rc" ) </dev/null >/dev/null 2>&1 &
  for _ in $(seq 1 80); do ctr_ task ls 2>/dev/null | awk -v n="$name" '$1==n' | grep -q . && break; sleep 0.25; done
  echo "INFLIGHT $name"
}

inflight_result() {
  name=${1:?}; t=${2:-60}; i=0
  while [ "$i" -lt "$((t * 4))" ]; do [ -f "/tmp/inflight-$name.rc" ] && break; sleep 0.25; i=$((i + 1)); done
  [ -f "/tmp/inflight-$name.rc" ] || { echo "ERR ctr run $name still running after ${t}s"; return 1; }
  emit "$(cat "/tmp/inflight-$name.rc")" "$(cat "/tmp/inflight-$name.out")"
}

metrics() {
  name=${1:?}
  out=$(ctr_ task metrics --format json "$name" 2>&1) || { echo "ERR task metrics: $(printf '%s' "$out" | tail -1)"; return 1; }
  out=$(printf '%s' "$out" | tr -d ' \n\t')
  mem=$(printf '%s' "$out" | sed -n 's/.*"usage":\([0-9]*\).*/\1/p' | head -1)
  cpu=$(printf '%s' "$out" | sed -n 's/.*"usage_usec":\([0-9]*\).*/\1/p' | head -1)
  pids=$(printf '%s' "$out" | sed -n 's/.*"pids":{"current":\([0-9]*\).*/\1/p' | head -1)
  [ -n "$mem" ] && [ -n "$cpu" ] || { echo "ERR metrics lack memory/cpu: $(printf '%s' "$out" | tr -d '\n' | cut -c1-200)"; return 1; }
  echo "METRICS $name memory_bytes=$mem cpu_usec=$cpu pids=${pids:-?}"
}

cache() {
  n=$(ls "$CACHE"/*.ext4 2>/dev/null | wc -l | tr -d ' ')
  echo "CACHE $n"
  for f in "$CACHE"/*.ext4; do [ -f "$f" ] && echo "$(basename "$f" .ext4) bytes=$(stat -c %s "$f") sha256=$(cut -c1-16 "$f.sha256" 2>/dev/null)"; done
  return 0
}

import() {
  docker image inspect "$IMAGE_TAG" >/dev/null 2>&1 || /usr/local/bin/vesper-rootfs import-trivial >/dev/null 2>&1
  r=$(ref)
  if [ -z "$r" ]; then
    out=$(docker save "$IMAGE_TAG" | ctr_ images import - 2>&1) || { echo "ERR import failed: $(printf '%s' "$out" | tail -1)"; return 1; }
    r=$(ref)
  fi
  [ -n "$r" ] || { echo "ERR image not in containerd after import"; return 1; }
  echo "IMPORTED $r"
}

emit() { # RC then OUT lines from a captured output
  echo "RC $1"
  printf '%s\n' "$2" | sed '/^$/d; s/^/OUT /'
}

run() { run_image "$(ref)" "$@"; }
start() { start_image "$(ref)" "$@"; }

run_image() {
  r=${1:-}; name=${2:?}; shift 2
  [ -n "$r" ] || { echo "ERR import first"; return 1; }
  out=$(ctr_ run --rm --runtime "$RT" "$r" "$name" sh -c "$*" 2>&1); rc=$?
  emit "$rc" "$out"
}

start_image() {
  r=${1:-}; name=${2:?}; shift 2
  [ -n "$r" ] || { echo "ERR import first"; return 1; }
  out=$(ctr_ run -d --runtime "$RT" "$r" "$name" sh -c "$*" 2>&1) || { echo "ERR start failed: $(printf '%s' "$out" | tail -1)"; return 1; }
  pid=$(ctr_ task ls 2>/dev/null | awk -v n="$name" '$1==n {print $2}')
  echo "STARTED $name pid=${pid:-0}"
}

state() {
  name=${1:?}
  line=$(ctr_ task ls 2>/dev/null | awk -v n="$name" '$1==n {print $3, $2}')
  [ -n "$line" ] || { echo "STATE $name ABSENT pid=0"; return 1; }
  echo "STATE $name $(echo "$line" | awk '{print $1}') pid=$(echo "$line" | awk '{print $2}')"
}

kill_() {
  name=${1:?}
  out=$(ctr_ task kill -s KILL "$name" 2>&1) || { echo "ERR kill failed: $(printf '%s' "$out" | tail -1)"; return 1; }
  i=0
  while [ "$i" -lt 100 ]; do
    st=$(ctr_ task ls 2>/dev/null | awk -v n="$name" '$1==n {print $3}')
    [ "$st" = "STOPPED" ] && { echo "KILLED $name"; return 0; }
    sleep 0.1; i=$((i + 1))
  done
  echo "ERR $name still ${st:-absent} 10 s after SIGKILL"; return 1
}

delete() {
  name=${1:?}
  out=$(ctr_ task delete "$name" 2>&1) || { echo "ERR task delete: $(printf '%s' "$out" | tail -1)"; return 1; }
  out=$(ctr_ container delete "$name" 2>&1) || { echo "ERR container delete: $(printf '%s' "$out" | tail -1)"; return 1; }
  echo "DELETED $name"
}

try() {
  out=$(ctr_ "$@" 2>&1); rc=$?
  emit "$rc" "$out"
}

leftovers() {
  what=""
  # uid 10000: the shim's microVMs only; vesperd microVMs run as uid 20000 (ADR 0007).
  n=$(pgrep -u 10000 -f "firecracker --id " 2>/dev/null | wc -l | tr -d ' '); [ "$n" = 0 ] || what="$what firecracker=$n"
  n=$(pgrep -f containerd-shim-vesper-v2 2>/dev/null | wc -l | tr -d ' '); [ "$n" = 0 ] || what="$what shims=$n"
  n=$(ls -d /srv/jailer/firecracker/*/ 2>/dev/null | wc -l | tr -d ' '); [ "$n" = 0 ] || what="$what jails=$n"
  # Share networks (ADR 0009): a namespace or a launch record with no microVM left is a leak.
  n=$(ls /run/vesper/microvm/netns 2>/dev/null | wc -l | tr -d ' '); [ "$n" = 0 ] || what="$what sharenets=$n"
  n=$(ls /run/vesper/microvm/records 2>/dev/null | wc -l | tr -d ' '); [ "$n" = 0 ] || what="$what sharerecords=$n"
  n=$(ctr_ task ls 2>/dev/null | tail -n +2 | wc -l | tr -d ' '); [ "$n" = 0 ] || what="$what tasks=$n"
  n=$(ctr_ containers ls -q 2>/dev/null | wc -l | tr -d ' '); [ "$n" = 0 ] || what="$what containers=$n"
  if [ -z "$what" ]; then echo CLEAN; else echo "DIRTY$what"; return 1; fi
}


run_stdio() {
  name=${1:?}; r=$(ref)
  out=/tmp/exec-$name.out; err=/tmp/exec-$name.err
  printf 'stdin-roundtrip\n' | ctr_ run --rm --runtime "$RT" "$r" "$name" /bin/sh -c 'cat; echo stderr-only >&2; exit 7' > "$out" 2> "$err"
  rc=$?
  echo "RC $rc"
  sed 's/^/OUT /' "$out"
  sed 's/^/ERR /' "$err"
}

exec_() {
  name=${1:?}; id=${2:?}
  out=$(ctr_ task exec --exec-id "$id" "$name" /bin/busybox sh -c 'echo exec-output; echo exec-stderr >&2; exit 7' 2>&1); rc=$?
  emit "$rc" "$out"
}

signal_test() {
  name=${1:?}; signal=${2:?}; trap_mode=${3:-plain}
  command='exec sleep 300'
  if [ "$trap_mode" = trap ]; then command="trap 'echo TERM-caught; exit 0' TERM; echo signal-ready; while :; do sleep 0.1; done"; fi
  inflight_start "$name" "$command" >/dev/null
  ready=0
  for _ in $(seq 1 200); do
    # The durable running transition is written after runc publishes its pid.
    if grep -q '"phase":"running"' "$BUNDLES/$name/vesper-task.json" 2>/dev/null; then ready=1; break; fi
    sleep 0.1
  done
  [ "$ready" = 1 ] || { echo 'ERR task did not start'; return 1; }
  if [ "$trap_mode" = trap ]; then
    for _ in $(seq 1 100); do grep -q signal-ready "/tmp/inflight-$name.out" && break; sleep 0.1; done
    grep -q signal-ready "/tmp/inflight-$name.out" || { echo 'ERR trap not ready'; return 1; }
  fi
  ctr_ task kill -s "$signal" "$name" || return 1
  inflight_result "$name" 30
}

run_tty() {
  name=${1:?}; mode=${2:-run}; r=$(ref)
  if [ "$mode" = exec ]; then
    out=$(vesper-ptyrun 37 101 ctr -n "$NS" task exec --tty --exec-id tty-exec "$name" /bin/busybox sh -c 'tty; echo BEFORE; stty size; sleep 5; echo AFTER; stty size; exit 7' 2>&1)
  else
    out=$(vesper-ptyrun 37 101 ctr -n "$NS" run --rm --tty --runtime "$RT" "$r" "$name" /bin/busybox sh -c 'tty; echo BEFORE; stty size; sleep 2; echo AFTER; stty size; exit 7' 2>&1)
  fi
  rc=$?
  emit "$rc" "$out"
}

interactive() {
  name=${1:?}; r=$(ref)
  out=$(printf 'echo interactive-ok; exit 7\n' | vesper-ptyrun 37 101 ctr -n "$NS" run --rm --tty --runtime "$RT" "$r" "$name" /bin/sh 2>&1)
  rc=$?
  emit "$rc" "$out"
}

run_orphan() {
  name=${1:?}; mode=${2:-plain}; r=$(ref)
  if [ "$mode" = tty ]; then
    out=$(vesper-ptyrun 37 101 ctr -n "$NS" run --rm --tty --runtime "$RT" "$r" "$name" /bin/sh -c 'sleep 300 & echo orphan-started; exit 7' 2>&1); rc=$?
    emit "$rc" "$out"
  else
    run_image "$r" "$name" 'sleep 300 & echo orphan-started; exit 7'
  fi
}

exit_with_exec() {
  name=${1:?}
  inflight_start "$name" 'echo init-ready; sleep 3; exit 7' >/dev/null
  for _ in $(seq 1 100); do grep -q init-ready "/tmp/inflight-$name.out" && break; sleep 0.1; done
  ctr_ task exec --detach --exec-id orphan-exec "$name" /bin/busybox sleep 300 || return 1
  inflight_result "$name" 20
}

exec_signal() {
  name=${1:?}
  rm -f /tmp/vesper-exec-signal.rc
  (ctr_ task exec --exec-id signal-exec "$name" /bin/busybox sh -c 'echo exec-signal-ready; exec /bin/busybox sleep 300' >/tmp/vesper-exec-signal.out 2>&1; echo $? >/tmp/vesper-exec-signal.rc) </dev/null >/dev/null 2>&1 &
  ready=0
  for _ in $(seq 1 100); do
    if grep -q exec-signal-ready /tmp/vesper-exec-signal.out; then ready=1; break; fi
    sleep 0.1
  done
  [ "$ready" = 1 ] || { echo 'ERR exec not running'; return 1; }
  ctr_ task kill --exec-id signal-exec -s KILL "$name" || return 1
  for _ in $(seq 1 100); do [ -f /tmp/vesper-exec-signal.rc ] && break; sleep 0.1; done
  [ -f /tmp/vesper-exec-signal.rc ] || { echo 'ERR exec did not exit'; return 1; }
  emit "$(cat /tmp/vesper-exec-signal.rc)" "$(cat /tmp/vesper-exec-signal.out)"
}

cmd=${1:-}; shift 2>/dev/null
case "$cmd" in
  import) import ;;
  run-orphan) run_orphan "$@" ;;
  exit-with-exec) exit_with_exec "$@" ;;
  exec-signal) exec_signal "$@" ;;
  interactive) interactive "$@" ;;
  run-tty) run_tty "$@" ;;
  exec-tty) run_tty "$1" exec ;;
  run-stdio) run_stdio "$@" ;;
  exec) exec_ "$@" ;;
  signal-test) signal_test "$@" ;;
  run) run "$@" ;;
  start) start "$@" ;;
  state) state "$@" ;;
  kill) kill_ "$@" ;;
  delete) delete "$@" ;;
  try) try "$@" ;;
  leftovers) leftovers ;;
  import-layered) import_layered ;;
  run-image) run_image "$@" ;;
  start-image) start_image "$@" ;;
  meta) meta "$@" ;;
  cache) cache ;;
  metrics) metrics "$@" ;;
  shim-pid) shimpid "$@" ;;
  kill-shim) kill_shim "$@" ;;
  wait-gone) wait_gone "$@" ;;
  state-file) state_file "$@" ;;
  inflight-start) inflight_start "$@" ;;
  inflight-result) inflight_result "$@" ;;
  *) echo "ERR usage: vesper-ctr import|run|start|state|kill|delete|try|leftovers"; exit 2 ;;
esac
