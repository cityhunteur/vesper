#!/bin/sh
# One Docker relay connection (spawned by socat EXEC from vesper-docker-relay): the macOS host's vesper-proxy
# reaches dockerd's socket through it. A peer that is not the macOS host (CID 2) is turned away before anything
# reaches dockerd (ADR 0010, council finding 20): a container without a seccomp filter can open a vsock socket.
. "$(dirname "$0")/../lib/vesper/vsock-peer.sh"
vsock_host_only
# -t: see vesper-docker-relay; a half-closed client still receives the whole response (GH #167).
exec /usr/bin/socat -t 86400 STDIO UNIX-CONNECT:/var/run/docker.sock
