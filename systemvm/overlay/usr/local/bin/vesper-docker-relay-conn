#!/bin/sh
# One Docker relay connection (spawned by socat EXEC from vesper-docker-relay): the macOS host's vesper-proxy
# reaches dockerd's socket through it. A peer that is not the macOS host (CID 2) is turned away before anything
# reaches dockerd (ADR 0010, council finding 20): a container without a seccomp filter can open a vsock socket.
. "$(dirname "$0")/../lib/vesper/vsock-peer.sh"
vsock_host_only
# vesper-stream-relay, not socat (TD-093): a half-closed client still receives the whole response (GH #167), and
# when dockerd ends the stream (it exited, or closed the connection) the host sees the end at once. socat with an
# STDIO address kept the stream open until the client closed too, which hung `docker events` and the port publisher.
exec /usr/bin/vesper-stream-relay unix /var/run/docker.sock
