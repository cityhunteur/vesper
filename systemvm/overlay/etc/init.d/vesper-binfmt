#!/sbin/openrc-run
# Cross-architecture execution (GH #39): register the pinned qemu-user interpreters with binfmt_misc using
# the fix-binary flag (F), so a container whose rootfs has no qemu still runs; O (open binary) and C (use the
# interpreter's credentials) keep setuid semantics sane. Only interpreters that are installed get registered.
description="Vesper binfmt_misc registration for qemu-user (cross-architecture containers)"

depend() {
  need localmount vesper-packages
}

start() {
  ebegin "Registering qemu-user interpreters with binfmt_misc"
  [ -d /proc/sys/fs/binfmt_misc ] || modprobe binfmt_misc 2>/dev/null
  mountpoint -q /proc/sys/fs/binfmt_misc || mount -t binfmt_misc binfmt_misc /proc/sys/fs/binfmt_misc 2>/dev/null
  [ -f /proc/sys/fs/binfmt_misc/register ] || { eend 1 "binfmt_misc is not available"; return 1; }
  registered=0
  # x86_64 ELF: magic 7f 45 4c 46 02 01 01 00 .. .. .. .. .. .. .. .. 02 00 3e 00 with the standard mask.
  if [ -x /usr/bin/qemu-x86_64 ] && [ ! -f /proc/sys/fs/binfmt_misc/qemu-x86_64 ]; then
    printf ':qemu-x86_64:M::\\x7fELF\\x02\\x01\\x01\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x00\\x02\\x00\\x3e\\x00:\\xff\\xff\\xff\\xff\\xff\\xfe\\xfe\\x00\\xff\\xff\\xff\\xff\\xff\\xff\\xff\\xff\\xfe\\xff\\xff\\xff:/usr/bin/qemu-x86_64:OCF\n' > /proc/sys/fs/binfmt_misc/register 2>/dev/null && registered=$((registered + 1))
  fi
  echo "vesper: binfmt_misc registered ${registered} interpreter(s)" > /dev/console
  eend 0
}

stop() {
  for f in /proc/sys/fs/binfmt_misc/qemu-*; do [ -f "$f" ] && echo -1 > "$f"; done
  return 0
}
