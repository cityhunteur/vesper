#!/sbin/openrc-run
# Expose the guest Docker socket on a vsock port for vesper-proxy. The raw
# /var/run/docker.sock and containerd socket stay inside the guest; only this
# relay is reachable from the host, through the launcher's bridge.
description="Vesper Docker socket relay (vsock)"
supervisor=supervise-daemon
relay_port="${VESPER_DOCKER_PORT:-2375}"
command=/usr/bin/socat
# -t: after one side half-closes (an attach with no stdin, an HTTP client that shuts its write side), keep
# relaying the other direction until it closes too; socat's default ends the connection 0.5 s later (GH #167).
# Each connection runs vesper-docker-relay-conn, which serves the macOS host only. max-children bounds the
# connections held at once (a streamed attach, logs -f or events holds one for its lifetime); past it socat stops
# accepting until one ends, so a flood waits rather than exhausting the System VM (ADR 0010, council finding 20).
command_args="-t 86400 VSOCK-LISTEN:${relay_port},reuseaddr,fork,max-children=256 EXEC:/usr/local/bin/vesper-docker-relay-conn"
respawn_delay=1
respawn_max=0

depend() {
  need localmount vesper-packages vesper-services
}
