#!/sbin/openrc-run
# System VM gateway for published container ports (GH #28): vesper-proxy connects through the
# launcher's bridge to this vsock port, sends "PORT <n>", and is forwarded to the guest loopback port
# that dockerd published. No container or host port is reachable without this explicit hop.
description="Vesper published-port relay (vsock)"
supervisor=supervise-daemon
relay_port="${VESPER_PORT_RELAY:-2400}"
command=/usr/bin/socat
# -t: after one side half-closes (an attach with no stdin, an HTTP client that shuts its write side), keep
# relaying the other direction until it closes too; socat's default ends the connection 0.5 s later (GH #167).
# max-children: as for vesper-docker-relay, past 256 open connections socat waits for one to end.
command_args="-t 86400 VSOCK-LISTEN:${relay_port},reuseaddr,fork,max-children=256,backlog=128 EXEC:/usr/local/bin/vesper-port-relay-conn"
respawn_delay=1
respawn_max=0

depend() {
  need localmount vesper-packages vesper-services
}

# The System VM's own services are protected from the OOM killer, so that guests reaching their shared memory cap
# never take them (D-107). OpenRC runs this in the shell that then starts supervise-daemon, which passes the score to
# the service and to every respawn of it.
start_pre() {
  echo -900 > /proc/self/oom_score_adj
}
