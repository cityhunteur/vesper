#!/sbin/openrc-run
# Sink for host-side edit notifications on virtio-fs shares (GH #150): the launcher's FSEvents watcher
# connects to this vsock port and writes one absolute path per line; vesper-share replays each as a
# metadata-only touch so containers watching the bind mount get inotify events. It only touches paths
# inside read-write virtio-fs mounts, never creates files and never changes contents; it writes each
# path's own mtime back (docs/SECURITY.md gives the two exceptions).
description="Vesper share notification sink (vsock)"
supervisor=supervise-daemon
notify_port="${VESPER_SHARE_NOTIFY_PORT:-2401}"
command=/usr/bin/socat
# max-children bounds the handlers a caller can start; the launcher holds one connection.
command_args="-t 86400 VSOCK-LISTEN:${notify_port},reuseaddr,fork,max-children=4 EXEC:'/usr/local/bin/vesper-share notify'"
respawn_delay=1
respawn_max=0

depend() {
  need localmount vesper-packages
}
