#!/sbin/openrc-run
# Vesper guest agent on vsock: socat accepts every connection on the agent
# port and runs /usr/local/bin/vesper-agent for it. Supervised by
# supervise-daemon so a crash is restarted without manual intervention.
description="Vesper guest agent (vsock)"
supervisor=supervise-daemon
agent_port="${VESPER_AGENT_PORT:-1024}"
command=/usr/bin/socat
# -t: after one side half-closes, keep relaying the other direction until it closes too; socat's default
# ends the connection 0.5 s later (GH #167).
command_args="-t 86400 VSOCK-LISTEN:${agent_port},reuseaddr,fork EXEC:/usr/local/bin/vesper-agent"
respawn_delay=1
respawn_max=0

depend() {
  need localmount vesper-packages
}
