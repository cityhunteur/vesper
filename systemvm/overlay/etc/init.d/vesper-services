#!/sbin/openrc-run
# Start the runtime daemons that arrive with the pinned packages (their OpenRC
# scripts do not exist when the default runlevel is computed, so they cannot
# be runlevel symlinks). containerd and docker are supervised by
# supervise-daemon (respawn on crash) and log to /var/log/<name>.log.
description="Vesper runtime services (containerd, docker)"

depend() {
  need localmount vesper-packages
}

start() {
  ebegin "Starting Vesper runtime services (in the background)"
  for svc in containerd docker; do
    if [ ! -x "/etc/init.d/$svc" ]; then
      echo "vesper: service $svc is missing" > /dev/console
      eend 1
      return 1
    fi
  done
  mkdir -p /run/vesper
  # TAP devices (microVM networks, TD-032; the upstream suite, GH #173) need /dev/net/tun.
  modprobe tun 2>/dev/null || echo "vesper: modprobe tun failed" > /dev/console
  # Detached so the default runlevel (and the login prompt) does not wait for dockerd;
  # /run/vesper/services-ready marks completion and the probe and HEALTH wait for it.
  # A clean environment: inside a runlevel change rc-service would only schedule the start.
  env -i PATH=/sbin:/usr/sbin:/bin:/usr/bin setsid sh -c '
    # networking (eth0 DHCP, provides "net" for docker) runs here, not in the boot runlevel,
    # so its DHCP wait does not delay the login prompt either.
    if rc-service networking start > /dev/null 2>&1; then
      touch /run/vesper/net-ready
      echo "vesper: networking up" > /dev/console
    else
      echo "vesper: networking failed to start" > /dev/console
      exit 1
    fi
    # The persistent data disk (GH #164) must be mounted before containerd and dockerd open their state.
    echo "vesper: $(/usr/local/bin/vesper-data mount 2>&1 | tail -1)" > /dev/console
    for svc in containerd docker; do
      if out="$(rc-service "$svc" start 2>&1)"; then
        echo "vesper: service $svc started" > /dev/console
      else
        echo "vesper: service $svc failed to start: $(printf "%s" "$out" | tail -2 | tr "\n" " ")" > /dev/console
        exit 1
      fi
    done
    touch /run/vesper/services-ready
  ' < /dev/null > /dev/null 2>&1 &
  eend 0
}

stop() {
  ebegin "Stopping Vesper runtime services"
  env -i PATH=/sbin:/usr/sbin:/bin:/usr/bin rc-service docker stop >/dev/null 2>&1 || true
  env -i PATH=/sbin:/usr/sbin:/bin:/usr/bin rc-service containerd stop >/dev/null 2>&1 || true
  /usr/local/bin/vesper-data stop >/dev/null 2>&1 || true
  rm -f /run/vesper/services-ready
  eend 0
}
