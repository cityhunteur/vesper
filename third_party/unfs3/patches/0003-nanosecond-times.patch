Vesper patch 3 of 3 (TD-066): file times are kept and reported to the nanosecond.

SETATTR set times with utime() (whole seconds) and every attribute reply sent nseconds 0. set_time now uses
utimensat (UTIME_NOW for the server's time, UTIME_OMIT for an unchanged time), replies carry st_*tim.tv_nsec, and
FSINFO's time_delta is 1 ns so a client does not round the times it sets.

--- a/attr.c
+++ b/attr.c
@@ -98,9 +98,9 @@
 
     result.pre_op_attr_u.attributes.size = st_cache.st_size;
     result.pre_op_attr_u.attributes.mtime.seconds = st_cache.st_mtime;
-    result.pre_op_attr_u.attributes.mtime.nseconds = 0;
+    result.pre_op_attr_u.attributes.mtime.nseconds = st_cache.st_mtim.tv_nsec;
     result.pre_op_attr_u.attributes.ctime.seconds = st_cache.st_ctime;
-    result.pre_op_attr_u.attributes.ctime.nseconds = 0;
+    result.pre_op_attr_u.attributes.ctime.nseconds = st_cache.st_ctim.tv_nsec;
 
     return result;
 }
@@ -210,11 +210,11 @@
     result.post_op_attr_u.attributes.fileid = buf.st_ino;
 #endif
     result.post_op_attr_u.attributes.atime.seconds = buf.st_atime;
-    result.post_op_attr_u.attributes.atime.nseconds = 0;
+    result.post_op_attr_u.attributes.atime.nseconds = buf.st_atim.tv_nsec;
     result.post_op_attr_u.attributes.mtime.seconds = buf.st_mtime;
-    result.post_op_attr_u.attributes.mtime.nseconds = 0;
+    result.post_op_attr_u.attributes.mtime.nseconds = buf.st_mtim.tv_nsec;
     result.post_op_attr_u.attributes.ctime.seconds = buf.st_ctime;
-    result.post_op_attr_u.attributes.ctime.nseconds = 0;
+    result.post_op_attr_u.attributes.ctime.nseconds = buf.st_ctim.tv_nsec;
 
     return result;
 }
@@ -283,33 +283,39 @@
  */
 static nfsstat3 set_time(const char *path, backend_statstruct buf, sattr3 new)
 {
-    time_t new_atime, new_mtime;
-    struct utimbuf utim;
+    struct timespec ts[2];
     int res;
 
-    /* set atime and mtime */
+    (void) buf;
+
+    /* set atime and mtime, to the nanosecond (utime() kept whole seconds) */
     if (new.atime.set_it != DONT_CHANGE || new.mtime.set_it != DONT_CHANGE) {
 
 	/* compute atime to set */
-	if (new.atime.set_it == SET_TO_SERVER_TIME)
-	    new_atime = time(NULL);
-	else if (new.atime.set_it == SET_TO_CLIENT_TIME)
-	    new_atime = new.atime.set_atime_u.atime.seconds;
-	else			       /* DONT_CHANGE */
-	    new_atime = buf.st_atime;
+	if (new.atime.set_it == SET_TO_SERVER_TIME) {
+	    ts[0].tv_sec = 0;
+	    ts[0].tv_nsec = UTIME_NOW;
+	} else if (new.atime.set_it == SET_TO_CLIENT_TIME) {
+	    ts[0].tv_sec = new.atime.set_atime_u.atime.seconds;
+	    ts[0].tv_nsec = new.atime.set_atime_u.atime.nseconds % 1000000000;
+	} else {		       /* DONT_CHANGE */
+	    ts[0].tv_sec = 0;
+	    ts[0].tv_nsec = UTIME_OMIT;
+	}
 
 	/* compute mtime to set */
-	if (new.mtime.set_it == SET_TO_SERVER_TIME)
-	    new_mtime = time(NULL);
-	else if (new.mtime.set_it == SET_TO_CLIENT_TIME)
-	    new_mtime = new.mtime.set_mtime_u.mtime.seconds;
-	else			       /* DONT_CHANGE */
-	    new_mtime = buf.st_mtime;
+	if (new.mtime.set_it == SET_TO_SERVER_TIME) {
+	    ts[1].tv_sec = 0;
+	    ts[1].tv_nsec = UTIME_NOW;
+	} else if (new.mtime.set_it == SET_TO_CLIENT_TIME) {
+	    ts[1].tv_sec = new.mtime.set_mtime_u.mtime.seconds;
+	    ts[1].tv_nsec = new.mtime.set_mtime_u.mtime.nseconds % 1000000000;
+	} else {		       /* DONT_CHANGE */
+	    ts[1].tv_sec = 0;
+	    ts[1].tv_nsec = UTIME_OMIT;
+	}
 
-	utim.actime = new_atime;
-	utim.modtime = new_mtime;
-
-	res = backend_utime(path, &utim);
+	res = utimensat(AT_FDCWD, path, ts, 0);
 	if (res == -1)
 	    return setattr_err();
     }
--- a/nfs.c
+++ b/nfs.c
@@ -1054,8 +1054,10 @@
     result.FSINFO3res_u.resok.wtmult = 4096;
     result.FSINFO3res_u.resok.dtpref = 4096;
     result.FSINFO3res_u.resok.maxfilesize = ~0ULL;
-    result.FSINFO3res_u.resok.time_delta.seconds = backend_time_delta_seconds;
-    result.FSINFO3res_u.resok.time_delta.nseconds = 0;
+    /* times are kept to the nanosecond (attr.c), so a client need not
+       round the times it sets */
+    result.FSINFO3res_u.resok.time_delta.seconds = 0;
+    result.FSINFO3res_u.resok.time_delta.nseconds = 1;
     result.FSINFO3res_u.resok.properties = backend_fsinfo_properties;
 
     return &result;
