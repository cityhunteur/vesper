+/*
+ * Vesper: a handle whose path no longer leads to its object (it was
+ * renamed into another directory) misses the cache, whose entries are
+ * keyed on the path hashes, and fh_decomp_raw. Answer it with an entry
+ * for the same device and inode, but only one whose path lies in the
+ * export the handle came from: the handle's path hashes must begin with
+ * those of the export point that holds the entry's path. A descriptor
+ * kept open across a rename then still writes, and a handle from one
+ * export never resolves into another (bar an 8-bit hash collision of
+ * the two export roots).
+ */
+static char *fh_cache_lookup_moved(const unfs3_fh_t * fh)
+{
+    int i;
+    backend_statstruct buf;
+    char ep[NFS_MAXPATHLEN];
+    char *slash;
+    unfs3_fh_t efh;
+
+    for (i = 0; i < fh_cache_max + 1; i++) {
+	if (fh_cache[i].dev != fh->dev || fh_cache[i].ino != fh->ino ||
+	    fh_cache[i].path[0] == 0)
+	    continue;
+	if (backend_lstat(fh_cache[i].path, &buf) == -1 ||
+	    buf.st_dev != fh->dev || buf.st_ino != fh->ino)
+	    continue;
+	/* the export point that holds the entry's path */
+	strcpy(ep, fh_cache[i].path);
+	while (!export_point(ep)) {
+	    slash = strrchr(ep, '/');
+	    if (!slash || slash == ep) {
+		ep[0] = 0;
+		break;
+	    }
+	    *slash = 0;
+	}
+	if (!ep[0])
+	    continue;
+	efh = fh_comp_raw(ep, NULL, FH_ANY);
+	if (!fh_valid(efh) || efh.len > fh->len ||
+	    memcmp(efh.inos, fh->inos, efh.len) != 0)
+	    continue;
+	fh_cache[i].use = fh_cache_next();
+	fix_dir_times(fh_cache[i].path, &buf);
+	st_cache_valid = TRUE;
+	st_cache = buf;
+	fh_last_entry = i;
+	return fh_cache[i].path;
+    }
+    return NULL;
+}
