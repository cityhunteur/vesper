-	fh_cache_add(obj->dev, buf.st_ino, path);
+	/* the moved object's handle: the target directory's, extended */
+	obj = fh_extend(fh, buf.st_dev, buf.st_ino, 0);
+	if (obj)
+	    fh_cache_add(obj, path);
     }
 }
