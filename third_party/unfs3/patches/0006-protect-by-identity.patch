+}
+
+/*
+ * Vesper: objects that stay read-only whatever name reaches them.
+ *
+ * A read-only export that lies inside a read-write one was kept read-only
+ * by a mount on its name in the outer export. A client reaches the object
+ * under other names: in another letter case on a file system that ignores
+ * case, through a hard link or a symbolic link, or after it moved a
+ * directory above it into another export. So the object is known by its
+ * device and inode number. A request that changes something is refused
+ * (ROFS) when the object it names, or a directory above it, is such an
+ * object. The directory above is found with every symbolic link resolved,
+ * because this server follows links inside a path.
+ *
+ * The list is the file "<exports file>.protect". It is read at the first
+ * look, and what was added to it is read at every later look; it is read
+ * from the start again when it is another file or the exports were read
+ * again. A look is made before every request that changes something, at
+ * every request, and on every turn of the main loop:
+ *   p PATH      a path in the server's own root; the object there is
+ *               protected, and is looked up again at every look
+ *   i DEV INO   an object, by number
+ *   s DEV INO   an object that is about to be put at a p path, or a
+ *               directory that came to the path of a read-only directory
+ *               export on the host while the server runs, where no p
+ *               path names it
+ *   a DEV INO   an anchor: a directory on the way from the root of a
+ *               read-write export to a read-only export inside it
+ * This comment is the definition of the list; shim/internal/unfs/protect.go
+ * writes it. A line is one of the four kinds and ends in a newline. DEV
+ * and INO are decimal numbers with one space between them, a PATH starts
+ * with "/", and a line is at most NFS_MAXPATHLEN + 7 bytes with its
+ * newline. A last
+ * line with no newline is not whole yet and is left for the next look. A
+ * whole line of no kind, more i lines than PROT_FIXED, more p lines than
+ * PROT_PATHS or a line with a zero byte makes the list broken, and a broken
+ * list refuses every change and is read again from the start once a second.
+ * Without the file nothing is protected and nothing is looked up. More a
+ * lines than PROT_ANCHORS do not break the list: the anchor told longest ago
+ * goes, and the supervisor tells every current anchor again whenever one of
+ * them changed, so the current ones are the newest.
+ *
+ * An object once at a p path stays protected while the server runs, also
+ * after another object took its place there: a file that replaced a
+ * read-only file can be moved aside by a client, and is still what was
+ * bound read-only. The server does not learn such an object by looking at
+ * the right moment, which a client could prevent by keeping the server in
+ * one request: whoever puts an object at a p path first adds its s line to
+ * the list, with one write, and the server reads a list that has grown
+ * before it judges the next request. The objects of the s lines and those
+ * found at the p paths are remembered together, PROT_SEEN of them in all;
+ * when there are more, the one that was last told or found longest ago
+ * goes. A directory of the second kind of s line is at no p path, so the
+ * supervisor tells it again after every other object that it tells. A look
+ * at the p paths never drops an object that is at a p path; an s line can,
+ * and the look that follows it in the same refresh finds that object again
+ * before a request is judged.
+ */
+#define PROT_FIXED	256
+#define PROT_SEEN	768
+#define PROT_PATHS	64
+#define PROT_LINKS	40	/* as many links in a row as the kernel follows */
+#define PROT_ANCHORS	2048
+
+typedef struct { uint64 dev; uint64 ino; } prot_id;
+static prot_id prot_ids[PROT_FIXED];	/* the i entries */
+static int prot_fixed = 0;
+static prot_id prot_seen[PROT_SEEN];	/* what the p paths named, now or before */
+static int prot_nseen = 0;
+static unsigned long long prot_age[PROT_SEEN];	/* when each was last told or found: larger is newer */
+static unsigned long long prot_clock = 0;
+static char *prot_paths[PROT_PATHS];
+static int prot_np = 0;
+static int prot_loaded = FALSE;
+static int prot_broken = FALSE;	/* the list could not be read: refuse every change */
+static volatile int prot_stale = FALSE;
+static int prot_said = FALSE;
+static time_t prot_at = 0;	/* when a list that could not be read was last tried */
+/* the list file as it was read: which file, and how far (the end of its
+   last whole line), to see that it is another file or has grown */
+static int prot_have = FALSE;
+static ino_t prot_ino = 0;
+static off_t prot_off = 0;
+/*
+ * Anchors. A read-only export that lies inside a read-write one is reached
+ * by a chain of names: the directories from the read-write export's root
+ * down to it. A client that could rename or remove one of these directories
+ * could put another object at the read-only export's path: its supervisor
+ * would then serve that object, and so would the next start. So a client
+ * cannot rename an anchor, rename something in its place, or remove it, by
+ * any name. Only the directory itself is an anchor: what lies in it is not,
+ * and stays as writable as it was. The supervisor tells the anchors as it
+ * tells the s objects, and again when a directory on a chain was replaced on
+ * the host. PROT_ANCHORS are remembered; when there are more, the one told
+ * longest ago goes.
+ */
+static prot_id prot_anch[PROT_ANCHORS];
+static unsigned long long prot_anch_age[PROT_ANCHORS];
+static int prot_nanch = 0;
+
+/* how far the s and a lines of which list file were taken already: a list
+   that is read again from the start does not tell its old lines again, which
+   would put the objects' ages back to the order of the lines */
+static ino_t prot_told_ino = 0;
+static off_t prot_told = 0;
+
+/* called when the exports were read again, which may be in a signal
+   handler: only mark the list, and read it again at the next request */
+static void prot_forget(void)
+{
+	prot_stale = TRUE;
+}
+
+static int prot_among(const prot_id *ids, int n, uint64 dev, uint64 ino)
+{
+	int i;
+
+	for (i = 0; i < n; i++)
+		if (ids[i].ino == ino && ids[i].dev == dev)
+			return TRUE;
+	return FALSE;
+}
+
+/* remember an object that is, was or will be at a p path; cur are the
+   objects at the p paths now, which are not dropped to make room. An object
+   that is told or found again becomes the newest again: what counts is when
+   it was last at a place, not when it first was */
+static void prot_remember(uint64 dev, uint64 ino, const prot_id *cur, int ncur)
+{
+	int j, k;
+
+	for (j = 0; j < prot_nseen; j++) {
+		if (prot_seen[j].ino == ino && prot_seen[j].dev == dev) {
+			prot_age[j] = ++prot_clock;
+			return;
+		}
+	}
+	if (prot_nseen < PROT_SEEN) {
+		k = prot_nseen++;
+	} else {
+		/* full: drop the one that was last told or found longest ago
+		   and that no p path names now (there are more places than
+		   paths, so one is found) */
+		k = -1;
+		for (j = 0; j < PROT_SEEN; j++) {
+			if (prot_among(cur, ncur, prot_seen[j].dev, prot_seen[j].ino))
+				continue;
+			if (k < 0 || prot_age[j] < prot_age[k])
+				k = j;
+		}
+		if (k < 0)
+			return;
+	}
+	prot_seen[k].dev = dev;
+	prot_seen[k].ino = ino;
+	prot_age[k] = ++prot_clock;
+}
+
+/* remember an anchor; one that is told again is the newest again */
+static void prot_anchor(uint64 dev, uint64 ino)
+{
+	int j, k;
+
+	for (j = 0; j < prot_nanch; j++) {
+		if (prot_anch[j].ino == ino && prot_anch[j].dev == dev) {
+			prot_anch_age[j] = ++prot_clock;
+			return;
+		}
+	}
+	if (prot_nanch < PROT_ANCHORS) {
+		k = prot_nanch++;
+	} else {
+		k = 0;
+		for (j = 1; j < PROT_ANCHORS; j++)
+			if (prot_anch_age[j] < prot_anch_age[k])
+				k = j;
+	}
+	prot_anch[k].dev = dev;
+	prot_anch[k].ino = ino;
+	prot_anch_age[k] = ++prot_clock;
+}
+
+/* "DEV INO" and nothing else: two numbers with one space between */
+static int prot_pair(const char *s, uint64 *dev, uint64 *ino)
+{
+	char *end;
+	unsigned long long a, b;
+
+	if (*s < '0' || *s > '9')
+		return FALSE;
+	errno = 0;
+	a = strtoull(s, &end, 10);
+	if (errno || *end != ' ' || end[1] < '0' || end[1] > '9')
+		return FALSE;
+	b = strtoull(end + 1, &end, 10);
+	if (errno || *end != '\0')
+		return FALSE;
+	*dev = a;
+	*ino = b;
+	return TRUE;
+}
+
+/* read the whole lines of the list from where f stands, and move prot_off
+   past them; a last line that is not whole yet is left for the next look */
+static void prot_read(FILE *f)
+{
+	char line[NFS_MAXPATHLEN + 8];
+	uint64 dev, ino;
+	size_t len;
+
+	while (fgets(line, sizeof(line), f)) {
+		len = strlen(line);
+		if (len == 0 || line[len - 1] != '\n') {
+			/* at the end of the file: a line that is not whole
+			   yet. Anywhere else: longer than any line of the
+			   list, or with a zero byte in it */
+			if (!feof(f))
+				prot_broken = TRUE;
+			return;
+		}
+		prot_off += len;
+		line[--len] = '\0';
+		if (line[0] == 'i' && line[1] == ' ' && prot_pair(line + 2, &dev, &ino)) {
+			if (prot_fixed < PROT_FIXED) {
+				prot_ids[prot_fixed].dev = dev;
+				prot_ids[prot_fixed].ino = ino;
+				prot_fixed++;
+			} else
+				prot_broken = TRUE;	/* more numbers than fit: one would be lost */
+		} else if (line[0] == 's' && line[1] == ' ' && prot_pair(line + 2, &dev, &ino)) {
+			if (prot_off > prot_told) {
+				prot_remember(dev, ino, NULL, 0);
+				prot_told = prot_off;
+			}
+		} else if (line[0] == 'a' && line[1] == ' ' && prot_pair(line + 2, &dev, &ino)) {
+			if (prot_off > prot_told) {
+				prot_anchor(dev, ino);
+				prot_told = prot_off;
+			}
+		} else if (line[0] == 'p' && line[1] == ' ' && line[2] == '/') {
+			if (prot_np < PROT_PATHS && (prot_paths[prot_np] = strdup(line + 2)))
+				prot_np++;
+			else
+				prot_broken = TRUE;	/* more places than fit, or no memory */
+		} else
+			prot_broken = TRUE;	/* not a line of the list: a number may be lost */
+	}
+	if (ferror(f))
+		prot_broken = TRUE;
+}
+
+static void prot_refresh(void)
+{
+	char name[NFS_MAXPATHLEN];
+	prot_id cur[PROT_PATHS];
+	backend_statstruct st;
+	FILE *f;
+	int i, ncur, have;
+
+	if (snprintf(name, sizeof(name), "%s.protect", opt_exports) >= (int) sizeof(name))
+		name[0] = '\0';	/* no such file can be opened: the list is broken */
+
+	/* a list that could not be read is tried again, once a second */
+	if (prot_broken && time(NULL) != prot_at)
+		prot_stale = TRUE;
+	/* the list as it is now against the list as it was read */
+	if (prot_loaded && !prot_broken && !prot_stale) {
+		have = name[0] && stat(name, &st) == 0;
+		if (have != prot_have || (have && (st.st_ino != prot_ino || st.st_size < prot_off)))
+			prot_stale = TRUE;	/* it came, went or is another file: from the start */
+		else if (have && st.st_size > prot_off) {
+			/* it has grown: whoever puts an object at a p path adds
+			   its line first. Read what was added. */
+			if ((f = fopen(name, "r"))) {
+				if (fseeko(f, prot_off, SEEK_SET) == 0)
+					prot_read(f);
+				else
+					prot_broken = TRUE;
+				fclose(f);
+			} else
+				prot_broken = TRUE;
+			if (prot_broken) {
+				prot_at = time(NULL);
+				logmsg(LOG_CRIT, "could not read what was added to '%s', refusing every change", name);
+			}
+		}
+	}
+	if (prot_stale) {
+		prot_stale = FALSE;
+		for (i = 0; i < prot_np; i++)
+			free(prot_paths[i]);
+		prot_np = 0;
+		prot_fixed = 0;
+		prot_loaded = FALSE;
+		prot_broken = FALSE;
+		prot_at = 0;
+	}
+	if (!prot_loaded) {
+		prot_loaded = TRUE;
+		prot_have = FALSE;
+		prot_off = 0;
+		f = NULL;
+		if (!name[0])
+			prot_broken = TRUE;
+		else if (!(f = fopen(name, "r")) && errno != ENOENT)
+			prot_broken = TRUE;	/* a list that exists and does not open */
+		if (f) {
+			if (fstat(fileno(f), &st) == 0) {
+				prot_have = TRUE;
+				prot_ino = st.st_ino;
+				/* another file, or one that is shorter than what
+				   was taken from it: nothing of it was taken */
+				if (st.st_ino != prot_told_ino || st.st_size < prot_told) {
+					prot_told_ino = st.st_ino;
+					prot_told = 0;
+				}
+			} else
+				prot_broken = TRUE;
+			prot_read(f);
+			fclose(f);
+		}
+		if (prot_broken) {
+			prot_at = time(NULL);
+			if (!prot_said)
+				logmsg(LOG_CRIT, "could not read '%s', refusing every change", name);
+			prot_said = TRUE;
+		} else
+			prot_said = FALSE;
+	}
+	if (prot_broken || prot_np == 0)
+		return;
+	/* after the list, so that an object the list's lines pushed out and
+	   that is at a p path now is known again before a request is judged */
+	ncur = 0;
+	for (i = 0; i < prot_np; i++) {
+		if (backend_lstat(prot_paths[i], &st) == 0) {
+			cur[ncur].dev = st.st_dev;
+			cur[ncur].ino = st.st_ino;
+			ncur++;
+		}
+	}
+	for (i = 0; i < ncur; i++)
+		prot_remember(cur[i].dev, cur[i].ino, cur, ncur);
+}
+
+static int prot_match(uint64 dev, uint64 ino)
+{
+	return prot_among(prot_ids, prot_fixed, dev, ino) ||
+	       prot_among(prot_seen, prot_nseen, dev, ino);
+}
+
+/*
+ * path names an object by a directory and a last name. The directory is
+ * resolved through every symbolic link, and it and each directory above it
+ * are compared with the list; then the object the last name gives. With
+ * follow, a last name that is a symbolic link is followed too, for the
+ * calls that act on what a link points to: the same is done for the path
+ * the link holds, whether or not anything is there (a create through a
+ * link makes what it points to). What cannot be resolved is refused,
+ * except what is not there: a call fails on that by itself.
+ */
+static nfsstat3 prot_check(const char *path, int follow, int links)
+{
+	char dir[PATH_MAX];
+	char real[PATH_MAX];
+	char full[PATH_MAX];
+	backend_statstruct st;
+	const char *leaf;
+	char *slash;
+	size_t len, dlen;
+	ssize_t n;
+
+	len = strlen(path);
+	if (len == 0 || len >= sizeof(dir) || path[0] != '/')
+		return NFS3ERR_ROFS;
+	memcpy(dir, path, len + 1);
+	slash = strrchr(dir, '/');
+	leaf = path + (slash - dir) + 1;
+	if (slash == dir)
+		dir[1] = '\0';
+	else
+		*slash = '\0';
+
+	if (!realpath(dir, real)) {
+		/* a link that points into a directory that is not there: the
+		   call that follows it fails there too and changes nothing */
+		if (links > 0 && (errno == ENOENT || errno == ENOTDIR))
+			return NFS3_OK;
+		return NFS3ERR_ROFS;
+	}
+	if (snprintf(full, sizeof(full), "%s%s%s", real,
+		     real[1] ? "/" : "", leaf) >= (int) sizeof(full))
+		return NFS3ERR_ROFS;
+	dlen = strlen(real) + (real[1] ? 1 : 0);	/* the directory in full, with its slash */
+
+	/* the resolved directory and every directory above it */
+	for (;;) {
+		if (backend_lstat(real, &st) != 0)
+			return NFS3ERR_ROFS;
+		if (prot_match(st.st_dev, st.st_ino))
+			return NFS3ERR_ROFS;
+		slash = strrchr(real, '/');
+		if (!slash || !real[1])
+			break;
+		if (slash == real)
+			real[1] = '\0';
+		else
+			*slash = '\0';
+	}
+
+	if (!*leaf)
 		return NFS3_OK;
+	if (backend_lstat(full, &st) != 0) {
+		/* no object by that name yet; an object that cannot be
+		   looked at may be a protected one */
+		if (errno == ENOENT || errno == ENOTDIR)
+			return NFS3_OK;
+		return NFS3ERR_ROFS;
+	}
+	if (prot_match(st.st_dev, st.st_ino))
+		return NFS3ERR_ROFS;
+	if (follow && S_ISLNK(st.st_mode)) {
+		if (links >= PROT_LINKS)
+			return NFS3ERR_ROFS;
+		n = readlink(full, dir, sizeof(dir) - 1);
+		if (n <= 0)
+			return NFS3ERR_ROFS;
+		/* "x/" names what x names: without the slashes the last name
+		   is judged, and followed when it is a link itself */
+		while (n > 1 && dir[n - 1] == '/')
+			n--;
+		dir[n] = '\0';
+		if (dir[0] == '/')
+			memcpy(real, dir, n + 1);
+		else if (snprintf(real, sizeof(real), "%.*s%s", (int) dlen,
+				  full, dir) >= (int) sizeof(real))
+			return NFS3ERR_ROFS;
+		return prot_check(real, TRUE, links + 1);
+	}
+	return NFS3_OK;
+}
+
+/*
+ * NFS3ERR_ROFS when path names a protected object or lies under one; a
+ * symbolic link as the last name is taken as the link itself
+ */
+nfsstat3 exports_prot(const char *path)
+{
+	prot_refresh();
+	if (prot_broken)
+		return NFS3ERR_ROFS;
+	if ((prot_fixed == 0 && prot_nseen == 0) || !path)
+		return NFS3_OK;
+	return prot_check(path, FALSE, 0);
+}
+
+/*
+ * NFS3ERR_ROFS when the object that path names is an anchor. Only that
+ * object counts, not the directories above it: the check is for a call that
+ * takes the object's name away (a rename of it, a rename onto it, a
+ * removal), and a file in an anchor may be renamed and removed as before.
+ * The directory part of path is resolved through every symbolic link; a
+ * last name that is a symbolic link is the link, which is no anchor.
+ */
+nfsstat3 exports_anchor(const char *path)
+{
+	char dir[PATH_MAX];
+	char real[PATH_MAX];
+	char full[PATH_MAX];
+	backend_statstruct st;
+	const char *leaf;
+	char *slash;
+	size_t len;
+	int j;
+
+	prot_refresh();
+	if (prot_broken)
+		return NFS3ERR_ROFS;
+	if (prot_nanch == 0 || !path)
+		return NFS3_OK;
+	len = strlen(path);
+	if (len == 0 || len >= sizeof(dir) || path[0] != '/')
+		return NFS3ERR_ROFS;
+	memcpy(dir, path, len + 1);
+	slash = strrchr(dir, '/');
+	leaf = path + (slash - dir) + 1;
+	if (slash == dir)
+		dir[1] = '\0';
 	else
+		*slash = '\0';
+	if (!*leaf)
+		return NFS3_OK;
+	if (!realpath(dir, real))
 		return NFS3ERR_ROFS;
+	if (snprintf(full, sizeof(full), "%s%s%s", real,
+		     real[1] ? "/" : "", leaf) >= (int) sizeof(full))
+		return NFS3ERR_ROFS;
+	if (backend_lstat(full, &st) != 0) {
+		if (errno == ENOENT || errno == ENOTDIR)
+			return NFS3_OK;	/* no object by that name */
+		return NFS3ERR_ROFS;
+	}
+	if (!S_ISDIR(st.st_mode))
+		return NFS3_OK;
+	for (j = 0; j < prot_nanch; j++)
+		if (prot_anch[j].ino == st.st_ino && prot_anch[j].dev == st.st_dev)
+			return NFS3ERR_ROFS;
+	return NFS3_OK;
 }
 
