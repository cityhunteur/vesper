+/* Vesper (TD-097): statx and AT_STATX_FORCE_SYNC for vesper_lstat below. */
+#ifndef _GNU_SOURCE
+#define _GNU_SOURCE 1
+#endif
 #include "config.h"
 
 #include <sys/types.h>
@@ -620,4 +624,25 @@
 
     buf->st_mtime = entry->time;
     buf->st_ctime = entry->time;
+}
+
+/*
+ * Vesper (TD-097): virtio-fs on macOS reports the uid that asks as the owner of the sharing user's files, and the
+ * System VM keeps those attributes for about a second, whichever uid asks next. This server stats each object as
+ * root before it switches to the caller, so a non-root caller saw every file owned by 0:0, and the kernel's own
+ * owner check refused its chmod. A result whose owner is not the effective uid can be another uid's view: it is
+ * fetched again past the cache, which also makes the System VM's inode carry this caller's view for the request.
+ */
+int vesper_lstat(const char *path, struct stat *buf)
+{
+    struct statx sx;
+
+    if (lstat(path, buf) == -1)
+	return -1;
+    if (buf->st_uid == geteuid())
+	return 0;
+    if (statx(AT_FDCWD, path, AT_SYMLINK_NOFOLLOW | AT_STATX_FORCE_SYNC,
+	      STATX_UID | STATX_GID, &sx) == -1)
+	return 0;
+    return lstat(path, buf);
 }
